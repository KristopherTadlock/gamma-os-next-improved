+// The button for a hotkey: persist.gammaos.hotkeys.<action> holds an Android keycode name
+// (BUTTON_R1), as PhoneWindowManager reads it.
+int hotkeyButton(const char* action, int def) {
+    static const struct { const char* name; int evdev; } kButtons[] = {
+        {"BUTTON_A", BTN_SOUTH}, {"BUTTON_B", BTN_EAST}, {"BUTTON_X", BTN_NORTH}, {"BUTTON_Y", BTN_WEST},
+        {"BUTTON_L1", BTN_TL}, {"BUTTON_R1", BTN_TR}, {"BUTTON_L2", BTN_TL2}, {"BUTTON_R2", BTN_TR2},
+        {"BUTTON_THUMBL", BTN_THUMBL}, {"BUTTON_THUMBR", BTN_THUMBR},
+        {"BUTTON_START", BTN_START}, {"BUTTON_SELECT", BTN_SELECT},
+        {"DPAD_UP", KEY_UP}, {"DPAD_DOWN", KEY_DOWN}, {"DPAD_LEFT", KEY_LEFT}, {"DPAD_RIGHT", KEY_RIGHT},
+        {"NONE", -1},
+    };
+    char prop[64], v[PROPERTY_VALUE_MAX] = {};
+    snprintf(prop, sizeof(prop), "persist.gammaos.hotkeys.%s", action);
+    property_get(prop, v, "");
+    const char* name = strncmp(v, "KEYCODE_", 8) == 0 ? v + 8 : v;
+    for (const auto& b : kButtons) if (!strcmp(name, b.name)) return b.evdev;
+    return def;
+}
+
+// Anbernic + a button: drastic-nano's own quick save / load (slot 0), fast forward and exit.
+// It has no rewind.
+// Pads whose D-pad is buttons rather than a hat: the D-pad hotkeys name KEY_UP..KEY_RIGHT.
+int hotkeyCode(int code) {
+    switch (code) {
+        case BTN_DPAD_UP: return KEY_UP;
+        case BTN_DPAD_DOWN: return KEY_DOWN;
+        case BTN_DPAD_LEFT: return KEY_LEFT;
+        case BTN_DPAD_RIGHT: return KEY_RIGHT;
+        default: return code;
+    }
+}
+
+bool isHotkeyButton(int code) {
+    code = hotkeyCode(code);
+    return code == hotkeyButton("save", BTN_TR) || code == hotkeyButton("load", BTN_TL)
+            || code == hotkeyButton("fastforward", BTN_TR2) || code == hotkeyButton("quit", -1);
+}
+
+// Any key other than the hold's own ends a hold-to-exit.
+void endHold(InputState* st) {
+    st->holdQuitStartMs = 0;
+}
+
+void hotkey(InputState* st, int code, InputActions* out) {
+    code = hotkeyCode(code);
+    if (code == hotkeyButton("save", BTN_TR)) out->actQuickSave = true;
+    else if (code == hotkeyButton("load", BTN_TL)) out->actQuickLoad = true;
+    else if (code == hotkeyButton("fastforward", BTN_TR2)) st->ffToggled = !st->ffToggled;
+    else if (code == hotkeyButton("quit", -1)) {
+        if (property_get_bool("persist.gammaos.hotkeys.quithold", true))
+            st->quitHoldStartMs = android::elapsedRealtime();
+        else
+            out->exitRequested = true;
+    } else {
+        return;
+    }
+    ALOGI("DrasticNano::input: hotkey for button %d", code);
+}
+
+// A hat (ABS_HAT0X/Y) direction is a D-pad button for the hotkeys: pressed while the Anbernic
+// button (or Start + Select) is held it does the hotkey bound to that D-pad direction, and the
+// press never reaches the game. Returns true when the event is taken.
+bool hatChord(InputState* st, int value, int negCode, int posCode, int* chord, int* prev,
+              bool overlayOpen, bool captureKey, InputActions* out) {
+    const int code = value < 0 ? negCode : value > 0 ? posCode : 0;
+    if (code && value != *prev) endHold(st);
+    if (*chord) {
+        if (code == *chord) return true;                       // still held
+        if (*chord == hotkeyButton("quit", -1)) st->quitHoldStartMs = 0;
+        *chord = 0;
+        if (!code) { *prev = 0; return true; }                 // its release
+    }
+    if (code && value != *prev
+        && (st->anbernicHeld || (st->ssArmed && st->ssStart && st->ssSelect && isHotkeyButton(code)))
+        && !overlayOpen && !captureKey
+        && property_get_bool("persist.gammaos.hotkeys.enable", true)) {
+        st->anbernicChorded = true;
+        *chord = code;
+        *prev = value;
+        hotkey(st, code, out);
+        return true;
+    }
+    return false;
+}
