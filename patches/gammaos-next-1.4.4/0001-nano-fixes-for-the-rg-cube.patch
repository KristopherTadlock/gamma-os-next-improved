+bool NanoMenu::esdeRomSubPath(const std::string& romPath, int sysIdx, int* outSys, std::string* outDir,
+                              std::string* outRel) {
+    size_t bestLen = 0; int bestSys = -1; std::string bestRoot;
+    const int lo = sysIdx >= 0 ? sysIdx : 0;
+    const int hi = sysIdx >= 0 ? std::min(sysIdx + 1, (int)mXmbSystems.size()) : (int)mXmbSystems.size();
