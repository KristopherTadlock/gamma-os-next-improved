+// PPSSPP's memory stick (the folder holding PSP/): memstick_dir.txt in its app folder, else the
+// root of internal storage. "" when it is a folder picked through Android (a content:// address).
+static std::string ppssppMemstick() {
+    std::string text;
+    if (sdReadFile(kPpssppMemstickFile, &text)) {
+        while (!text.empty() && (text.back() == '\n' || text.back() == '\r' || text.back() == ' ')) text.pop_back();
+        while (text.size() > 1 && text.back() == '/') text.pop_back();
+        if (!text.empty()) return text[0] == '/' ? text : std::string();
+    }
+    // Not set: PPSSPP's default, its app folder in newer versions, the storage root in older ones;
+    // of two, the one it used last (its settings file written most recently).
+    const std::string app = "/storage/emulated/0/Android/data/org.ppsspp.ppsspp/files";
+    auto used = [](const char* raw) {
+        struct stat st;
+        if (stat((std::string(raw) + "/PSP/SYSTEM/ppsspp.ini").c_str(), &st) == 0) return (long long)st.st_mtime;
+        return access((std::string(raw) + "/PSP").c_str(), F_OK) == 0 ? 0LL : -1LL;
+    };
+    const long long a = used("/data/media/0/Android/data/org.ppsspp.ppsspp/files"), r = used("/data/media/0");
+    return r > a ? std::string("/storage/emulated/0") : app;
+}
+
+// Flycast's home folder: home_directory in its settings.
+static std::string flycastHome(std::string* prefs) {
+    if (!sdReadPrefs(kFlycastPrefs, prefs)) return kFlycastDefHome;
+    const std::string key = "<string name=\"home_directory\">";
+    const size_t a = prefs->find(key);
+    if (a == std::string::npos) return kFlycastDefHome;
+    const size_t b = prefs->find("</string>", a);
+    std::string v = prefs->substr(a + key.size(), b == std::string::npos ? std::string::npos : b - a - key.size());
+    while (v.size() > 1 && v.back() == '/') v.pop_back();
+    return v.empty() || v[0] != '/' ? std::string() : v;
+}
+
+// A <string> of an app's SharedPreferences file ("" = not set).
+static std::string sdPrefsGet(const std::string& prefs, const std::string& name) {
+    const std::string key = "<string name=\"" + name + "\">";
+    const size_t a = prefs.find(key);
+    if (a == std::string::npos) return std::string();
+    const size_t b = prefs.find("</string>", a);
+    if (b == std::string::npos) return std::string();
+    std::string v = prefs.substr(a + key.size(), b - a - key.size());
+    for (const auto& e : {std::make_pair("&lt;", "<"), std::make_pair("&gt;", ">"), std::make_pair("&quot;", "\""),
+                          std::make_pair("&apos;", "'"), std::make_pair("&amp;", "&")})   // &amp; last
+        for (size_t p = v.find(e.first); p != std::string::npos; p = v.find(e.first, p + 1)) v.replace(p, strlen(e.first), e.second);
+    return v;
+}
+
+// Sets a <string> in SharedPreferences text (a file never written, or an empty <map />, made one).
+static bool sdPrefsSet(std::string* prefs, const std::string& name, const std::string& value) {
+    if (prefs->find("<map") == std::string::npos)
+        *prefs = "<?xml version='1.0' encoding='utf-8' standalone='yes' ?>\n<map>\n</map>\n";
+    const size_t empty = prefs->find("<map />");
+    if (empty != std::string::npos) prefs->replace(empty, 7, "<map>\n</map>");
+    std::string esc;
+    for (char c : value) esc += c == '&' ? "&amp;" : c == '<' ? "&lt;" : c == '>' ? "&gt;" : std::string(1, c);
+    const std::string key = "<string name=\"" + name + "\">";
+    const size_t a = prefs->find(key);
+    if (a != std::string::npos) {
+        const size_t b = prefs->find("</string>", a);
+        if (b == std::string::npos) return false;
+        prefs->replace(a + key.size(), b - a - key.size(), esc);
+        return true;
+    }
+    const size_t end = prefs->rfind("</map>");
+    if (end == std::string::npos) return false;
+    prefs->insert(end, "    " + key + esc + "</string>\n");
+    return true;
+}
+
+// DraStic's system folder: _SystemPath, "/fp<length of the parent><parent>/<name>" for a folder
+// ("/ss..." is one picked through Android, a content:// address: "" then). Its app folder when unset.
+static std::string drasticSystemDir() {
+    std::string prefs;
+    if (!sdReadPrefs(kDrasticFsPrefs, &prefs)) return kDrasticDefDir;
+    const std::string v = sdPrefsGet(prefs, "_SystemPath");
+    if (v.empty()) return kDrasticDefDir;
+    if (v.compare(0, 3, "/fp") != 0) return std::string();
+    size_t i = 3, n = 0;
+    while (i < v.size() && isdigit((unsigned char)v[i])) n = n * 10 + (v[i++] - '0');
+    if (i == 3 || i + n > v.size()) return std::string();
+    std::string dir = v.substr(i, n) + v.substr(i + n);
+    while (dir.size() > 1 && dir.back() == '/') dir.pop_back();
+    return !dir.empty() && dir[0] == '/' ? dir : std::string();
+}
+
+static std::string drasticSystemPathValue(const std::string& dir) {
+    const size_t sl = dir.find_last_of('/');
+    const std::string parent = dir.substr(0, sl);
+    return "/fp" + std::to_string(parent.size()) + parent + dir.substr(sl);
+}
+
+static std::string sdUriDecode(const std::string& s) {
+    std::string out;
+    for (size_t i = 0; i < s.size(); i++) {
+        if (s[i] == '%' && i + 2 < s.size() && isxdigit((unsigned char)s[i + 1]) && isxdigit((unsigned char)s[i + 2])) {
+            out += (char)strtol(s.substr(i + 1, 2).c_str(), nullptr, 16);
+            i += 2;
+        } else {
+            out += s[i];
+        }
+    }
+    return out;
+}
+
+// M64Plus FZ keeps game data in its app folder and, set to external storage, copies each game's
+// data from and back to <folder>/GameData around play. The folder: gameDataStoragePath, a file://
+// address ("" = a content:// one picked through Android, or internal storage when *internal).
+static std::string mupenDataDir(bool* internal) {
+    std::string prefs;
+    sdReadPrefs(kMupenPrefs, &prefs);
+    const std::string type = sdPrefsGet(prefs, "gameDataStorageType");
+    std::string path = sdPrefsGet(prefs, "gameDataStoragePath");
+    *internal = type == "internal";
+    if (*internal) return std::string();
+    if (path.empty()) return "/storage/emulated/0/M64Plus";   // its default (made at its next start)
+    if (path.compare(0, 7, "file://") != 0) return std::string();
+    std::string dir = sdUriDecode(path.substr(7));
+    while (dir.size() > 1 && dir.back() == '/') dir.pop_back();
+    return !dir.empty() && dir[0] == '/' ? dir : std::string();
+}
+
+static std::string sdFileUri(const std::string& path) {   // as Android's Uri.fromFile writes it
+    static const char kHex[] = "0123456789ABCDEF";
+    std::string u = "file://";
+    for (unsigned char c : path) {
+        if (isalnum(c) || strchr("/-_.~", c)) u += (char)c;
+        else { u += '%'; u += kHex[c >> 4]; u += kHex[c & 15]; }
+    }
+    return u;
+}
+
+// Removes a <string> from SharedPreferences text.
+static void sdPrefsRemove(std::string* prefs, const std::string& name) {
+    const size_t a = prefs->find("<string name=\"" + name + "\">");
+    if (a == std::string::npos) return;
+    const size_t b = prefs->find("</string>", a);
+    if (b == std::string::npos) return;
+    size_t from = a, to = b + 9;
+    while (from > 0 && ((*prefs)[from - 1] == ' ' || (*prefs)[from - 1] == '\t')) from--;
+    if (to < prefs->size() && (*prefs)[to] == '\n') to++;
+    prefs->erase(from, to - from);
+}
+
+static std::string sdTrimDir(std::string d) {   // no quotes, spaces or trailing slash; /sdcard as /storage/emulated/0
+    while (!d.empty() && (d.back() == ' ' || d.back() == '\r' || d.back() == '\t')) d.pop_back();
+    while (!d.empty() && (d[0] == ' ' || d[0] == '\t')) d.erase(0, 1);
+    if (d.size() >= 2 && (d[0] == '"' || d[0] == '\'') && d.back() == d[0]) d = d.substr(1, d.size() - 2);
+    while (d.size() > 1 && d.back() == '/') d.pop_back();
+    if (d == "/sdcard" || d.compare(0, 8, "/sdcard/") == 0) d = "/storage/emulated/0" + d.substr(7);
+    if (d.compare(0, 13, "/data/user/0/") == 0) d = "/data/data/" + d.substr(13);
+    return d;
+}
+
+// A setting's folder is there (not on a card or drive that is out, say): only then is it moved.
+static bool sdExists(const std::string& dir) {
+    struct stat st;
+    return stat(sdCanon(dir).c_str(), &st) == 0 && S_ISDIR(st.st_mode);
+}
+
+// Vita3K's emulated memory card and system (firmware, installed games, saves): pref-path in its
+// config.yml ("" = not set).
+static std::string vita3kPrefPath(const std::string& cfg) {
+    size_t pos = 0;
+    while (pos < cfg.size()) {
+        size_t end = cfg.find('\n', pos);
+        if (end == std::string::npos) end = cfg.size();
+        const std::string line = cfg.substr(pos, end - pos);
+        if (line.compare(0, 10, "pref-path:") == 0) return sdTrimDir(line.substr(10));
+        pos = end + 1;
+    }
+    return std::string();
+}
+
+static std::string vita3kSetPrefPath(const std::string& cfg, const std::string& dir) {
+    const std::string line = "pref-path: " + dir + "/";
+    std::string out;
+    bool done = false;
+    size_t pos = 0;
+    while (pos < cfg.size()) {
+        size_t end = cfg.find('\n', pos);
+        const bool last = end == std::string::npos;
+        if (last) end = cfg.size();
+        std::string l = cfg.substr(pos, end - pos);
+        if (l.compare(0, 10, "pref-path:") == 0) { l = line; done = true; }
+        else if (!done && (l == "..." || l == "...\r")) { out += line + "\n"; done = true; }   // before the end of the document
+        out += l;
+        if (!last) out += "\n";
+        pos = end + 1;
+    }
+    if (!done) out += std::string(out.empty() || out.back() == '\n' ? "" : "\n") + line + "\n";
+    return out;
+}
+
+static bool sdIniKey(const std::string& line, const char* key, std::string* value) {
+    const size_t eq = line.find('=');
+    if (eq == std::string::npos) return false;
+    std::string k = line.substr(0, eq);
+    while (!k.empty() && (k.back() == ' ' || k.back() == '\t')) k.pop_back();
+    while (!k.empty() && (k[0] == ' ' || k[0] == '\t')) k.erase(0, 1);
+    if (strcasecmp(k.c_str(), key) != 0) return false;
+    *value = sdTrimDir(line.substr(eq + 1));
+    return true;
+}
+
+// ScummVM's save folder: savepath in [scummvm] of its scummvm.ini, else its app folder's saves.
+// "" when it is a folder picked through Android (/saf/...).
+static std::string scummvmSavePath(const std::string& ini) {
+    std::string section, value;
+    size_t pos = 0;
+    while (pos < ini.size()) {
+        size_t end = ini.find('\n', pos);
+        if (end == std::string::npos) end = ini.size();
+        const std::string line = ini.substr(pos, end - pos);
+        pos = end + 1;
+        if (!line.empty() && line[0] == '[') { section = line.substr(1, line.find(']') - 1); continue; }
+        if (strcasecmp(section.c_str(), "scummvm") == 0 && sdIniKey(line, "savepath", &value) && !value.empty())
+            return value.compare(0, 5, "/saf/") == 0 || value[0] != '/' ? std::string() : value;
+    }
+    return kScummvmDefSaves;
+}
+
+// savepath in [scummvm] set to dir, and a game's own savepath in the old folder moved with it.
+static std::string scummvmSetSavePath(const std::string& ini, const std::string& from, const std::string& dir) {
+    std::string out, section, value;
+    bool inMain = false, done = false, haveMain = false;
+    size_t pos = 0;
+    while (pos < ini.size()) {
+        size_t end = ini.find('\n', pos);
+        const bool last = end == std::string::npos;
+        if (last) end = ini.size();
+        std::string line = ini.substr(pos, end - pos);
+        pos = end + 1;
+        if (!line.empty() && line[0] == '[') {
+            if (inMain && !done) { out += "savepath=" + dir + "\n"; done = true; }
+            section = line.substr(1, line.find(']') - 1);
+            inMain = strcasecmp(section.c_str(), "scummvm") == 0;
+            haveMain = haveMain || inMain;
+        } else if (sdIniKey(line, "savepath", &value)) {
+            if (inMain) { line = "savepath=" + dir; done = true; }
+            else if (sdUnder(value, from)) line = "savepath=" + dir + value.substr(from.size());
+        }
+        out += line;
+        if (!last) out += "\n";
+    }
+    if (inMain && !done) out += std::string(out.empty() || out.back() == '\n' ? "" : "\n") + "savepath=" + dir + "\n";
+    if (!haveMain) out = "[scummvm]\nsavepath=" + dir + "\n" + out;
+    return out;
+}
+
+// Azahar's folder: CITRA_DIRECTORY, a folder picked through Android (a tree of the external storage
+// provider: primary:<path> on internal storage, <volume>:<path> on a card). "" when unset or another.
+static std::string azaharDir(const std::string& prefs, std::string* uri) {
+    *uri = sdPrefsGet(prefs, "CITRA_DIRECTORY");
+    const size_t n = strlen(kExternalStorageTree);
+    if (uri->compare(0, n, kExternalStorageTree) != 0) return std::string();
+    std::string id = uri->substr(n);
+    const size_t sl = id.find('/');   // .../tree/<id>/document/<id>
+    id = sdUriDecode(sl == std::string::npos ? id : id.substr(0, sl));
+    const size_t colon = id.find(':');
+    if (colon == std::string::npos || colon == 0) return std::string();
+    const std::string vol = id.substr(0, colon), rel = id.substr(colon + 1);
+    const std::string root = vol == "primary" ? std::string("/storage/emulated/0") : "/storage/" + vol;
+    return sdTrimDir(rel.empty() ? root : root + "/" + rel);
+}
+
+static std::string azaharTreeUri(const std::string& volume, const std::string& rel) {   // as Android writes it
+    static const char kHex[] = "0123456789ABCDEF";
+    std::string u = kExternalStorageTree;
+    for (unsigned char c : volume + ":" + rel) {
+        if (isalnum(c) || strchr("_-!.~'()*", c)) u += (char)c;
+        else { u += '%'; u += kHex[c >> 4]; u += kHex[c & 15]; }
+    }
+    return u;
+}
+
+// Gives pkg a folder on a volume as if it had been picked through Android (NanoNetBridge).
+static bool sdUriGrant(const char* pkg, const std::string& volume, const std::string& rel) {
+    static const char kProp[] = "sys.gammaos.nano.uri_grant";
+    const std::string arg = std::string(pkg) + "|" + volume + "|" + rel;
+    if (arg.size() + 24 >= PROPERTY_VALUE_MAX) {   // "<13-digit sequence>|uri_grant|" ahead of it
+        ALOGW("sdmove: folder grant for %s too long to send (volume %s)", pkg, volume.c_str());
+        return false;
+    }
+    property_set(kProp, "");
+    for (int attempt = 0; attempt < 2; attempt++) {   // a Wi-Fi command sent meanwhile replaces it unread
+        if (!nanoNetBridgeCmd("uri_grant", arg)) return false;
+        for (int i = 0; i < 50; i++) {
+            usleep(100000);
+            char v[PROPERTY_VALUE_MAX] = {};
+            property_get(kProp, v, "");
+            if (v[0]) return std::string(v) == std::string("ok|") + pkg;
+        }
+    }
+    ALOGW("sdmove: no answer to the folder grant for %s", pkg);
+    return false;
+}
