+// One spelling per file whatever mount it is reached through: the raw mount, links resolved (of
+// the part that exists).
+static std::string nanoCanonPath(const std::string& p) {
+    auto toRaw = [](const std::string& q) {
+        const std::string emu = "/storage/emulated/0";
+        if (q == emu || q.compare(0, emu.size() + 1, emu + "/") == 0) return "/data/media/0" + q.substr(emu.size());
+        if (q.compare(0, 9, "/storage/") == 0 && q.compare(0, 14, "/storage/self/") != 0) return "/mnt/media_rw/" + q.substr(9);
+        return q;
+    };
+    const std::string raw = toRaw(p);
+    std::string head = raw, tail;
+    char buf[PATH_MAX];
+    while (head.size() > 1) {
+        if (realpath(head.c_str(), buf)) return toRaw(std::string(buf) + tail);
+        const size_t sl = head.find_last_of('/');
+        if (sl == std::string::npos) break;
+        tail = head.substr(sl) + tail;
+        head = sl == 0 ? std::string("/") : head.substr(0, sl);
+    }
+    return raw;
+}
+
+static bool nanoUnder(const std::string& a, const std::string& b) {   // a is b or inside it
+    return a == b || (a.size() > b.size() && a.compare(0, b.size(), b) == 0 && a[b.size()] == '/');
+}
+
+static bool nanoCopyFile(const std::string& src, const std::string& dst) {
+    int in = open(src.c_str(), O_RDONLY | O_CLOEXEC);
+    if (in < 0) return false;
+    const std::string tmp = dst + ".nanocopy";
+    int out = open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0664);
+    if (out < 0) { close(in); return false; }
+    static thread_local char buf[256 * 1024];
+    bool ok = true;
+    for (;;) {
+        ssize_t rd = read(in, buf, sizeof(buf));
+        if (rd < 0) { ok = false; break; }
+        if (rd == 0) break;
+        for (ssize_t off = 0; off < rd;) {
+            ssize_t wr = write(out, buf + off, (size_t)(rd - off));
+            if (wr <= 0) { ok = false; break; }
+            off += wr;
+        }
+        if (!ok) break;
+    }
+    if (close(out) != 0) ok = false;
+    close(in);
+    if (!ok || rename(tmp.c_str(), dst.c_str()) != 0) { unlink(tmp.c_str()); return false; }
+    return true;
+}
+
+// The same bytes (a move tried before copied it already).
+static bool nanoSameFile(const std::string& a, const std::string& b) {
+    struct stat sa, sb;
+    if (stat(a.c_str(), &sa) != 0 || stat(b.c_str(), &sb) != 0 || sa.st_size != sb.st_size) return false;
+    const int fa = open(a.c_str(), O_RDONLY | O_CLOEXEC), fb = open(b.c_str(), O_RDONLY | O_CLOEXEC);
+    bool same = fa >= 0 && fb >= 0;
+    static thread_local char ba[64 * 1024], bb[64 * 1024];
+    while (same) {
+        const ssize_t ra = read(fa, ba, sizeof(ba)), rb = read(fb, bb, sizeof(bb));
+        if (ra != rb || ra < 0) { same = false; break; }
+        if (ra == 0) break;
+        same = memcmp(ba, bb, (size_t)ra) == 0;
+    }
+    if (fa >= 0) close(fa);
+    if (fb >= 0) close(fb);
+    return same;
+}
+
+// A move's original folder set aside as <folder>.nanomove (where the job then empties it) and a link
+// to its copy in its place, owned like its parent; *path becomes the folder set aside.
+static bool nanoLinkFolder(std::string* path, const std::string& linkTo) {
+    const std::string src = *path;
+    std::string aside = src + ".nanomove";
+    struct stat st, pst;
+    for (int n = 2; lstat(aside.c_str(), &st) == 0; n++) aside = src + ".nanomove." + std::to_string(n);   // an earlier one's
+    const bool had = lstat(src.c_str(), &st) == 0;
+    if ((had && !S_ISDIR(st.st_mode)) || stat(src.substr(0, src.find_last_of('/')).c_str(), &pst) != 0) {
+        ALOGW("ps3menu: move: %s is not a folder to link", src.c_str());
+        return false;
+    }
+    nanoMkdirs(linkTo);
+    if (stat(linkTo.c_str(), &st) != 0 || !S_ISDIR(st.st_mode)) {   // the card went
+        ALOGW("ps3menu: move: %s is not there to link to", linkTo.c_str());
+        return false;
+    }
+    if (had && rename(src.c_str(), aside.c_str()) != 0) {
+        ALOGW("ps3menu: move: %s could not be set aside: %s", src.c_str(), strerror(errno));
+        return false;
+    }
+    if (symlink(linkTo.c_str(), src.c_str()) != 0) {
+        ALOGW("ps3menu: move: link %s -> %s failed: %s", src.c_str(), linkTo.c_str(), strerror(errno));
+        if (had) rename(aside.c_str(), src.c_str());
+        return false;
+    }
+    if (lchown(src.c_str(), pst.st_uid, pst.st_gid) != 0) ALOGW("ps3menu: move: chown %s failed", src.c_str());
+    system(("restorecon '" + src + "' >/dev/null 2>&1").c_str());
+    if (had) *path = aside;
+    return true;
+}
