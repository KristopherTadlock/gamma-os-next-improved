+        gpAct(out, p.name.c_str(), QA_GP_HOTKEY_INFO, 74, nullptr);
+        Ps3Item& it = out.items.back();
+        it.desc = "Works: " + yes + "." + (no.empty() ? "" : " Not available: " + no + ".");
+        const std::string note = p.json.getString("note");
+        if (!note.empty()) it.desc += " " + note;
