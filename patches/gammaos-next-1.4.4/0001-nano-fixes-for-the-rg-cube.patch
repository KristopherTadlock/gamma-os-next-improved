+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+
+#pragma once
+
+#include <android-base/properties.h>
+
+#include <cmath>
+#include <iosfwd>
+#include <optional>
+#include <ostream>
+#include <string>
+
+namespace android::renderengine {
+
+// GammaOS global shaders come in two kinds. Composition shaders post-process the whole
+// composed frame. Surface shaders filter only the launched emulator's game layer while it
+// is drawn, so they need neither the offscreen frame nor full client composition.
+enum class GammaShaderMode { Off, Composition, Surface };
+
+inline constexpr const char* kGammaShader4x3Cropped = "4x3-cropped";
+inline constexpr const char* kGammaShader8x7Cropped = "8x7-cropped";
+
+// The cropped surface shaders, by the shape they stretch the game area to.
+enum class GammaCrop { k4x3, k8x7 };
+
+// The cropped surface shader that is on, if one is.
+inline std::optional<GammaCrop> gammaSurfaceCrop() {
+    if (!base::GetBoolProperty("persist.gammaos.shader.enable", false)) return std::nullopt;
+    const std::string type = base::GetProperty("persist.gammaos.shader.type", "crt-simple");
+    if (type == kGammaShader4x3Cropped) return GammaCrop::k4x3;
+    if (type == kGammaShader8x7Cropped) return GammaCrop::k8x7;
+    return std::nullopt;
+}
+
+inline GammaShaderMode gammaShaderMode() {
+    if (!base::GetBoolProperty("persist.gammaos.shader.enable", false)) {
+        return GammaShaderMode::Off;
+    }
+    return gammaSurfaceCrop() ? GammaShaderMode::Surface : GammaShaderMode::Composition;
+}
+
+inline bool gammaCompositionShaderOn() {
+    return gammaShaderMode() == GammaShaderMode::Composition;
+}
+
+// 4:3 Cropped and 8:7 Cropped mark the emulator's game layer (they have no settings). A 4:3 picture
+// is projected at one display pixel per projected pixel, centred, cropped to the display with
+// black around it: 4:3 Cropped to 800x600 on the 720x720 panel or 1600x1200 on a 1080p display;
+// 8:7 Cropped stretches it vertically, to 800x720 or 1200x1080. See gammaCropProjection and
+// GammaSurfaceScaler.
+struct GammaSurfaceFilter {
+    GammaCrop crop = GammaCrop::k4x3;
+};
+
+static inline bool operator==(const GammaSurfaceFilter& lhs, const GammaSurfaceFilter& rhs) {
+    return lhs.crop == rhs.crop;
+}
+
+static inline bool operator!=(const GammaSurfaceFilter& lhs, const GammaSurfaceFilter& rhs) {
+    return !(lhs == rhs);
+}
+
+static inline void PrintTo(const GammaSurfaceFilter& f, ::std::ostream* os) {
+    *os << "GammaSurfaceFilter { .crop = " << (f.crop == GammaCrop::k8x7 ? "8:7" : "4:3") << " }";
+}
+
+struct GammaProjection {
+    // The game area, in the picture's own pixels.
+    float gameX;
+    float gameY;
+    float gameW;
+    float gameH;
+    // The size the game area is stretched to, one display pixel per projected pixel.
+    float width;
+    float height;
+};
+
+// The projection for a picture of this size (in its own pixels) on a display of this size, or none
+// for an empty picture or display. Every picture is projected, whatever it shows: one within 5% of
+// 4:3 whole, and for 8:7 Cropped also one within 5% of 8:7 (a core's raw SNES frame); any other
+// picture's largest centred 4:3 rectangle, where an emulator such as Dolphin letterboxes its game.
+inline std::optional<GammaProjection> gammaCropProjection(GammaCrop crop, float pictureW,
+                                                          float pictureH, float displayW,
+                                                          float displayH) {
+    if (pictureW <= 0.f || pictureH <= 0.f || displayW <= 0.f || displayH <= 0.f) {
+        return std::nullopt;
+    }
+    const bool k8x7 = crop == GammaCrop::k8x7;
+    constexpr float aspect = 4.f / 3.f;
+    const float ratio = pictureW / pictureH;
+    const bool hd = displayH >= 1080.f;
+    GammaProjection p{0.f, 0.f, pictureW, pictureH, 0.f, 0.f};
+    if (k8x7) {
+        p.width = hd ? 1200.f : 800.f;
+        p.height = hd ? 1080.f : 720.f;
+    } else {
+        p.width = hd ? 1600.f : 800.f;
+        p.height = hd ? 1200.f : 600.f;
+    }
+    if (std::abs(ratio / aspect - 1.f) <= 0.05f) return p;
+    if (k8x7 && std::abs(ratio / (8.f / 7.f) - 1.f) <= 0.05f) return p;
+    if (pictureW > pictureH * aspect) {
+        p.gameW = pictureH * aspect;
+        p.gameX = (pictureW - p.gameW) / 2.f;
+    } else {
+        p.gameH = pictureW / aspect;
+        p.gameY = (pictureH - p.gameH) / 2.f;
+    }
+    return p;
+}
+
+} // namespace android::renderengine
