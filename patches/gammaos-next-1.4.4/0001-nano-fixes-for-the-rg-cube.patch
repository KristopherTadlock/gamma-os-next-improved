+QueueLock::QueueLock() {
+    mkdir(kQueueDir, 0700);
+    mFd = open(kQueueLock, O_RDWR | O_CREAT | O_CLOEXEC, 0600);
+    if (mFd >= 0) {
+        int r;
+        while ((r = flock(mFd, LOCK_EX)) != 0 && errno == EINTR) {}
+        mHeld = r == 0;
+    }
+    if (!mHeld) ALOGW("queue lock: %s", strerror(errno));
+}
