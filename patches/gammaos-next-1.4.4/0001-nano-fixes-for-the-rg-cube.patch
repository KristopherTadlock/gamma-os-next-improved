+    // are one folder. A move never copies a folder onto or into itself, which would delete the files.
+    std::vector<FileCopyPair> kept;
+    for (auto& pr : pairs) {
+        const std::string cs = nanoCanonPath(pr.src), cd = nanoCanonPath(pr.dst);
+        if (pr.move) {
+            if (cs == cd) { ALOGI("ps3menu: move: %s is already there", pr.src.c_str()); continue; }
+            if (nanoUnder(cd, cs) || nanoUnder(cs, cd)) {
+                photoShowBanner(trDyn("A folder to move is inside where it is going. Nothing was moved."));
