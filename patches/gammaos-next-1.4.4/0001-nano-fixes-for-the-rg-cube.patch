+// Where scraped extra media goes: <writeDir><subdir>/<names[0]>.<ext>, writeDir being the first media
+// folder and the system folder the lookup tries first. An existing copy counts under any of
+// haveDirs with any of names. False when the chosen media folder (an SD card) is not there.
+bool NanoMenu::esdeMediaStems(const std::string& romPath, int sysIdx, std::string* writeDir,
+                              std::vector<std::string>* names, std::vector<std::string>* haveDirs) {
+    std::vector<std::string> sysDirs;
+    std::string canon;
+    if (!esdeMediaLayout(romPath, sysIdx, &sysDirs, names, &canon)) return false;
+    const std::vector<std::string>& roots = esdeMediaRoots();
+    if (roots.size() > 1 || esdeStoreMode()) {   // a chosen folder (an SD card) must be there; checked once a second, not per game
+        static std::string sRoot;
+        static int64_t sCheckedMs = -10000;
+        static bool sOk = false;
+        const int64_t now = (int64_t)uptimeMillis();
+        if (roots[0] != sRoot || now - sCheckedMs > 1000) {
+            sRoot = roots[0]; sCheckedMs = now;
+            sOk = access(roots[0].c_str(), W_OK) == 0;
+        }
+        if (!sOk) return false;
+    }
+    // In ES-DE's folder the media goes where ES-DE looks: under the ES-DE name of the game's folder.
+    std::string folder;
+    if (esdeStoreMode()) {
+        std::string rel;
+        if (!esdeRomRef(romPath, nullptr, &rel, &folder)) folder.clear();
+    }
+    *writeDir = roots[0] + (!folder.empty() ? folder : sysDirs[0]) + "/";
+    haveDirs->clear();
+    for (const auto& root : roots)
+        for (const auto& sd : sysDirs) haveDirs->push_back(root + sd + "/");
+    return true;
+}
