+        Log.i(TAG, "show requested: flags=" + flags + " default=" + super.onShowInputRequested(flags, configChange));
+        return true;
+    }
+
+    @Override
+    public void onStartInput(EditorInfo info, boolean restarting) {
+        super.onStartInput(info, restarting);
+        Log.i(TAG, "start input: " + info.packageName + " type=0x" + Integer.toHexString(info.inputType)
+                + " restarting=" + restarting);
+    }
+
+    @Override
+    public View onCreateInputView() {
+        View v = new View(this);
+        v.setLayoutParams(new ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 1));
+        return v;
+    }
+
+    @Override
+    public void onStartInputView(EditorInfo info, boolean restarting) {
+        super.onStartInputView(info, restarting);
+        Log.i(TAG, "start input view: " + info.packageName + " restarting=" + restarting + " open=" + mReq);
+        if (!SystemProperties.getBoolean("sys.gammaos.minimal_boot", false)) {
+            switchAway();
+            return;
+        }
+        mInfo = info;
+        if (mReq != null) return;   // already with Nano
+        InputConnection ic = getCurrentInputConnection();
+        if (ic == null) { Log.w(TAG, "no input connection"); return; }
+        // An editor that only takes key events (a terminal) has no text to start from.
+        String text = info.inputType == InputType.TYPE_NULL ? "" : fieldText(ic);
+        File dir = getFilesDir();
+        new File(dir, "nano_osk_out.txt").delete();
+        if (!write(new File(dir, "nano_osk_in.txt"), text)) { Log.w(TAG, "can't write nano_osk_in.txt"); return; }
+        mReqAt = SystemClock.uptimeMillis();
+        mReq = "ime-" + mReqAt;   // Nano age-checks ids of this form
+        mMain.postDelayed(mPoll, POLL_MS);
+        SystemProperties.set(PROP + "osk_dir", dir.getAbsolutePath());
+        SystemProperties.set(PROP + "osk_type", isPassword(info) ? "password" : "text");
+        SystemProperties.set(PROP + "osk_hint", hint(info));
+        SystemProperties.set(PROP + "osk_req", mReq);
+        Log.i(TAG, "asked Nano: " + mReq + " (" + text.length() + " chars)");
+    }
+
+    @Override
+    public void onFinishInputView(boolean finishingInput) {
+        super.onFinishInputView(finishingInput);
+        if (mReq != null) {   // the field went away while Nano had it, or before Nano took it
+            Log.i(TAG, "field gone, withdrawing " + mReq);
+            if (mReq.equals(SystemProperties.get(PROP + "osk_req", ""))) SystemProperties.set(PROP + "osk_req", "");
+            SystemProperties.set(PROP + "osk_abort", mReq);
+            mReq = null;
+            mMain.removeCallbacks(mPoll);
+        }
+    }
+
+    private void poll() {
+        if (mReq == null) return;
+        String done = SystemProperties.get(PROP + "osk_done", "");
+        if (done.equals("ok:" + mReq)) {
+            Log.i(TAG, "Nano answered ok: " + mReq);
+            mReq = null;
+            String text = read(new File(getFilesDir(), "nano_osk_out.txt"));
+            // Next / Previous move to another field, which then asks Nano itself: stay shown.
+            boolean moved = false;
+            if (text != null) {
+                replaceField(text);
+                moved = editorAction();
+            }
+            if (!moved) requestHideSelf(0);
+        } else if (done.equals("cancel:" + mReq)) {
+            Log.i(TAG, "Nano answered cancel: " + mReq);
+            mReq = null;
+            requestHideSelf(0);
+        } else {
+            long waited = SystemClock.uptimeMillis() - mReqAt;
+            boolean untaken = mReq.equals(SystemProperties.get(PROP + "osk_req", ""));
+            if ((untaken && waited > TAKE_MS) || waited > ANSWER_MS) {
+                Log.w(TAG, (untaken ? "Nano never took " : "Nano never answered ") + mReq);
+                if (untaken) SystemProperties.set(PROP + "osk_req", "");
+                mReq = null;
+                requestHideSelf(0);
+                return;
+            }
+            mMain.postDelayed(mPoll, POLL_MS);
+        }
+    }
+
+    private static String fieldText(InputConnection ic) {
+        ExtractedText et = ic.getExtractedText(new ExtractedTextRequest(), 0);
+        if (et != null && et.text != null && et.partialStartOffset < 0) return et.text.toString();
+        CharSequence before = ic.getTextBeforeCursor(MAX_FIELD, 0);
+        CharSequence selected = ic.getSelectedText(0);
+        CharSequence after = ic.getTextAfterCursor(MAX_FIELD, 0);
+        return (before == null ? "" : before.toString()) + (selected == null ? "" : selected.toString())
+                + (after == null ? "" : after.toString());
+    }
+
+    /**
+     * Replaces the field's whole text with the edited one (the commit replaces any selection). The
+     * extent comes from the editor's full text where it gives it, so a long field is cleared whole;
+     * where it gives neither that nor the text around the caret, the text is inserted at the caret.
+     */
+    private void replaceField(String text) {
+        InputConnection ic = getCurrentInputConnection();
+        if (ic == null) return;
+        ic.beginBatchEdit();
+        ic.finishComposingText();
+        if (mInfo == null || mInfo.inputType != InputType.TYPE_NULL) {
+            int before = -1, after = -1;
+            ExtractedText et = ic.getExtractedText(new ExtractedTextRequest(), 0);
+            if (et != null && et.text != null && et.partialStartOffset < 0) {
+                int start = Math.min(et.selectionStart, et.selectionEnd);
+                int end = Math.max(et.selectionStart, et.selectionEnd);
+                if (start >= 0 && end <= et.text.length()) { before = start; after = et.text.length() - end; }
+            }
+            if (before < 0) {
+                CharSequence b = ic.getTextBeforeCursor(MAX_FIELD, 0);
+                CharSequence a = ic.getTextAfterCursor(MAX_FIELD, 0);
+                if (b != null && a != null) { before = b.length(); after = a.length(); }
+            }
+            if (before > 0 || after > 0) ic.deleteSurroundingText(before, after);
+        }
+        ic.commitText(text, 1);
+        ic.endBatchEdit();
+    }
+
+    /**
+     * Confirming is the keyboard's Go / Search / Next / Done, or Enter in a single-line field.
+     * True when it moves to another field (Next / Previous).
+     */
+    private boolean editorAction() {
+        EditorInfo info = mInfo;
+        InputConnection ic = getCurrentInputConnection();
+        if (info == null || ic == null) return false;
+        int action = info.imeOptions & EditorInfo.IME_MASK_ACTION;
+        if ((info.imeOptions & EditorInfo.IME_FLAG_NO_ENTER_ACTION) == 0
+                && action != EditorInfo.IME_ACTION_NONE && action != EditorInfo.IME_ACTION_UNSPECIFIED) {
+            ic.performEditorAction(action);
+            return action == EditorInfo.IME_ACTION_NEXT || action == EditorInfo.IME_ACTION_PREVIOUS;
+        }
+        if ((info.inputType & InputType.TYPE_TEXT_FLAG_MULTI_LINE) == 0) sendKeyChar('\n');
+        return false;
+    }
+
+    private static boolean isPassword(EditorInfo info) {
+        int cls = info.inputType & InputType.TYPE_MASK_CLASS;
+        int variation = info.inputType & InputType.TYPE_MASK_VARIATION;
+        if (cls == InputType.TYPE_CLASS_TEXT) {
+            return variation == InputType.TYPE_TEXT_VARIATION_PASSWORD
+                    || variation == InputType.TYPE_TEXT_VARIATION_WEB_PASSWORD;
+        }
+        return cls == InputType.TYPE_CLASS_NUMBER && variation == InputType.TYPE_NUMBER_VARIATION_PASSWORD;
+    }
+
+    /** The field's hint or label, short enough for a property. */
+    private static String hint(EditorInfo info) {
+        CharSequence h = info.hintText != null ? info.hintText : info.label;
+        if (h == null) return "";
+        String s = h.toString().replaceAll("\\s+", " ").trim();
+        while (s.getBytes(StandardCharsets.UTF_8).length > 90) {
+            s = s.substring(0, s.offsetByCodePoints(0, s.codePointCount(0, s.length()) - 1));
+        }
+        return s;
+    }
+
+    private void switchAway() {
+        InputMethodManager imm = getSystemService(InputMethodManager.class);
+        for (InputMethodInfo ime : imm.getEnabledInputMethodList()) {
+            if (!ime.getPackageName().equals(getPackageName())) {
+                Log.i(TAG, "not in Nano mode, switching to " + ime.getId());
+                switchInputMethod(ime.getId());
+                return;
+            }
+        }
+    }
+
+    private static boolean write(File f, String text) {
+        try (FileOutputStream out = new FileOutputStream(f)) {
+            out.write(text.getBytes(StandardCharsets.UTF_8));
+            return true;
+        } catch (IOException e) {
+            return false;
+        }
+    }
+
+    private static String read(File f) {
+        try {
+            return new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8);
+        } catch (IOException e) {
+            return null;
+        }
+    }
+}
