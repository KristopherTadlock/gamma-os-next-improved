+// Straight to the wizard's Wi-Fi scan (Quick Menu: Wi-Fi > Scan, or the network row), turning the
+// radio on first. Back from the network list closes the wizard.
+void NanoMenu::startWifiScanWizard() {
+    bool radioOn; { std::lock_guard<std::mutex> lk(mNetStateMutex); radioOn = mWifiRadioOn; }
+    if (!radioOn) toggleWifiRadio(true);
+    startNetWizard();
+    mPs3WizConn = "Wireless";
+    mPs3WizWlanMode = "Scan";
+    wizEnter(WS_SCANNING, 1);
+}
+
+void NanoMenu::ps3DlgBtAppendRows() {
+    mPs3DlgBtDevs.clear();
+    bool radioOff; { std::lock_guard<std::mutex> lk(mNetStateMutex); radioOff = (mBtLevel == kBtLevel_Off); }
+    if (radioOff) return;
+    { std::lock_guard<std::mutex> lk(mBtWizMutex);
+      for (const auto& d : mBtWizBonded) if (d.connected) mPs3DlgBtDevs.push_back(d); }
+    for (const auto& d : mPs3DlgBtDevs) {
+        mPs3DlgOptions.push_back(d.name.empty() ? d.address : d.name); mPs3DlgSwatch.push_back(-1);
+    }
+    mPs3DlgOptions.push_back(trDyn("Pair Device")); mPs3DlgSwatch.push_back(-1);
+}
+
+// Rebuild the Bluetooth chooser's device rows after a bonded-list refresh, keeping the cursor on
+// the same device (or on Pair Device).
+void NanoMenu::ps3DlgBtSync() {
+    if (!mPs3DlgBtRows || !mPs3DlgActive || mPs3DlgBtGen == mBtWizBondedGen) return;
+    if (!mPs3DlgBinding || strcmp(mPs3DlgBinding->label, "Bluetooth") != 0) { mPs3DlgBtRows = false; return; }
+    mPs3DlgBtGen = mBtWizBondedGen;
+    const int oldN = (int)mPs3DlgBtDevs.size(), rel = mPs3DlgSel - mPs3DlgBtBase;
+    const std::string selAddr = (rel >= 0 && rel < oldN) ? mPs3DlgBtDevs[rel].address : std::string();
+    mPs3DlgOptions.resize(mPs3DlgBtBase); mPs3DlgSwatch.resize(mPs3DlgBtBase);
+    ps3DlgBtAppendRows();
+    const int newN = (int)mPs3DlgBtDevs.size();
+    if (rel >= 0) {
+        mPs3DlgSel = mPs3DlgBtBase + newN;
+        for (int i = 0; i < newN && !selAddr.empty(); i++)
+            if (mPs3DlgBtDevs[i].address == selAddr) { mPs3DlgSel = mPs3DlgBtBase + i; break; }
+    }
+    if (mPs3DlgSel >= (int)mPs3DlgOptions.size()) mPs3DlgSel = (int)mPs3DlgOptions.size() - 1;
+    mDisplayDirty = true;
+}
+
+// Back to the Quick Menu Bluetooth chooser once the screens btQuickOpen opened have closed.
+void NanoMenu::btQuickReturnTick() {
+    if (!mBtQuickReturn || mPs3WizActive) return;
+    mBtQuickReturn = false;
+    const Ps3SettingBinding* b = ps3BindingFor("Bluetooth");
+    if (!b || !quickMenuOpen() || mPs3DlgActive) return;
+    openBoundChooser(b);
+    if (!mPs3DlgActive || !mPs3DlgBtRows) return;
+    mPs3DlgAnim = 1.0f;   // it never closed, as far as the user is concerned
+    int sel = mPs3DlgBtBase + (int)mPs3DlgBtDevs.size();   // Pair Device
+    for (int i = 0; i < (int)mPs3DlgBtDevs.size() && !mBtQuickReturnAddr.empty(); i++)
+        if (mPs3DlgBtDevs[i].address == mBtQuickReturnAddr) { sel = mPs3DlgBtBase + i; break; }
+    if (sel < (int)mPs3DlgOptions.size()) mPs3DlgSel = sel;
+    mDisplayDirty = true;
+}
+
+// Quick Menu Bluetooth chooser: a device row opens that device's options in the Manage Bluetooth
+// wizard; Pair Device (dev past the list) starts registering a new device.
+void NanoMenu::btQuickOpen(int dev) {
+    const bool isDev = dev >= 0 && dev < (int)mPs3DlgBtDevs.size();
+    mBtQuickReturn = false;   // so startBtWizard's own device list opens normally
+    startBtWizard(0);
+    mBtQuickReturn = true;
+    mBtQuickReturnAddr = isDev ? mPs3DlgBtDevs[dev].address : std::string();
+    if (isDev) {
+        const BtDevEntry& d = mPs3DlgBtDevs[dev];
+        mBtWizSelAddr = d.address; mBtWizSelName = d.name;
+        mBtWizSelCod = d.cod;      mBtWizSelConnected = d.connected;
+        wizEnter(WS_BT_DEVICE_OPTS, 1);
+    } else {
+        wizEnter(WS_BT_REGISTER_INFO, 1);
+    }
+}
