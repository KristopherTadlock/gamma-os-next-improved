+bool NanoMenu::isGameOptionsLevel(const Ps3Level& lvl) {
+    return !lvl.items.empty() && lvl.items[0].kind == PS3_QUICK && lvl.items[0].a == QA_GAME_OPT;
+}
+
+bool NanoMenu::gameOptResolve() {
+    if (mGameOptSys < 0 || mGameOptSys >= (int)mXmbSystems.size()) return false;
+    const std::vector<std::string>& roms = mXmbSystems[mGameOptSys].roms;
+    if (mGameOptRom >= 0 && mGameOptRom < (int)roms.size() && roms[mGameOptRom] == mGameOptPath) return true;
+    auto it = std::find(roms.begin(), roms.end(), mGameOptPath);
+    if (it == roms.end()) return false;
+    mGameOptRom = (int)(it - roms.begin());
+    return true;
+}
+
+void NanoMenu::buildGameOptions(Ps3Level& out) {
+    out.items.clear(); out.sel = 0; out.title = "Game Options";
+    if (!gameOptResolve()) return;
+    const XmbSystem& sys = mXmbSystems[mGameOptSys];
+    const std::string& rom = sys.roms[mGameOptRom];
+    if (mGameOptRom < (int)sys.displayNames.size() && !sys.displayNames[mGameOptRom].empty())
+        out.title = sys.displayNames[mGameOptRom];
+    auto add = [&](const char* label, const char* act, int icon, const std::string& value, const char* desc) {
+        Ps3Item it; it.label = label; it.kind = PS3_QUICK; it.a = QA_GAME_OPT; it.payloadStr = act;
+        it.value = value; if (desc) it.desc = desc;
+        it.iconTex = iconTexForIcon(icon); it.nmapTex = nmapForIcon(icon); it.iconR = it.iconG = it.iconB = 1.0f;
+        out.items.push_back(it);
+    };
