+// The gamelist's L/R SYSTEM help prompt (QuickSystemSelect=leftrightshoulders): the shoulders
+// switch to the previous or next system and stay in the gamelist, whatever its primary.
+void NanoMenu::esdeQuickSystemSelect(int dir) {
+    int s;
+    if (!esdeFocusedSystem(s)) return;
+    const int nSys = (int)mEsdeSysList.size();
+    mEsdeSysSel = ((mEsdeSysSel + dir) % nSys + nSys) % nSys;
+    mEsdeGameSel = 0;
+    mEsdeGridCursor = -1; mEsdeGridScroll = 0.0f; mEsdeGridAnimDur = 0.0f; mEsdeGridTransFactor = 1.0f;
