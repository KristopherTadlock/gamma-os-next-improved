+
+# The background scrape service (NanoScrapeQueue.h): a home writes the queue and sets
+# sys.gammaos.nano.scrape_run to a new token. It is its own process so a scrape outlives the home,
+# which exits when it starts a game. Low CPU and I/O priority on the little cores, so it does not
+# slow a game down. Its file label puts it in the homes' domain, whose network and storage access
+# it needs.
+service gammaos-nano-scrape /system/bin/gammaos-nano-scrape
+    class core
+    user root
+    group root inet media_rw sdcard_rw everybody external_storage
+    capabilities DAC_OVERRIDE DAC_READ_SEARCH
+    disabled
+    oneshot
+    priority 10
+    ioprio be 7
+    task_profiles ServiceCapacityLow LowIoPriority
+    # Killed before a running game when memory runs short (init's default makes it unkillable);
+    # the home then reports the scrape as stopped.
+    oom_score_adjust 800
+
+on property:sys.gammaos.nano.scrape_run=*
+    start gammaos-nano-scrape
