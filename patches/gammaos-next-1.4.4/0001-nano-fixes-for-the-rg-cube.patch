+// ES-DE start menu: one of the game settings screens over the ES-DE home - the focused platform's
+// Game Systems editor (page 0), the Game Systems list (1) or the Boxart Scraper settings (2).
+void NanoMenu::esdeOpenGameSettings(int page) {
+    esdeRebuildSysList();
+    const int sysIdx = (mEsdeSysSel >= 0 && mEsdeSysSel < (int)mEsdeSysList.size()) ? mEsdeSysList[mEsdeSysSel] : -1;
+    if (page == 0 && sysIdx < 0) return;
+    mEsdeMenuActive = false; mEsdeMenuClosing = false; mEsdeMenuAnim = 0.0f;
+    if (!mPs3MenuBuilt) initPs3Menu();
+    mPs3Stack.clear();
+    mPs3DlgActive = false; mPs3OptActive = false; mPs3BrightSlider = false;
+    mMenuState = MENU_MAIN;
+    if (mPs3SettingsCatIdx >= 0 && mPs3SettingsCatIdx < (int)mPs3Cats.size()) mPs3CatIdx = mPs3SettingsCatIdx;
+    mPs3ItemIdx = 0;
+    mNdsAtRoot = false;
+    Ps3Level lvl;
+    if (page == 0) {
+        mGsEditIdx = sysIdx;
+        buildGameSystemEditor(sysIdx, lvl);
+    } else if (page == 1) {
+        buildGameSystemsList(lvl);
+    } else {
+        for (const Ps3DataItem& d : kGameSettingsCh)
+            if (!strcmp(d.name, "Boxart Scraper")) buildDataSubmenu(&d, lvl, "settings/Game Settings/Boxart Scraper/");
+    }
+    mPs3Stack.push_back(lvl);
+    mNdsCamera = (float)ndsFocusSel(); mNdsScrubbing = false; mNdsFlingVel = 0.0f;
+    esdeApplySettingsTheme();
+    ps3Sfx(PS3_SFX_OK);
+    mDisplayDirty = true;
+}
