+
+struct GammaSurfaceFilterTarget {
+    gui::Uid appUid = gui::Uid::INVALID;
+    bool windowGame = false;   // the app draws its game into its window, not a SurfaceView
+    renderengine::GammaCrop crop = renderengine::GammaCrop::k4x3;
