+                        atm.getRecentTasks(100, 0, mCurrentUserId).getList();
+                for (android.app.ActivityManager.RecentTaskInfo ti : tasks) {
+                    if (ti.baseActivity != null
+                            && fgApp.equals(ti.baseActivity.getPackageName())) {
