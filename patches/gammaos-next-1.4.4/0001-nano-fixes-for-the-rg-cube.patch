+void NanoMenu::esdeMediaTouch(const std::string& path) {
+    auto it = mEsdeMediaUse.find(path);
+    if (it != mEsdeMediaUse.end()) { it->second.used = ++mEsdeMediaClock; return; }
+    EsdeMediaUse u;
+    u.used = ++mEsdeMediaClock;
+    auto d = mEsdePngDims.find(path);
+    if (d != mEsdePngDims.end()) {
+        long long w = d->second.first, h = d->second.second;
+        const long long longSide = std::max(w, h);
+        if (longSide > 2048) { w = w * 2048 / longSide; h = h * 2048 / longSide; }   // the decode cap
+        u.bytes = (size_t)(w * h * 4);
+    }
+    mEsdeMediaUse[path] = u;
+    size_t total = 0;
+    for (const auto& kv : mEsdeMediaUse) total += kv.second.bytes;
+    if (mEsdeMediaUse.size() <= 96 && total <= (128u << 20)) return;
+    // Drop the least recently drawn quarter, never an image drawn this frame or the last.
+    std::vector<std::pair<uint64_t, std::string>> byUse;
+    for (const auto& kv : mEsdeMediaUse)
+        if (kv.second.used <= mEsdeMediaPrevFrameClock) byUse.push_back({kv.second.used, kv.first});
+    std::sort(byUse.begin(), byUse.end());
+    const size_t drop = std::max<size_t>(1, mEsdeMediaUse.size() / 4);
+    for (size_t k = 0; k < byUse.size() && k < drop; k++) {
+        auto t = mEsdeTexCache.find(byUse[k].second);
+        if (t != mEsdeTexCache.end()) {
+            if (t->second) glDeleteTextures(1, &t->second);
+            mEsdeTexCache.erase(t);
+        }
+        mEsdePngDims.erase(byUse[k].second);
+        mEsdeMediaUse.erase(byUse[k].second);
+    }
+}
