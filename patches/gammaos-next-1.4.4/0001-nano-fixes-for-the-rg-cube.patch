+// Two hotkeys cannot share a button: the one that had the button takes this one's old button.
+void NanoMenu::hotkeyTakeButton(const Ps3SettingBinding* b, const std::string& v) {
+    static const char* const kRows[] = {"Save State Button", "Load State Button", "Fast Forward Button",
+                                        "Rewind Button", "Quit Game Button"};
+    if (std::find_if(std::begin(kRows), std::end(kRows), [&](const char* r) { return !strcmp(r, b->label); })
+        == std::end(kRows) || v == "NONE") return;
+    const std::string mine = readSettingValue(b->source, b->key, b->def);
+    for (const char* r : kRows) {
+        const Ps3SettingBinding* o = ps3BindingFor(r);
+        if (!o || o == b || readSettingValue(o->source, o->key, o->def) != v) continue;
+        writeSettingValue(o->source, o->key, mine);
+        mPs3BindCache.erase(o->label);
+    }
+}
