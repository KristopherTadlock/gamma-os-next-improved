+// The ES-DE home draws itself while the menu stack is empty, so there the Quick Menu is a pushed
+// level (as Nano Settings > Quick Menu is); the other themes show the Quick Menu category itself.
+bool NanoMenu::quickMenuOpen() const {
+    if (mEsdeTheme || mEsdeSettingsMinima) {
+        for (const auto& lvl : mPs3Stack) if (lvl.title == "Quick Menu") return true;
+        return false;
+    }
+    return mPs3QuickCatIdx >= 0 && mPs3CatIdx == mPs3QuickCatIdx
+        && !((mNdsTheme || mMinimaTheme) && mNdsAtRoot);
+}
+
+// Back on the Quick Menu's own level over a running app returns to the app, not the menu under it.
+bool NanoMenu::quickMenuBackResumes() const {
+    if (!(mOverlayMode && mOverlayShown && !mOverlayWallpaper) || !quickMenuOpen()) return false;
+    return (mEsdeTheme || mEsdeSettingsMinima) ? mPs3Stack.size() == 1 : mPs3Stack.empty();
+}
+
+// The Anbernic button: open the Quick Menu, or close it again when it, or a screen opened from it,
+// is open - over a running app, by resuming the app.
+void NanoMenu::toggleQuickMenu() {
+    esdeOverlayCloseAll();   // the ES-DE media viewer / game information would hide it
+    if (quickMenuOpen()) {
+        if (mOverlayMode && mOverlayShown && !mOverlayWallpaper) {
+            mQsReturn = QsReturn();
+            overlayResume();
+            return;
+        }
+        if (mQsReturn.valid && mQsReturn.cat >= 0 && mQsReturn.cat < (int)mPs3Cats.size()) {
+            mPs3Stack = mQsReturn.stack;
+            mPs3CatIdx = mQsReturn.cat; mPs3ItemIdx = mQsReturn.item;
+            mPs3CatItemSel[mPs3CatIdx] = mPs3ItemIdx;
+            mPs3AnimItem = (float)mPs3ItemIdx; mPs3ItemAnimStart = -1.0f;
+            mNdsAtRoot = mQsReturn.atRoot; mNdsCamera = mQsReturn.camera;
+        } else {
+            mPs3Stack.clear();
+            mNdsAtRoot = true;
+            // The XMB has no root to fall back to: step onto the next category, off the Quick Menu.
+            if (!mNdsTheme && !mMinimaTheme && !mEsdeTheme && !mEsdeSettingsMinima && mPs3CatIdx == mPs3QuickCatIdx
+                && mPs3CatIdx + 1 < (int)mPs3Cats.size()) {
+                mPs3CatIdx++;
+                mPs3ItemIdx = mPs3CatItemSel[mPs3CatIdx];
+                mPs3AnimItem = (float)mPs3ItemIdx; mPs3ItemAnimStart = -1.0f;
+            }
+            mNdsCamera = (float)mPs3CatIdx;
+        }
+        mQsReturn = QsReturn();
+        mNdsScrubbing = false; mNdsFlingVel = 0.0f;
+        mDisplayDirty = true;
+        return;
+    }
+    if (!mPs3MenuBuilt) initPs3Menu();
+    int quickIdx = (mPs3QuickCatIdx >= 0) ? mPs3QuickCatIdx : 0;
+    if (quickIdx < 0 || quickIdx >= (int)mPs3Cats.size()) return;
+    // Leaving the ES-DE menu (or a screen opened from it): the Quick Menu returns to the game list.
+    if (esdeMenuInContext()) {
+        mEsdeMenuReturn = false;
+        mPs3Stack.clear();
+        mEsdeMenuActive = false; mEsdeMenuClosing = false; mEsdeMenuAnim = 0.0f;
+    }
+    // The Wi-Fi / Bluetooth screens are not stack levels: close them (stopping their scans) rather
+    // than leave them running behind the Quick Menu.
+    if (mMenuState == MENU_WIFI) closeWifiScreen();
+    else if (mMenuState == MENU_BT) closeBtScreen();
+    mQsReturn.valid = true;
+    mQsReturn.stack = mPs3Stack;
+    mQsReturn.cat = mPs3CatIdx; mQsReturn.item = mPs3ItemIdx;
+    mQsReturn.atRoot = mNdsAtRoot; mQsReturn.camera = mNdsCamera;
+    mPs3Stack.clear();
+    mPs3DlgActive = false; mPs3OptActive = false; mPs3BrightSlider = false;
+    mMenuState = MENU_MAIN;
+    mPs3CatIdx  = quickIdx;
+    mPs3ItemIdx = 0;
+    mPs3CatItemSel[mPs3CatIdx] = mPs3ItemIdx;
+    mPs3AnimItem = (float)mPs3ItemIdx; mPs3ItemAnimStart = -1.0f; mPs3SubAnimStart = -1.0f;
+    mPs3CatAnimActive = false; mPs3CatT = 1.0f; mPs3CatFromOffset = 0.0f;
+    mNdsAtRoot = false;
+    if (mEsdeTheme || mEsdeSettingsMinima) {
+        Ps3Level lvl; lvl.title = mPs3Cats[quickIdx].name; lvl.items = mPs3Cats[quickIdx].items;
+        mPs3Stack.push_back(lvl);
+    }
+    mNdsCamera = (float)ndsFocusSel(); mNdsScrubbing = false; mNdsFlingVel = 0.0f;
+    esdeApplySettingsTheme();
+    ps3Sfx(PS3_SFX_OK);
+    mDisplayDirty = true;
+}
