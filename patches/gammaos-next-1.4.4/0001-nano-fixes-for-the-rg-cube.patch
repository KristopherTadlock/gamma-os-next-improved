+
+bool NanoMenu::esdeTouchStepInner(int dir) {
+    if (mEsdeTouchTarget == 3) {
+        if (!mEsdeMenuActive) return false;
+        const int n = esdeMenuPageRows(), next = mEsdeMenuSel + dir;
+        if (next < 0 || next >= n) return false;
+        mEsdeMenuSel = next;
+        mDisplayDirty = true;
+        return true;
+    }
+    if (mEsdeXsActive || mEsdeMenuActive) return false;
+    esdeRebuildSysList();
+    if (mEsdeSysList.empty()) return false;
+    if (mEsdeTouchTarget == 2) {
+        if (mEsdeInGamelist) return false;
+        esdeNav(dir, 0);   // the carousel loops
+        return true;
+    }
+    if (mEsdeTouchTarget != 1 || !mEsdeInGamelist) return false;
+    const int n = (int)mXmbSystems[mEsdeSysList[mEsdeSysSel]].roms.size();
+    const int before = mEsdeGameSel;
+    if (esdeGamelistIsGrid() && mEsdeTouchAxis == 2) {
+        esdeNav(0, dir);   // a whole row, stopping at the first and last
+    } else {
+        if (mEsdeGameSel + dir < 0 || mEsdeGameSel + dir >= n) return false;   // no wrap mid-drag
+        if (mEsdeTouchAxis == 1) esdeNav(dir, 0); else esdeNav(0, dir);
+    }
+    return mEsdeGameSel != before;
+}
+
+// Follow the finger: one entry per pitch it has moved from where it went down (dragging up moves
+// the list up, to later entries).
+static int esdeTouchWant(float pos, float pitch) {
+    return pitch > 0.0f ? -(int)(pos / pitch) : 0;
+}
+
+void NanoMenu::esdeTouchTick() {
+    if (!mEsdeFling) return;
+    if (mEsdeTouchTracking || (mEsdeTouchTarget == 3) != mEsdeMenuActive || mEsdeXsActive || !mPs3Stack.empty()) {
+        mEsdeFling = false;
+        return;
+    }
+    float dtMs = std::min(0.1f, std::max(0.0f, mFrameDt)) * 1000.0f;
+    mEsdeFlingPos += mEsdeFlingVel * dtMs;
+    mEsdeFlingVel *= expf(-dtMs / 325.0f);   // Android's scroller friction, roughly
+    const int want = esdeTouchWant(mEsdeFlingPos, esdeTouchPitch());
+    while (mEsdeTouchSteps != want) {
+        const int dir = want > mEsdeTouchSteps ? 1 : -1;
+        if (!esdeTouchStep(dir)) { mEsdeFling = false; break; }
+        mEsdeTouchSteps += dir;
+    }
+    if (fabsf(mEsdeFlingVel) < 0.05f) mEsdeFling = false;
+    mDisplayDirty = true;
+}
+
+void NanoMenu::esdeTouchFrame() {
+    float px, py;
+    if (!touchMapRaw(mTouchRawX, mTouchRawY, px, py)) { mTouchWasDown = mTouchDown; return; }
+    const bool down = mTouchDown, downEdge = down && !mTouchWasDown, upEdge = !down && mTouchWasDown;
+    mTouchWasDown = mTouchDown;
+    const int64_t now = android::uptimeMillis();
+    const float slop = std::min(mWidth, mHeight) * 0.04f;
+    auto inBox = [&](const float b[4]) { return px >= b[0] && px < b[0] + b[2] && py >= b[1] && py < b[1] + b[3]; };
+
+    if (downEdge) {
+        mEsdeFling = false;
+        mEsdeTouchTracking = true; mEsdeTouchMoved = false; mEsdeTouchAxis = 0; mEsdeTouchTarget = 0;
+        mEsdeTouchDownX = px; mEsdeTouchDownY = py; mEsdeTouchSteps = 0;
+        mEsdeTouchLastPos = 0.0f; mEsdeTouchVel = 0.0f; mEsdeTouchLastMs = now;
+        mLastInputMs = now;
+        return;
+    }
+    if (!mEsdeTouchTracking) return;
+    const float dx = px - mEsdeTouchDownX, dy = py - mEsdeTouchDownY;
+    if (down) {
+        mLastInputMs = now;
+        if (!mEsdeTouchMoved) {
+            if (dx * dx + dy * dy < slop * slop) return;
+            mEsdeTouchMoved = true;
+            mEsdeTouchAxis = fabsf(dx) > fabsf(dy) ? 1 : 2;
+            // What a drag along that axis scrolls; any other swipe acts on release.
+            const bool onList = inBox(mEsdeTouchArea);
+            if (mEsdeMenuActive) mEsdeTouchTarget = mEsdeTouchAxis == 2 ? 3 : 0;
+            else if (mEsdeXsActive) mEsdeTouchTarget = 0;
+            else if (!mEsdeInGamelist) mEsdeTouchTarget = mEsdeTouchAxis == 1 ? 2 : 0;
+            else if (onList && (mEsdeTouchAxis == 1) == (esdeGamelistIsHorizontal() || !mEsdeTouchVertical)
+                     && !(esdeGamelistIsGrid() && mEsdeTouchAxis == 1)) mEsdeTouchTarget = 1;
+        }
+        if (!mEsdeTouchTarget) return;
+        const float pos = mEsdeTouchAxis == 1 ? dx : dy;
+        if (now > mEsdeTouchLastMs) {
+            const float v = (pos - mEsdeTouchLastPos) / (float)(now - mEsdeTouchLastMs);
+            mEsdeTouchVel = mEsdeTouchVel * 0.4f + v * 0.6f;
+        }
+        mEsdeTouchLastPos = pos; mEsdeTouchLastMs = now;
+        const int want = esdeTouchWant(pos, esdeTouchPitch());
+        while (mEsdeTouchSteps != want) {
+            const int dir = want > mEsdeTouchSteps ? 1 : -1;
+            if (!esdeTouchStep(dir)) break;
+            mEsdeTouchSteps += dir;
+        }
+        return;
+    }
+    mEsdeTouchTracking = false;
+    if (!upEdge) return;
+
+    if (!mEsdeTouchMoved) {   // a tap
+        if (mEsdeMenuActive) {
+            if (!inBox(mEsdeMenuTouchBox)) { esdeMenuBack(); mDisplayDirty = true; return; }
+            if (mEsdeMenuTouchRowH <= 0.0f || py < mEsdeMenuTouchListY) return;
+            const int r = (int)((py - mEsdeMenuTouchListY) / mEsdeMenuTouchRowH);
+            const int i = mEsdeMenuScroll + r;
+            if (r >= mEsdeMenuTouchFit || i < 0 || i >= esdeMenuPageRows()) return;
+            mEsdeMenuSel = i;
+            esdeMenuSelect();
+            mDisplayDirty = true;
+            return;
+        }
+        if (mEsdeXsActive) return;
+        for (auto it = mEsdeTouchHits.rbegin(); it != mEsdeTouchHits.rend(); ++it) {
+            if (px < it->x || px >= it->x + it->w || py < it->y || py >= it->y + it->h) continue;
+            if (!inBox(mEsdeTouchArea) && mEsdeTouchArea[2] > 1.0f && mEsdeTouchArea[3] > 1.0f) break;   // clipped off
+            esdeRebuildSysList();
+            if (!mEsdeInGamelist) {   // a system opens
+                if (it->idx < 0 || it->idx >= (int)mEsdeSysList.size()) return;
+                if (it->idx != mEsdeSysSel) { mEsdeSysSel = it->idx; mEsdeGameSel = 0; }
+                esdeSelect();
+            } else if (it->idx == mEsdeGameSel) {
+                esdeSelect();         // the picked game launches
+            } else {
+                mEsdeGameSel = it->idx;
+                esdeSfx(4);
+            }
+            mDisplayDirty = true;
+            return;
+        }
+        return;
+    }
+    if (mEsdeTouchTarget) {
+        // Let go while moving: fling on, from where the finger left off.
+        const float pos = mEsdeTouchAxis == 1 ? dx : dy;
+        if (fabsf(mEsdeTouchVel) > 0.3f && now - mEsdeTouchLastMs < 100) {
+            // Only a list that can move that way flings (a quick flick at its end is a swipe).
+            const int dir = mEsdeTouchVel > 0.0f ? -1 : 1;
+            if (mEsdeTouchSteps != 0 || esdeTouchStep(dir)) {
+                if (mEsdeTouchSteps == 0) mEsdeTouchSteps = dir;
+                mEsdeFling = true; mEsdeFlingVel = mEsdeTouchVel;
+                // From where the steps taken so far put it (a probe step may be ahead of the finger).
+                if (dir < 0) mEsdeFlingPos = std::max(pos, -(float)mEsdeTouchSteps * esdeTouchPitch());
+                else         mEsdeFlingPos = std::min(pos, -(float)mEsdeTouchSteps * esdeTouchPitch());
+                mDisplayDirty = true;
+                return;
+            }
+        }
+        if (mEsdeTouchSteps != 0 || mEsdeTouchTarget == 3) return;
+        // A game list that could not move: pulled down at its top goes out to the systems, as a
+        // swipe down; a short swipe over the systems still changes system, below.
+        const bool atTop = esdeGamelistIsGrid() ? mEsdeGameSel < std::max(1, mEsdeGridColumns) : mEsdeGameSel == 0;
+        if (mEsdeTouchTarget == 1 && !(mEsdeTouchAxis == 2 && dy > 0.0f && atTop)) return;
+    }
+    if (mEsdeMenuActive || mEsdeXsActive) return;
+    const float dist = mEsdeTouchAxis == 1 ? fabsf(dx) : fabsf(dy);
+    if (dist < std::min(mWidth, mHeight) * 0.08f) return;
+    esdeRebuildSysList();
+    if (mEsdeSysList.empty()) return;
+    if (mEsdeTouchAxis == 1) {
+        // Across: the next or previous system, in the game list too.
+        const int dir = dx < 0.0f ? 1 : -1;
+        if (!mEsdeInGamelist) { esdeNav(dir, 0); return; }
+        const int n = (int)mEsdeSysList.size();
+        mEsdeSysSel = ((mEsdeSysSel + dir) % n + n) % n;
+        mEsdeGameSel = 0;
+        mEsdeGridCursor = -1; mEsdeGridScroll = 0.0f; mEsdeGridAnimDur = 0.0f; mEsdeGridTransFactor = 1.0f;
+        esdeSfx(0);
+        mDisplayDirty = true;
+    } else if (dy < 0.0f && !mEsdeInGamelist) {
+        esdeSelect();   // up: into the system's games
+    } else if (dy > 0.0f && mEsdeInGamelist) {
+        esdeBack();     // down: back to the systems
+    }
+}
