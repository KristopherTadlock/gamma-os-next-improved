+std::vector<int> NanoMenu::scrapeEnabledExtras() const {
+    std::vector<int> out;
+    for (int t = 0; t < nanoscraper::kExtraMediaCount; t++) {
+        const std::string prop = std::string("persist.gammaos.scraper.media.") + nanoscraper::kExtraMedia[t].key;
