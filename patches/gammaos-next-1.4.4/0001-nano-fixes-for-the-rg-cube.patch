+void NanoMenu::buildBoxartSources(Ps3Level& out) {
+    out.items.clear(); out.sel = 0; out.title = "Set Boxart"; out.screenKind = BOXART_SRC;
+    auto add = [&](const std::string& label, const std::string& payload, int icon, const std::string& value, const char* desc) {
+        Ps3Item it; it.label = label; it.kind = PS3_QUICK; it.a = QA_BOXART_SRC; it.payloadStr = payload;
+        it.value = value; if (desc) it.desc = desc;
+        it.iconTex = iconTexForIcon(icon); it.nmapTex = nmapForIcon(icon); it.iconR = it.iconG = it.iconB = 1.0f;
+        out.items.push_back(it);
+    };
+    static const struct { const char* type; const char* label; } kMedia[] = {
+        {"screenshot", "Use Screenshot"}, {"titlescreen", "Use Title Screen"}, {"miximage", "Use Miximage"},
+        {"3dbox", "Use 3D Box"}, {"backcover", "Use Back Cover"}, {"physicalmedia", "Use Physical Media"},
+        {"marquee", "Use Marquee"}, {"fanart", "Use Fan Art"},
+    };
+    const ScrapeEntry* se = scrapeEntryFor(mBoxartPickRom);
+    std::vector<std::string> used;
+    for (const auto& m : kMedia) {
+        std::string f = esdeGameMediaPath(mBoxartPickRom, m.type);
+        if (f.empty() && se && !strcmp(m.type, "fanart")) f = se->fan;
+        if (f.empty() || (se && f == se->box) || std::find(used.begin(), used.end(), f) != used.end()) continue;
+        used.push_back(f);
+        add(m.label, f, 62, "", "Use this picture the game already has as its cover.");
+    }
+    add("Browse Files...", "files", 50, "", "Pick a PNG or JPEG anywhere on the device, the card or a share.");
+    char n[32]; snprintf(n, sizeof(n), "%zu", mPhotos.size());
+    add("Photo Library", "photos", 62, mPhotos.empty() && mPhotoScanRunning ? std::string("Searching...") : std::string(n),
+        "Pictures in the DCIM and Pictures folders.");
+}
