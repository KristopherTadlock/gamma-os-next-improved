+std::string NanoMenu::retroarchConfigFile() {
+    char d[PROPERTY_VALUE_MAX] = {};
+    property_get("persist.gammaos.retroarch.dir", d, "");
+    if (d[0] == '/') {
+        const std::string cfg = std::string(d) + "/retroarch.cfg";
+        if (access(cfg.c_str(), R_OK) == 0) return cfg;
+    }
+    return std::string(kRaDefCfgDir) + "/retroarch.cfg";   // default, or the card is not in
+}
+
+// Move Emulator Settings: RetroArch's folder moves to `to`; its app-folder parts and default config
+// are copied (RetroArch keeps its own, the rewrite points them at the new folder).
+void NanoMenu::retroarchMovePairs(const std::string& to, const std::string& backup, int group,
+                                  std::vector<FileCopyPair>* pairs) {
+    char cur[PROPERTY_VALUE_MAX] = {};
+    property_get("persist.gammaos.retroarch.dir", cur, "");
+    const std::string from = cur[0] == '/' ? std::string(cur) : std::string();
+    mFileJobFrom = from;
+    mFileJobTo = to;
+    FileCopyPair main{raPart(from, ""), raPart(to, ""), false, !from.empty()};
+    main.move = true;
+    main.backup = backup;
+    main.group = group;
+    pairs->push_back(main);
+    if (from.empty()) {
+        for (const char* part : kRaAppParts) {
+            FileCopyPair p{raPart(from, part), raPart(to, part)};
+            p.group = group;
+            pairs->push_back(p);
+        }
+        FileCopyPair cfg{raCfgDir(from) + "/retroarch.cfg", raCfgDir(to) + "/retroarch.cfg"};
+        cfg.group = group;
+        pairs->push_back(cfg);
+    }
+}
+
+bool NanoMenu::retroarchFolderRewrite() {
+    const std::string& from = mFileJobFrom;
+    const std::string& to = mFileJobTo;
+    const auto map = raPrefixMap(from, to);
+    const auto keys = raDirKeys(to);
+    // The new location's config, and the default one (which RetroArch opens when started on its
+    // own, and other frontends pass) so every launch uses the new folders.
+    bool ok = raRewriteFile(raCfgDir(to) + "/retroarch.cfg", map, &keys);
+    if (!ok) {
+        ALOGW("ps3menu: RetroArch folder: rewriting %s/retroarch.cfg failed", raCfgDir(to).c_str());
+        return false;   // the other configs keep the old folders too
+    }
+    if (!to.empty()) raRewriteFile(std::string(kRaDefCfgDir) + "/retroarch.cfg", map, &keys);
+    raRewriteTree(raPart(to, "") + "/config", map);   // per-core overrides and shader presets
+    return true;
+}
+
+void NanoMenu::retroarchFolderFinish() {
+    const std::string& from = mFileJobFrom;
+    const std::string& to = mFileJobTo;
+    property_set("persist.gammaos.retroarch.dir", to.c_str());
+    // Folders outside internal storage need RetroArch's all-files access.
+    if (!to.empty()) system("appops set --uid com.retroarch.aarch64 MANAGE_EXTERNAL_STORAGE allow >/dev/null 2>&1");
+    loadRecentPlaylist();
+    photoShowBanner(trDyn(to.empty() ? "RetroArch folder: Default" : "RetroArch folder set"));
+    ALOGI("ps3menu: RetroArch folder %s -> %s", from.empty() ? "default" : from.c_str(), to.empty() ? "default" : to.c_str());
+    mDisplayDirty = true;
+}
