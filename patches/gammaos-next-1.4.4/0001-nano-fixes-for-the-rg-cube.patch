+
+// GammaOS: RetroArch draws its game into its window (a NativeActivity, no SurfaceView).
+bool gammaIsRetroArch(const std::string& pkg) {
+    return pkg == "com.retroarch" || pkg == "com.retroarch.aarch64" || pkg == "com.retroarch.ra32";
+}
+
+// GammaOS: apps 4:3 and 8:7 Cropped leave alone: persist.gammaos.shader.4x3.exclude
+// (comma-separated).
+bool gammaSurfaceFilterExcluded(const std::string& pkg) {
+    for (const auto& excluded :
+         base::Split(base::GetProperty("persist.gammaos.shader.4x3.exclude"s, ""), ",")) {
+        if (base::Trim(excluded) == pkg) return true;
+    }
+    return false;
+}
+
+// The launched emulator, if 4:3 or 8:7 Cropped should filter it. Its uid comes from its input
+// window; those container layers draw nothing, so this runs before the drawable snapshots are moved.
+std::optional<GammaSurfaceFilterTarget> gammaSurfaceFilterTarget(
+        const frontend::LayerSnapshotBuilder& builder) {
+    const auto crop = renderengine::gammaSurfaceCrop();
+    if (!crop || !base::GetBoolProperty("sys.gammaos.nano.app_launched"s, false)) {
+        return std::nullopt;
+    }
+    const std::string pkg = base::GetProperty("sys.gammaos.nano.launch_app"s, "");
+    if (pkg.empty() || gammaSurfaceFilterExcluded(pkg)) return std::nullopt;
+
+    GammaSurfaceFilterTarget target;
+    builder.forEachInputSnapshot([&](const frontend::LayerSnapshot& snapshot) {
+        if (target.appUid == gui::Uid::INVALID && snapshot.inputInfo.token &&
+            snapshot.inputInfo.packageName == pkg) {
+            target.appUid = snapshot.inputInfo.ownerUid;
+        }
+    });
+    if (target.appUid == gui::Uid::INVALID) return std::nullopt;
+    target.windowGame = base::GetBoolProperty("persist.gammaos.shader.4x3.window." + pkg,
+                                              gammaIsRetroArch(pkg));
+    target.crop = *crop;
+    return target;
+}
+
+// Marks the emulator's game layer on each display for the filter and clears every other layer.
+// Emulators draw the game into a SurfaceView and their menus, launchers and settings into windows,
+// so only a SurfaceView is filtered, unless persist.gammaos.shader.4x3.window.<package> says the
+// app draws its game into its window (a SurfaceView still first). Then an opaque layer wins (a
+// window drawn over a SurfaceView has to be translucent), then the largest. Each display (the
+// panel, and a monitor's mirror of it) has its own game layer, marked only when its picture is one
+// the filter projects there, so any other picture keeps its normal composition.
+void gammaSelectSurfaceFilterLayer(compositionengine::CompositionRefreshArgs& refreshArgs,
+                                   const std::vector<std::pair<Layer*, LayerFE*>>& layers,
+                                   const std::optional<GammaSurfaceFilterTarget>& target) {
+    struct Pick {
+        LayerFE* layerFE = nullptr;
+        bool surfaceView = false;
+        bool opaque = false;
+        float area = 0.f;
+    };
+    static std::vector<std::pair<int32_t, uint32_t>> sMarked;   // (sequence, layer stack)
+
+    std::unordered_map<uint32_t, Pick> picks;
+    if (target) {
+        for (const auto& [_, layerFE] : layers) {
+            const auto& snapshot = *layerFE->mSnapshot;
+            if (snapshot.uid != target->appUid || !snapshot.externalTexture ||
+                snapshot.isSecure || snapshot.hasProtectedContent) {
+                continue;
+            }
+            const bool surfaceView = snapshot.name.find("SurfaceView[") != std::string::npos;
+            if (!surfaceView && !target->windowGame) continue;
+            const float area =
+                    snapshot.transformedBounds.getWidth() * snapshot.transformedBounds.getHeight();
+            if (area <= 0.f) continue;
+            Pick& pick = picks[snapshot.outputFilter.layerStack.id];
+            if (!pick.layerFE || (surfaceView && !pick.surfaceView) ||
+                (surfaceView == pick.surfaceView &&
+                 ((snapshot.contentOpaque && !pick.opaque) ||
+                  (snapshot.contentOpaque == pick.opaque && area > pick.area)))) {
+                pick = {layerFE, surfaceView, snapshot.contentOpaque, area};
+            }
+        }
+    }
+
+    std::unordered_map<uint32_t, Rect> displays;   // layer stack -> its logical display area
+    for (const auto& output : refreshArgs.outputs) {
+        const auto& state = output->getState();
+        displays.emplace(state.layerFilter.layerStack.id, state.layerStackSpace.getContent());
+    }
+    std::unordered_set<LayerFE*> marked;
+    std::vector<std::pair<int32_t, uint32_t>> markedIds;
+    for (const auto& [layerStack, pick] : picks) {
+        const auto display = displays.find(layerStack);
+        if (display == displays.end()) continue;
+        const auto& bounds = pick.layerFE->mSnapshot->geomLayerBounds;
+        if (!renderengine::gammaCropProjection(target->crop, bounds.getWidth(), bounds.getHeight(),
+                                               display->second.getWidth(),
+                                               display->second.getHeight())) {
+            continue;
+        }
+        marked.insert(pick.layerFE);
+        markedIds.emplace_back(pick.layerFE->mSnapshot->sequence, layerStack);
+    }
+    std::sort(markedIds.begin(), markedIds.end());
+    // Output layers only drop forced client composition on a geometry update.
+    if (markedIds != sMarked) {
+        sMarked = std::move(markedIds);
+        refreshArgs.updatingGeometryThisFrame = true;
+    }
+    for (const auto& [_, layerFE] : layers) {
+        layerFE->mSnapshot->gammaSurfaceFilter = marked.count(layerFE)
+                ? std::make_optional(renderengine::GammaSurfaceFilter{target->crop})
+                : std::nullopt;
+    }
+}
