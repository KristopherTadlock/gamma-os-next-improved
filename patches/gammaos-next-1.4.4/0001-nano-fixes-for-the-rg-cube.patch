+// The card's connector and CRTC ids.
+static bool drmResources(int fd, std::vector<uint32_t>* conns, std::vector<uint32_t>* crtcs) {
+    struct drm_mode_card_res res = {};
+    if (ioctl(fd, DRM_IOCTL_MODE_GETRESOURCES, &res) != 0) return false;
+    conns->resize(res.count_connectors);
+    crtcs->resize(res.count_crtcs);
+    struct drm_mode_card_res res2 = {};
+    res2.count_connectors = res.count_connectors;
+    res2.connector_id_ptr = (uint64_t)(uintptr_t)conns->data();
+    res2.count_crtcs = res.count_crtcs;
+    res2.crtc_id_ptr = (uint64_t)(uintptr_t)crtcs->data();
+    if (ioctl(fd, DRM_IOCTL_MODE_GETRESOURCES, &res2) != 0) return false;
+    conns->resize(std::min(res.count_connectors, res2.count_connectors));
+    crtcs->resize(std::min(res.count_crtcs, res2.count_crtcs));
+    return true;
