+bool NanoMenu::setClockFromInternet() {
+    system("settings put global auto_time 1 2>/dev/null");
+    FILE* f = popen("curl -sI --max-time 8 http://example.com 2>/dev/null | grep -i '^date:'", "r");
+    if (!f) return false;
+    char line[160] = {};
