+}
+
+// The triggers jump to the first or last game, as in ES-DE's gamelists.
+void NanoMenu::esdeJumpToEdge(int dir) {
+    int s;
+    if (!esdeFocusedSystem(s)) return;
+    const int n = (int)mXmbSystems[s].roms.size();
+    if (n <= 0) return;
+    const int sel = dir < 0 ? 0 : n - 1;
+    if (sel != mEsdeGameSel) { mEsdeGameSel = sel; esdeSfx(4); }   // scroll
+    mDisplayDirty = true;
+}
+
+// The gamelist's thumbstick-click RANDOM help prompt: focus a random game, without launching it.
+void NanoMenu::esdeRandomGame() {
+    int s;
+    if (!esdeFocusedSystem(s)) return;
+    const int n = (int)mXmbSystems[s].roms.size();
+    if (n < 2) return;
+    int sel = rand() % (n - 1);
+    if (sel >= mEsdeGameSel) sel++;            // never the game already focused
+    mEsdeGameSel = sel;
+    esdeSfx(4);                                // scroll
+    mDisplayDirty = true;
+}
