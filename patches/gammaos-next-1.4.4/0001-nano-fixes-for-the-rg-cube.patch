+// ---------------------------------------------------------------------------
+// Folder copy: every file under each source copied to the same place under its destination,
+// skipping files that already exist there (nothing is overwritten or deleted). Runs on a worker
+// behind the scraper's progress modal; B cancels between files.
+// ---------------------------------------------------------------------------
+
+bool NanoMenu::fileCopyStart(int kind, const char* title, std::vector<FileCopyPair> pairs) {
+    if (mScrapeRunning || !mScrapeMoveDst.empty() || mFileJobKind != 0) {
+        photoShowBanner(trDyn("Another copy or scrape is running"));
+        return false;
+    }
+    for (const auto& pr : pairs) {
+        if (pr.dst.compare(0, pr.src.size() + 1, pr.src + "/") == 0) {   // into itself: never ends
+            photoShowBanner(trDyn("Pick a folder outside the current one"));
+            return false;
+        }
+    }
+    mFileJobKind = kind;
+    mScrapeJobTitle = title;
+    mScrapeCopyMode = true;
+    mScrapeMoveMode = false;
+    mScrapeProgActive = true;
+    mScrapeDoneFlag = false;
+    mScrapeCancel = false;
+    mScrapeError.clear();
+    mScrapeStatus = trDyn("Counting files...");
+    mScrapeDone = 0; mScrapeHits = 0; mScrapeFail = 0; mScrapeSkip = 0;
+    mScrapeTotal = 0;
+    mScrapeRunning = true;
+    std::thread(&NanoMenu::fileCopyThreadFunc, this, std::move(pairs)).detach();
+    mDisplayDirty = true;
+    return true;
+}
+
+static bool nanoCopyFile(const std::string& src, const std::string& dst) {
+    int in = open(src.c_str(), O_RDONLY | O_CLOEXEC);
+    if (in < 0) return false;
+    const std::string tmp = dst + ".nanocopy";
+    int out = open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0664);
+    if (out < 0) { close(in); return false; }
+    static thread_local char buf[256 * 1024];
+    bool ok = true;
+    for (;;) {
+        ssize_t rd = read(in, buf, sizeof(buf));
+        if (rd < 0) { ok = false; break; }
+        if (rd == 0) break;
+        for (ssize_t off = 0; off < rd;) {
+            ssize_t wr = write(out, buf + off, (size_t)(rd - off));
+            if (wr <= 0) { ok = false; break; }
+            off += wr;
+        }
+        if (!ok) break;
+    }
+    if (close(out) != 0) ok = false;
+    close(in);
+    if (!ok || rename(tmp.c_str(), dst.c_str()) != 0) { unlink(tmp.c_str()); return false; }
+    return true;
+}
+
+void NanoMenu::fileCopyThreadFunc(std::vector<FileCopyPair> pairs) {
+    if (mFileJobKind == 2 && isRetroArchRunning()) {
+        // RetroArch rewrites its config on exit: ask it to save and quit first (as a power-off
+        // does), and stop it only if it does not.
+        property_set("sys.gammaos.nano.drop_input", "0");
+        property_set("sys.gammaos.nano.overlay_esc", "1");
+        for (int i = 0; i < 50 && isRetroArchRunning(); i++) {
+            if (i == 10 || i == 25) property_set("sys.gammaos.nano.overlay_esc", "1");
+            usleep(100000);
+        }
+        if (isRetroArchRunning()) system("am force-stop com.retroarch.aarch64 >/dev/null 2>&1");
+    }
+    // Collect (relative path) for every regular file first, so the modal can show a total. A
+    // folder or file that is there but cannot be read (a card pulled mid-copy), or a required
+    // source that is missing, counts as a failure, so the setting is not switched to an incomplete
+    // copy; an optional source that does not exist (an unused default folder) is simply skipped.
+    struct Item { size_t pair; std::string rel; };
+    std::vector<Item> items;
+    int unreadable = 0, missingRequired = 0;
+    std::function<void(size_t, const std::string&, const std::string&)> walk =
+        [&](size_t pi, const std::string& dir, const std::string& rel) {
+            DIR* d = opendir(dir.c_str());
+            if (!d) { unreadable++; return; }
+            for (;;) {
+                errno = 0;
+                dirent* e = readdir(d);
+                if (!e) { if (errno != 0) unreadable++; break; }
+                if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+                const std::string full = dir + "/" + e->d_name;
+                const std::string r = rel.empty() ? std::string(e->d_name) : rel + "/" + e->d_name;
+                struct stat st;
+                if (lstat(full.c_str(), &st) != 0) { if (errno != ENOENT) unreadable++; continue; }
+                if (S_ISDIR(st.st_mode)) walk(pi, full, r);
+                else if (S_ISREG(st.st_mode)) items.push_back({pi, r});
+            }
+            closedir(d);
+        };
+    for (size_t i = 0; i < pairs.size(); i++) {
+        if (pairs[i].src == pairs[i].dst) continue;
+        struct stat st;
+        if (stat(pairs[i].src.c_str(), &st) != 0) {
+            if (errno != ENOENT) unreadable++;
+            else if (pairs[i].required) missingRequired++;
+            continue;
+        }
+        if (S_ISDIR(st.st_mode)) walk(i, pairs[i].src, std::string());
+        else if (S_ISREG(st.st_mode)) items.push_back({i, std::string()});   // a single file
+    }
+    {
+        std::lock_guard<std::mutex> lk(mScrapeMutex);
+        mScrapeTotal = (int)items.size();
+        if (missingRequired > 0) {
+            mScrapeFail += missingRequired;
+            mScrapeError = trDyn("The current folder is missing. Is the SD card in?");
+        } else if (unreadable > 0) {
+            mScrapeFail += unreadable;
+            mScrapeError = trDyn("Some folders could not be read.");
+        }
+    }
+    for (const auto& it : items) {
+        const FileCopyPair& pr = pairs[it.pair];
+        const std::string src = it.rel.empty() ? pr.src : pr.src + "/" + it.rel;
+        const std::string dst = it.rel.empty() ? pr.dst : pr.dst + "/" + it.rel;
+        {
+            std::lock_guard<std::mutex> lk(mScrapeMutex);
+            if (mScrapeCancel) break;
+            mScrapeStatus = it.rel.empty() ? src.substr(src.find_last_of('/') + 1) : it.rel;
+        }
+        struct stat st, sst;
+        int result;   // 0 copied, 1 already there, 2 failed
+        const bool exists = lstat(dst.c_str(), &st) == 0;
+        const bool checkAge = exists && pr.replaceOlder && S_ISREG(st.st_mode);
+        if (checkAge && stat(src.c_str(), &sst) != 0) {
+            result = 2;
+        } else if (exists && !(checkAge && sst.st_mtime > st.st_mtime)) {
+            result = 1;
+        } else {
+            nanoMkdirs(dst.substr(0, dst.find_last_of('/')));
+            result = nanoCopyFile(src, dst) ? 0 : 2;
+        }
+        std::lock_guard<std::mutex> lk(mScrapeMutex);
+        mScrapeDone++;
+        if (result == 0) mScrapeHits++;
+        else if (result == 1) mScrapeSkip++;
+        else { mScrapeFail++; if (mScrapeError.empty()) mScrapeError = trDyn("Some files could not be copied."); }
+    }
+    // The RetroArch folder: point its configs at the new folder now, off the render thread,
+    // when every file made it.
+    bool rewriteFailed = false;
+    if (mFileJobKind == 2) {
+        bool clean;
+        { std::lock_guard<std::mutex> lk(mScrapeMutex); clean = !mScrapeCancel && mScrapeFail == 0; }
+        if (clean && !retroarchFolderRewrite()) rewriteFailed = true;
+    }
+    std::lock_guard<std::mutex> lk(mScrapeMutex);
+    if (rewriteFailed) {
+        mScrapeFail++;
+        if (mScrapeError.empty()) mScrapeError = trDyn("RetroArch's settings could not be updated.");
+    }
+    mScrapeRunning = false;
+    mScrapeDoneFlag = true;
+}
+
+// Render thread, every frame: once a copy has finished, switch the folder it was copying for.
+// A cancelled copy leaves the setting as it was.
+void NanoMenu::fileJobTick() {
+    if (mFileJobKind == 0) return;
+    bool done, cancelled; int failed;
+    {
+        std::lock_guard<std::mutex> lk(mScrapeMutex);
+        done = mScrapeDoneFlag && !mScrapeRunning;
+        cancelled = mScrapeCancel;
+        failed = mScrapeFail;
+    }
+    if (!done) return;
+    const int kind = mFileJobKind;
+    mFileJobKind = 0;
+    if (cancelled) {
+        photoShowBanner(trDyn("Copy cancelled. The folder was not changed."));
+        return;
+    }
+    if (failed > 0) {   // switching would leave the files that failed behind
+        photoShowBanner(trDyn("Some files could not be copied. The folder was not changed."));
+        return;
+    }
+    if (kind == 1) esdeMediaFolderApply(mFileJobTo);
+    else if (kind == 2) retroarchFolderFinish();
+}
+
+// ---------------------------------------------------------------------------
+// RetroArch Folder. RetroArch's settings file and the folders of the user's own setup live
+// either in RetroArch's defaults (its RetroArch folder on internal storage, its config in
+// Android/data, shaders/overlays/filters/controller profiles in its app folder) or together in
+// one chosen folder T: T/retroarch.cfg, T/system, T/saves, ..., T/shaders, T/overlays,
+// T/filters, T/autoconfig. Moving copies the files (keeping any already at the destination),
+// then rewrites the folder settings in RetroArch's config files to the new place.
+// ---------------------------------------------------------------------------
+
+namespace {
+const char* const kRaPkgData = "/data/user/0/com.retroarch.aarch64";
+const char* const kRaDefSd = "/storage/emulated/0/RetroArch";
+const char* const kRaDefCfgDir = "/storage/emulated/0/Android/data/com.retroarch.aarch64/files";
+// The folders kept in RetroArch's app folder by default (copied out, never back: the app
+// folder keeps its own copies, and files written there by nano would not belong to RetroArch).
+const char* const kRaAppParts[] = {"shaders", "overlays", "filters", "autoconfig"};
+
+std::string raPart(const std::string& loc, const char* part) {   // part "" = the RetroArch folder itself
+    if (loc.empty()) return *part ? std::string(kRaPkgData) + "/" + part : std::string(kRaDefSd);
+    return *part ? loc + "/" + part : loc;
+}
+std::string raCfgDir(const std::string& loc) { return loc.empty() ? std::string(kRaDefCfgDir) : loc; }
+
+// The folder settings every RetroArch config gets for location `loc`.
+std::vector<std::pair<std::string, std::string>> raDirKeys(const std::string& loc) {
+    const std::string sd = raPart(loc, "");
+    return {
+        {"system_directory", sd + "/system"},          {"savefile_directory", sd + "/saves"},
+        {"savestate_directory", sd + "/states"},       {"screenshot_directory", sd + "/screenshots"},
+        {"recording_output_directory", sd + "/recordings"}, {"recording_config_directory", sd + "/records_config"},
+        {"rgui_config_directory", sd + "/config"},     {"input_remapping_directory", sd + "/config/remaps"},
+        {"cheat_database_path", sd + "/cheats"},       {"playlist_directory", sd + "/playlists"},
+        {"thumbnails_directory", sd + "/thumbnails"},  {"core_assets_directory", sd + "/downloads"},
+        {"log_dir", sd + "/logs"},                     {"cache_directory", sd + "/temp"},
+        {"content_favorites_path", sd + "/playlists/builtin/content_favorites.lpl"},
+        {"content_history_path", sd + "/playlists/builtin/content_history.lpl"},
+        {"content_image_history_path", sd + "/playlists/builtin/content_image_history.lpl"},
+        {"content_music_history_path", sd + "/playlists/builtin/content_music_history.lpl"},
+        {"content_video_history_path", sd + "/playlists/builtin/content_video_history.lpl"},
+        {"video_shader_dir", raPart(loc, "shaders")},  {"overlay_directory", raPart(loc, "overlays")},
+        {"osk_overlay_directory", raPart(loc, "overlays") + "/keyboards"},
+        {"audio_filter_dir", raPart(loc, "filters") + "/audio"},
+        {"video_filter_dir", raPart(loc, "filters") + "/video"},
+        {"joypad_autoconfig_dir", raPart(loc, "autoconfig")},
+    };
+}
+
+// Old path prefix -> new, longest first, for every path in a config or shader preset (an
+// overlay or shader picked from the old folder).
+std::vector<std::pair<std::string, std::string>> raPrefixMap(const std::string& from, const std::string& to) {
+    std::vector<std::pair<std::string, std::string>> m;
+    for (const char* part : kRaAppParts) {
+        // Back to the defaults, a folder's files land in the RetroArch folder (T/shaders ->
+        // RetroArch/shaders), not RetroArch's app folder.
+        const std::string dst = to.empty() && !from.empty() ? std::string(kRaDefSd) + "/" + part : raPart(to, part);
+        m.push_back({raPart(from, part), dst});
+        if (from.empty()) m.push_back({std::string("/data/data/com.retroarch.aarch64/") + part, dst});
+    }
+    m.push_back({raPart(from, ""), raPart(to, "")});
+    std::sort(m.begin(), m.end(), [](const auto& a, const auto& b) { return a.first.size() > b.first.size(); });
+    return m;
+}
+
+// Rewrites a RetroArch config/preset in place: every quoted path under an old prefix moves to the
+// new one, and (forceKeys) the folder settings are set to the new location.
+bool raRewriteFile(const std::string& path, const std::vector<std::pair<std::string, std::string>>& map,
+                   const std::vector<std::pair<std::string, std::string>>* forceKeys) {
+    FILE* f = fopen(path.c_str(), "re");
+    if (!f) return false;
+    std::vector<std::string> lines;
+    char buf[4096];
+    while (fgets(buf, sizeof(buf), f)) {
+        std::string l = buf;
+        while (!l.empty() && (l.back() == '\n' || l.back() == '\r')) l.pop_back();
+        lines.push_back(l);
+    }
+    fclose(f);
+    std::set<std::string> seen;
+    bool changed = false;
+    for (auto& l : lines) {
+        size_t q1 = l.find('"'), q2 = l.rfind('"');
+        if (q1 == std::string::npos || q2 <= q1) continue;
+        std::string v = l.substr(q1 + 1, q2 - q1 - 1);
+        for (const auto& pm : map) {
+            if (v == pm.first || v.compare(0, pm.first.size() + 1, pm.first + "/") == 0) {
+                v = pm.second + v.substr(pm.first.size());
+                break;
+            }
+        }
+        if (forceKeys) {   // an empty folder setting gets the new folder; the user's own paths stay
+            size_t eq = l.find('=');
+            std::string key = l.substr(0, eq == std::string::npos ? 0 : eq);
+            while (!key.empty() && key.back() == ' ') key.pop_back();
+            for (const auto& fk : *forceKeys)
+                if (key == fk.first) { seen.insert(key); if (v.empty()) v = fk.second; }
+        }
+        const std::string nl = l.substr(0, q1 + 1) + v + l.substr(q2);
+        if (nl != l) { l = nl; changed = true; }
+    }
+    if (forceKeys)
+        for (const auto& fk : *forceKeys)
+            if (!seen.count(fk.first)) { lines.push_back(fk.first + " = \"" + fk.second + "\""); changed = true; }
+    if (!changed) return true;
+    const std::string tmp = path + ".nanotmp";
+    FILE* o = fopen(tmp.c_str(), "we");
+    if (!o) return false;
+    for (const auto& l : lines) fprintf(o, "%s\n", l.c_str());
+    if (fclose(o) != 0 || rename(tmp.c_str(), path.c_str()) != 0) { unlink(tmp.c_str()); return false; }
+    return true;
+}
+
+void raRewriteTree(const std::string& dir, const std::vector<std::pair<std::string, std::string>>& map) {
+    DIR* d = opendir(dir.c_str());
+    if (!d) return;
+    while (dirent* e = readdir(d)) {
+        if (e->d_name[0] == '.') continue;
+        const std::string full = dir + "/" + e->d_name;
+        struct stat st;
+        if (lstat(full.c_str(), &st) != 0) continue;
+        if (S_ISDIR(st.st_mode)) { raRewriteTree(full, map); continue; }
+        const char* ext = strrchr(e->d_name, '.');
+        if (ext && (!strcasecmp(ext, ".cfg") || !strcasecmp(ext, ".slangp") || !strcasecmp(ext, ".glslp")
+                    || !strcasecmp(ext, ".cgp")))
+            raRewriteFile(full, map, nullptr);
+    }
+    closedir(d);
+}
+}  // namespace
+
+std::string NanoMenu::rawStoragePath(const std::string& p) {
+    const std::string emu = "/storage/emulated/0";
+    if (p == emu || p.compare(0, emu.size() + 1, emu + "/") == 0) return "/data/media/0" + p.substr(emu.size());
+    if (p.compare(0, 9, "/storage/") == 0 && p.compare(0, 14, "/storage/self/") != 0) return "/mnt/media_rw/" + p.substr(9);
+    return p;
+}
