+            while (root.size() > 1 && root.back() == '/') root.pop_back();
+            if (root.size() > bestLen && romPath.size() > root.size() + 1 &&
+                romPath.compare(0, root.size(), root) == 0 && romPath[root.size()] == '/') {
+                bestLen = root.size(); bestSys = s; bestRoot = root;
+            }
+        }
+    }
+    if (bestSys < 0) return false;
+    if (outSys) *outSys = bestSys;
+    if (outDir) { size_t sl = bestRoot.find_last_of('/'); *outDir = sl == std::string::npos ? bestRoot : bestRoot.substr(sl + 1); }
+    if (outRel) *outRel = romPath.substr(bestLen + 1);
+    return true;
