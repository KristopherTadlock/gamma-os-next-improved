+// A path as its raw folder (/data/media/0, /mnt/media_rw/<volume>), links resolved.
+static std::string sdCanon(const std::string& p) {
+    auto toRaw = [](const std::string& q) {
+        const std::string emu = "/storage/emulated/0";
+        if (q == emu || q.compare(0, emu.size() + 1, emu + "/") == 0) return "/data/media/0" + q.substr(emu.size());
+        if (q.compare(0, 9, "/storage/") == 0 && q.compare(0, 14, "/storage/self/") != 0) return "/mnt/media_rw/" + q.substr(9);
+        return q;
+    };
+    std::string c = toRaw(p);
+    char buf[PATH_MAX];
+    if (realpath(c.c_str(), buf)) c = toRaw(buf);
+    while (c.size() > 1 && c.back() == '/') c.pop_back();
+    return c;
+}
+
+static bool sdUnder(const std::string& a, const std::string& b) {   // a is b or inside it
+    return a == b || (a.size() > b.size() && a.compare(0, b.size(), b) == 0 && a[b.size()] == '/');
+}
+
+// A folder that holds more than one program's files, never moved whole: a storage root, one of its
+// standard folders, Android's app folders, or one holding Nano Backup (or, unless it is the one
+// moved, the ES-DE folder).
+static bool sdTooBroad(const std::string& src, bool esdeItself) {
+    const std::string c = sdCanon(src);
+    auto isRoot = [](const std::string& d) {
+        return d == "/data/media/0" || (d.compare(0, 14, "/mnt/media_rw/") == 0 && d.find('/', 14) == std::string::npos);
+    };
+    if (isRoot(c) || c == "/data/media" || c == "/mnt/media_rw" || c == "/" || c == "/data") return true;
+    const size_t sl = c.find_last_of('/');
+    const std::string parent = c.substr(0, sl);
+    std::string base = c.substr(sl + 1);
+    for (auto& ch : base) ch = (char)tolower((unsigned char)ch);
+    if (isRoot(parent)) {
+        static const char* const kStd[] = {"download", "dcim", "pictures", "music", "movies", "documents", "android",
+                                           "roms", "alarms", "notifications", "podcasts", "ringtones", "recordings",
+                                           "audiobooks", "bios"};
+        for (const char* s : kStd) if (base == s) return true;
+    }
+    if (parent.size() >= 8 && parent.compare(parent.size() - 8, 8, "/Android") == 0
+        && (base == "data" || base == "media" || base == "obb"))
+        return true;
+    if (sdUnder(sdCanon(kBackupRoot), c)) return true;
+    if (!esdeItself && sdUnder(sdCanon(kEsdeInternal), c)) return true;
+    return false;
+}
+
+static void sdMkdirs(const std::string& dir) {
+    for (size_t i = 1; i <= dir.size(); i++)
+        if ((i == dir.size() || dir[i] == '/') && !nanoscraper::isVolumeRoot(dir.substr(0, i)))
+            ::mkdir(dir.substr(0, i).c_str(), 0775);
+}
+
+static void sdRemoveTree(const std::string& path) {
+    struct stat st;
+    if (lstat(path.c_str(), &st) != 0) return;
+    if (S_ISDIR(st.st_mode)) {
+        if (DIR* d = opendir(path.c_str())) {
+            while (dirent* e = readdir(d))
+                if (strcmp(e->d_name, ".") && strcmp(e->d_name, "..")) sdRemoveTree(path + "/" + e->d_name);
+            closedir(d);
+        }
+        rmdir(path.c_str());
+    } else {
+        unlink(path.c_str());
+    }
+}
+
+// Removes the folders under dir (and dir) that hold nothing.
+static bool sdPruneEmpty(const std::string& dir) {
+    DIR* d = opendir(dir.c_str());
+    if (!d) return false;
+    bool empty = true;
+    while (dirent* e = readdir(d)) {
+        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+        const std::string full = dir + "/" + e->d_name;
+        struct stat st;
+        if (lstat(full.c_str(), &st) == 0 && S_ISDIR(st.st_mode) && sdPruneEmpty(full)) continue;
+        empty = false;
+    }
+    closedir(d);
+    return empty && rmdir(dir.c_str()) == 0;
+}
+
+static bool sdReadFile(const std::string& path, std::string* out) {
+    const int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0) return false;
+    struct stat st;
+    bool ok = fstat(fd, &st) == 0 && st.st_size < 64 * 1024 * 1024;
+    if (ok) {
+        out->resize(st.st_size);
+        ok = st.st_size == 0 || read(fd, &(*out)[0], st.st_size) == st.st_size;
+    }
+    close(fd);
+    return ok;
+}
+
+static bool sdWriteFile(const std::string& path, const std::string& text) {
+    sdMkdirs(path.substr(0, path.find_last_of('/')));
+    const std::string tmp = path + ".nanotmp";
+    const int fd = open(tmp.c_str(), O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0664);
+    if (fd < 0) return false;
+    bool ok = write(fd, text.data(), text.size()) == (ssize_t)text.size();
+    ok = close(fd) == 0 && ok;
+    if (!ok || rename(tmp.c_str(), path.c_str()) != 0) { unlink(tmp.c_str()); return false; }
+    return true;
+}
+
+// Replaces a file in an app's private folder: owned like its folder, the old file's mode, the
+// app's SELinux label. The app is stopped first (it rewrites its settings when it closes).
+static bool sdWriteAppFile(const std::string& path, const std::string& text) {
+    const std::string dir = path.substr(0, path.find_last_of('/'));
+    struct stat dst, old;
+    if (stat(dir.c_str(), &dst) != 0) {   // the app never made it (never started): as its app folder
+        const std::string parent = dir.substr(0, dir.find_last_of('/'));
+        struct stat pst;
+        if (stat(parent.c_str(), &pst) != 0 || mkdir(dir.c_str(), 0771) != 0) return false;
+        if (chown(dir.c_str(), pst.st_uid, pst.st_gid) != 0) ALOGW("sdmove: chown %s failed", dir.c_str());
+        system(("restorecon '" + dir + "' >/dev/null 2>&1").c_str());
+        if (stat(dir.c_str(), &dst) != 0) return false;
+    }
+    const bool had = stat(path.c_str(), &old) == 0;
+    const std::string tmp = path + ".nanotmp";
+    unlink(tmp.c_str());
+    const int fd = open(tmp.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+    if (fd < 0) return false;
+    bool ok = write(fd, text.data(), text.size()) == (ssize_t)text.size() && fsync(fd) == 0;
+    // A file the app cannot read is as bad as none: it would ask for its folder again.
+    if (fchown(fd, dst.st_uid, dst.st_gid) != 0) { ALOGW("sdmove: chown %s failed", path.c_str()); ok = false; }
+    if (fchmod(fd, had ? (old.st_mode & 0777) : 0600) != 0) ok = false;
+    ok = close(fd) == 0 && ok;
+    if (!ok || rename(tmp.c_str(), path.c_str()) != 0) { unlink(tmp.c_str()); return false; }
+    unlink((path + ".bak").c_str());   // SharedPreferences would restore its backup over it
+    const std::string cmd = "restorecon '" + path + "' >/dev/null 2>&1";
+    if (system(cmd.c_str()) != 0) ALOGW("sdmove: restorecon %s failed", path.c_str());
+    return true;
+}
+
+// An app's SharedPreferences file as the app would load it: its backup when there is one (the
+// file itself was being written when the app stopped).
+static bool sdReadPrefs(const std::string& path, std::string* out) {
+    return access((path + ".bak").c_str(), F_OK) == 0 ? sdReadFile(path + ".bak", out) : sdReadFile(path, out);
+}
+
+static std::string sdShown(const std::string& path) {   // a path as the user knows it
+    const std::string emu = "/storage/emulated/0";
+    if (path.compare(0, emu.size(), emu) == 0) return "Internal storage" + path.substr(emu.size());
+    if (path.compare(0, 9, "/storage/") == 0) return "microSD card" + path.substr(path.find('/', 9));
+    return path;
+}
+
+// The microSD card: the first removable volume Nano can write to, as apps see it (/storage/XXXX-XXXX).
+std::string NanoMenu::sdCardRoot() {
+    std::vector<std::string> found;
+    if (DIR* d = opendir("/storage")) {
+        while (dirent* e = readdir(d)) {
+            const std::string n = e->d_name;
+            if (n == "." || n == ".." || n == "emulated" || n == "self") continue;
+            const std::string p = "/storage/" + n;
+            struct stat st;
+            // A card or USB drive (a removable volume: it has its raw mount), not a network share.
+            if (access(("/mnt/media_rw/" + n).c_str(), F_OK) == 0 && stat(p.c_str(), &st) == 0 && S_ISDIR(st.st_mode)
+                && access(p.c_str(), W_OK) == 0)
+                found.push_back(p);
+        }
+        closedir(d);
+    }
+    std::sort(found.begin(), found.end());
+    return found.empty() ? std::string() : found[0];
+}
