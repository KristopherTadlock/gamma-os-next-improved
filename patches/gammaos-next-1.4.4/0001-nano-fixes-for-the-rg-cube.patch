--- /dev/null
+++ b/frameworks/native/libs/renderengine/include/renderengine/GammaSurfaceFilter.h
@@ -0,0 +1,126 @@
+/*
+ * Copyright 2026 The GammaOS Next Improved Project
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
