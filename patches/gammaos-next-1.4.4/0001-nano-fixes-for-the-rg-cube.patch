+// Delete Game's media: every file the media lookups would find for the game (each media folder,
+// each of its system folders and names, every media type and file type), unless another game of
+// the system has the same media name (two files of one game title share their media).
+int NanoMenu::esdeDeleteGameMedia(const std::string& romPath, int sysIdx, const std::vector<std::string>& gone) {
+    std::vector<std::string> sysDirs, names;
+    if (!esdeMediaLayout(romPath, sysIdx, &sysDirs, &names, nullptr) || names.empty()) return 0;
+    if (sysIdx >= 0 && sysIdx < (int)mXmbSystems.size()) {
+        std::vector<std::string> others = mXmbSystems[sysIdx].roms;
+        for (const auto& kv : mHiddenGames) others.push_back(kv.second);   // a hidden game keeps its media
+        for (const auto& other : others) {
+            if (other == romPath || std::find(gone.begin(), gone.end(), other) != gone.end()) continue;
+            std::vector<std::string> od, on;
+            if (!esdeMediaLayout(other, sysIdx, &od, &on, nullptr)) continue;
+            if (std::find(od.begin(), od.end(), sysDirs[0]) == od.end()) continue;   // another system folder
+            for (const auto& n : on)
+                names.erase(std::remove(names.begin(), names.end(), n), names.end());
+        }
+    }
+    static const char* const kSubdirs[] = {"covers", "backcovers", "3dboxes", "physicalmedia", "marquees",
+                                           "miximages", "screenshots", "titlescreens", "fanart", "manuals",
+                                           "videos"};
+    int deleted = 0;
+    for (const auto& root : esdeMediaRoots())
+        for (const auto& sd : sysDirs)
+            for (const char* sub : kSubdirs)
+                for (const auto& nm : names)
+                    for (const char* const* ext = esdeMediaExts(sub); *ext; ext++) {
+                        const std::string p = root + sd + "/" + sub + "/" + nm + *ext;
+                        if (unlink(p.c_str()) != 0) continue;
+                        deleted++;
+                        auto t = mEsdeTexCache.find(p);
+                        if (t != mEsdeTexCache.end()) {
+                            if (t->second) glDeleteTextures(1, &t->second);
+                            mEsdeTexCache.erase(t);
+                        }
+                    }
+    esdeForgetGameMedia(romPath);
+    return deleted;
+}
