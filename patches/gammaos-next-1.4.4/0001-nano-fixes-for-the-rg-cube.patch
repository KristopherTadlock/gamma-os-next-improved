+
+void NanoMenu::retroarchFolderSelect(const std::string& path) {
+    if (!mPs3Stack.empty() && mPs3Stack.back().screenKind == GS_FOLDERBROWSE) mPs3Stack.pop_back();
+    mDisplayDirty = true;
+    std::string to = (path.empty() || path == "@default") ? std::string() : path;
+    while (to.size() > 1 && to.back() == '/') to.pop_back();
+    // RetroArch opens files through /storage (its own view of storage); /mnt paths are only
+    // nano's.
+    if (to.compare(0, 14, "/mnt/media_rw/") == 0) to = "/storage/" + to.substr(14);
+    if (!to.empty() && to.compare(0, 9, "/storage/") != 0) {
+        photoShowBanner(trDyn("RetroArch can't use that folder. Pick one on internal storage or an SD card."));
+        return;
+    }
+    char cur[PROPERTY_VALUE_MAX] = {};
+    property_get("persist.gammaos.retroarch.dir", cur, "");
+    const std::string from = cur[0] == '/' ? std::string(cur) : std::string();
+    if (to == from) { photoShowBanner(trDyn("RetroArch folder unchanged")); return; }
+    if (!to.empty()) {
+        struct stat st = {};
+        nanoMkdirs(to);
+        if (stat(to.c_str(), &st) != 0 || !S_ISDIR(st.st_mode) || access(to.c_str(), W_OK) != 0) {
+            photoShowBanner(trDyn("RetroArch folder: not writable"));
+            ALOGW("ps3menu: RetroArch folder %s rejected: %s", to.c_str(), strerror(errno));
+            return;
+        }
+    }
+    // Moving back to the defaults, newer files replace the defaults' older copies (the saves and
+    // config used since the last move). A move to a chosen folder never replaces anything.
+    const bool back = to.empty();
+    std::vector<FileCopyPair> pairs;
+    // A chosen folder being moved from holds the user's current setup: it must be there. The
+    // defaults may not exist yet (RetroArch never started).
+    const bool fromChosen = !from.empty();
+    pairs.push_back({raPart(from, ""), raPart(to, ""), back, fromChosen});   // a chosen folder holds the app parts too
+    if (from.empty())   // out of the defaults: RetroArch's app-folder parts as well
+        for (const char* part : kRaAppParts) pairs.push_back({raPart(from, part), raPart(to, part), false, false});
+    if (from.empty() || to.empty())   // card to card, the config is in the folder copy
+        pairs.push_back({raCfgDir(from) + "/retroarch.cfg", raCfgDir(to) + "/retroarch.cfg", back, fromChosen});
+    mFileJobFrom = from; mFileJobTo = to;
+    fileCopyStart(2, "RetroArch Folder", std::move(pairs));
+}
+
+bool NanoMenu::retroarchFolderRewrite() {
+    const std::string& from = mFileJobFrom;
+    const std::string& to = mFileJobTo;
+    const auto map = raPrefixMap(from, to);
+    const auto keys = raDirKeys(to);
+    // The new location's config, and the default one (which RetroArch opens when started on its
+    // own, and other frontends pass) so every launch uses the new folders.
+    bool ok = raRewriteFile(raCfgDir(to) + "/retroarch.cfg", map, &keys);
+    if (!to.empty()) raRewriteFile(std::string(kRaDefCfgDir) + "/retroarch.cfg", map, &keys);
+    raRewriteTree(raPart(to, "") + "/config", map);   // per-core overrides and shader presets
+    if (!ok) ALOGW("ps3menu: RetroArch folder: rewriting %s/retroarch.cfg failed", raCfgDir(to).c_str());
+    return ok;
+}
+
+void NanoMenu::retroarchFolderFinish() {
+    const std::string& from = mFileJobFrom;
+    const std::string& to = mFileJobTo;
+    property_set("persist.gammaos.retroarch.dir", to.c_str());
+    // Folders outside internal storage need RetroArch's all-files access.
+    if (!to.empty()) system("appops set --uid com.retroarch.aarch64 MANAGE_EXTERNAL_STORAGE allow >/dev/null 2>&1");
+    loadRecentPlaylist();
+    photoShowBanner(trDyn(to.empty() ? "RetroArch folder: Default" : "RetroArch folder set"));
+    ALOGI("ps3menu: RetroArch folder %s -> %s", from.empty() ? "default" : from.c_str(), to.empty() ? "default" : to.c_str());
+    mDisplayDirty = true;
+}
