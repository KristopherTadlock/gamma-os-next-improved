+
+// Game Options: one game's options as a menu level - its own emulator, title, box art, scraping,
+// favourites, collections and information. The rows run the same actions as the XMB's game option
+// menu, on the game it was opened for.
+void NanoMenu::openGameOptions(int sysIdx, int romIdx) {
+    if (sysIdx < 0 || sysIdx >= (int)mXmbSystems.size()) return;
+    if (romIdx < 0 || romIdx >= (int)mXmbSystems[sysIdx].roms.size()) return;
+    mGameOptSys = sysIdx; mGameOptRom = romIdx; mGameOptPath = mXmbSystems[sysIdx].roms[romIdx];
+    if (!mPs3MenuBuilt) initPs3Menu();
+    mPs3Stack.clear();
+    mPs3DlgActive = false; mPs3OptActive = false; mPs3BrightSlider = false;
+    mMenuState = MENU_MAIN;
+    if (mPs3SettingsCatIdx >= 0 && mPs3SettingsCatIdx < (int)mPs3Cats.size()) mPs3CatIdx = mPs3SettingsCatIdx;
+    mPs3ItemIdx = 0;
+    mNdsAtRoot = false;
+    Ps3Level lvl; buildGameOptions(lvl); mPs3Stack.push_back(lvl);
+    mNdsCamera = (float)ndsFocusSel(); mNdsScrubbing = false; mNdsFlingVel = 0.0f;
+    esdeApplySettingsTheme();
+    ps3Sfx(PS3_SFX_OK);
+    mDisplayDirty = true;
+}
+
+bool NanoMenu::kioskMode() {
+    return property_get_bool("persist.gammaos.nano.kiosk", false);
+}
+
+bool NanoMenu::isGameOptionsLevel(const Ps3Level& lvl) {
+    return !lvl.items.empty() && lvl.items[0].kind == PS3_QUICK && lvl.items[0].a == QA_GAME_OPT;
+}
+
+bool NanoMenu::gameOptResolve() {
+    if (mGameOptSys < 0 || mGameOptSys >= (int)mXmbSystems.size()) return false;
+    const std::vector<std::string>& roms = mXmbSystems[mGameOptSys].roms;
+    if (mGameOptRom >= 0 && mGameOptRom < (int)roms.size() && roms[mGameOptRom] == mGameOptPath) return true;
+    auto it = std::find(roms.begin(), roms.end(), mGameOptPath);
+    if (it == roms.end()) return false;
+    mGameOptRom = (int)(it - roms.begin());
+    return true;
+}
+
+void NanoMenu::buildGameOptions(Ps3Level& out) {
+    out.items.clear(); out.sel = 0; out.title = "Game Options";
+    if (!gameOptResolve()) return;
+    const XmbSystem& sys = mXmbSystems[mGameOptSys];
+    const std::string& rom = sys.roms[mGameOptRom];
+    if (mGameOptRom < (int)sys.displayNames.size() && !sys.displayNames[mGameOptRom].empty())
+        out.title = sys.displayNames[mGameOptRom];
+    auto add = [&](const char* label, const char* act, int icon, const std::string& value, const char* desc) {
+        Ps3Item it; it.label = label; it.kind = PS3_QUICK; it.a = QA_GAME_OPT; it.payloadStr = act;
+        it.value = value; if (desc) it.desc = desc;
+        it.iconTex = iconTexForIcon(icon); it.nmapTex = nmapForIcon(icon); it.iconR = it.iconG = it.iconB = 1.0f;
+        out.items.push_back(it);
+    };
+    add("Search Games", "search", 22, "", "Search every game system.");
+    const GameEmulator* ge = gameEmulatorFor(rom);
+    add("Emulator", "romemu", 22, ge ? ge->label : std::string("System Default"),
+        "The emulator this game opens with. System Default uses the one set for its game system.");
+    add("Rename / Edit Title", "romrename", 25, "", "The name shown for this game, also used to search for its box art.");
+    add("Set Boxart", "setboxart", 62, "", "Pick any image as this game's cover.");
+    const ScrapeEntry* be = scrapeEntryFor(rom);
+    if (be && !be->box.empty() && be->box != rom) add("Reset Boxart", "resetboxart", 62, "", "Remove this game's cover.");
+    add("Scrape This Game", "romscrape", 8, "", "Download box art and information for this game again.");
+    add("Scrape with Custom Name...", "romscrapecustom", 8, "", "Search for this game's box art under a name you type.");
+    // In the ES-DE home a favourite can also come from ES-DE's own game lists, as for its Y button.
+    const bool esde = mEsdeTheme || mEsdeSettingsMinima;
+    const bool fav = esde ? esdeIsFavorite(rom, esdeMetaFor(rom)) : isFavorite(rom);
+    add(fav ? "Remove from Favorites" : "Add to Favorites", esde ? "esdefav" : "togfav", 5, "", nullptr);
+    add("Add to Collection", "addcol", 15, "", nullptr);
+    add("Information", "rominfo", 22, "", nullptr);
+}
+
+// Game Options > Emulator: the system's own emulator, then the catalog's emulators for this game's
+// platform (or, when the catalog has none filed under it, every emulator).
+void NanoMenu::openGameEmulatorPicker(int sysIdx, const std::string& romPath) {
+    if (sysIdx < 0 || sysIdx >= (int)mXmbSystems.size()) return;
+    loadEmuCatalog();
+    mGameEmuRom = romPath;
+    const XmbSystem& sys = mXmbSystems[sysIdx];
+    const GameEmulator* cur = gameEmulatorFor(romPath);
+    Ps3Level lvl; lvl.title = "Emulator for This Game"; lvl.sel = 0;
+    auto row = [&](const std::string& label, int catIdx, bool active) {
+        Ps3Item it; it.label = label; it.kind = PS3_QUICK; it.a = QA_GAME_EMU_SET; it.b = catIdx;
+        if (active) { it.value = "Active"; lvl.sel = (int)lvl.items.size(); }
+        it.iconTex = iconTexForIcon(22); it.nmapTex = nmapForIcon(22); it.iconR = it.iconG = it.iconB = 1.0f;
+        lvl.items.push_back(it);
+    };
+    std::string sysEmu = sys.launchType == XLT_CUSTOM_PACKAGE ? sys.packageName : sys.coreSo;
+    row(sysEmu.empty() ? std::string("System Default") : "System Default (" + sysEmu + ")", -1, cur == nullptr);
+    // The system's platform's emulators that can run here; a platform the catalog doesn't know lists
+    // the catalog entries whose platform name matches the system's.
+    const std::string uid = emuPlatformFor(sys);
+    bool noneReady = false;
+    if (!uid.empty()) {
+        for (int i : emuPlatformChoices(uid, noneReady))
+            row(emuEntryLabel(i), i, cur && cur->amArgs == mEmuCatalog[i].amArgs);
+    } else {
+        const std::string filter = sys.shortname.empty() ? sys.name : sys.shortname;
+        for (int i = 0; i < (int)mEmuCatalog.size(); i++)
+            if (strcasestr(mEmuCatalog[i].platform.c_str(), filter.c_str()))
+                row(mEmuCatalog[i].platform + " - " + emuEntryLabel(i), i, cur && cur->amArgs == mEmuCatalog[i].amArgs);
+    }
+    mPs3Stack.push_back(lvl);
+    mDisplayDirty = true;
+}
