+// sysIdx: the system it is listed under (the first system holding it when -1).
+void NanoMenu::esdeToggleFavoriteRom(const std::string& rom, int sysIdx) {
+    const ScrapeEntry* meta = esdeMetaFor(rom);
+    const bool metaFav = meta && meta->favorite;
+    auto un = std::find(mEsdeUnfavorites.begin(), mEsdeUnfavorites.end(), rom);
+    if (esdeIsFavorite(rom, meta)) {
+        if (isFavorite(rom)) toggleFavorite(rom);
+        if (metaFav && un == mEsdeUnfavorites.end()) { mEsdeUnfavorites.push_back(rom); saveFavorites(); }
+    } else {
+        if (un != mEsdeUnfavorites.end()) { mEsdeUnfavorites.erase(un); saveFavorites(); }
+        if (!metaFav) toggleFavorite(rom);
+    }
