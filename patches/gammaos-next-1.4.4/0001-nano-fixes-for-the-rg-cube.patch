+// The gamelist's Y FAVORITES help prompt: toggle the focused game's favourite, which the gamelist's
+// star, favourite badge and favourite counts read. Switching off a favourite imported from ES-DE's
+// metadata is remembered in mEsdeUnfavorites.
+void NanoMenu::esdeToggleFavorite() {
+    int s;
+    if (!esdeFocusedSystem(s)) return;
+    const auto& sys = mXmbSystems[s];
+    if (mEsdeGameSel < 0 || mEsdeGameSel >= (int)sys.roms.size()) return;
+    esdeToggleFavoriteRom(sys.roms[mEsdeGameSel]);
+}
+
+void NanoMenu::esdeToggleFavoriteRom(const std::string& rom) {
+    const ScrapeEntry* meta = esdeMetaFor(rom);
+    const bool metaFav = meta && meta->favorite;
+    auto un = std::find(mEsdeUnfavorites.begin(), mEsdeUnfavorites.end(), rom);
+    if (esdeIsFavorite(rom, meta)) {
+        if (isFavorite(rom)) toggleFavorite(rom);
+        if (metaFav && un == mEsdeUnfavorites.end()) { mEsdeUnfavorites.push_back(rom); saveFavorites(); }
+    } else {
+        if (un != mEsdeUnfavorites.end()) { mEsdeUnfavorites.erase(un); saveFavorites(); }
+        if (!metaFav) toggleFavorite(rom);
+    }
+    favoritesResort(rom);
+    esdeSfx(5);                                // favorite
+    mDisplayDirty = true;
+}
+
+// The gamelist's X VIEW MEDIA help prompt: the focused game's media viewer.
+void NanoMenu::esdeOpenGameInfo() {
+    int s;
+    if (!esdeFocusedSystem(s)) return;
+    esdeViewerOpen(s, mEsdeGameSel);
+}
+
+// The gamelist's BACK OPTIONS help prompt (Select): the focused game's Game Options - its own
+// emulator, title, box art and scraping, as ES-DE's gamelist options menu edits them.
+bool NanoMenu::esdeOpenGameOptions() {
+    int s;
+    if (!esdeFocusedSystem(s)) return false;
+    if (mEsdeGameSel < 0 || mEsdeGameSel >= (int)mXmbSystems[s].roms.size()) return false;
+    openGameOptions(s, mEsdeGameSel);
