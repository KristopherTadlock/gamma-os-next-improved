diff --git a/frameworks/native/services/gammapad/BrowserMode.cpp b/frameworks/native/services/gammapad/BrowserMode.cpp
new file mode 100644
index 00000000000..7fa355d1232
--- /dev/null
+++ b/frameworks/native/services/gammapad/BrowserMode.cpp
@@ -0,0 +1,546 @@
+#define LOG_TAG "gammapad"
+
+#include "BrowserMode.h"
+
+#include <android-base/logging.h>
+#include <android-base/properties.h>
+#include <android-base/strings.h>
+#include <sys/timerfd.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <iterator>
+
+namespace gammapad {
+
+using android::base::GetIntProperty;
+
+static constexpr int TICK_INTERVAL_MS = 16;
+// Entries ending in * match by prefix (every Fulguris build: F-Droid, Play Store, GitHub).
+static constexpr const char* kDefaultPackages = "com.brave.browser,net.slions.fulguris.*";
+// Fulguris bookmarks the page with Ctrl+B (its Ctrl+D duplicates the tab); Chromium uses Ctrl+D.
+static constexpr const char* kCtrlBBookmarkPrefix = "net.slions.fulguris.";
+
+static constexpr int CURSOR_DEADZONE = 4096;
+static constexpr int SCROLL_DEADZONE = 6000;
+static constexpr float CURSOR_SPEED = 12.0f;   // px per tick, right stick fully over
+static constexpr float SCROLL_SPEED = 0.5f;    // wheel steps per tick, left stick fully over
+// The D-pad (cursor mode, Select + D-pad) speeds up from min to max over DPAD_RAMP_MS.
+static constexpr float DPAD_CURSOR_MIN = 2.0f, DPAD_CURSOR_MAX = 12.0f;
+static constexpr float DPAD_SCROLL_MIN = 0.15f, DPAD_SCROLL_MAX = 0.5f;
+static constexpr float DPAD_RAMP_MS = 1000.0f;
+static constexpr int TRIGGER_PRESS = 16000, TRIGGER_RELEASE = 8000;
+
+static bool packageMatches(const std::string& entry, const std::string& pkg) {
+    if (!entry.empty() && entry.back() == '*') {
+        return android::base::StartsWith(pkg, entry.substr(0, entry.size() - 1));
+    }
+    return entry == pkg;
+}
+
+BrowserMode::BrowserMode() = default;
+
+BrowserMode::~BrowserMode() {
+    if (mTimerFd >= 0) close(mTimerFd);
+}
+
+int BrowserMode::init() {
+    mTimerFd = timerfd_create(CLOCK_MONOTONIC, TFD_NONBLOCK | TFD_CLOEXEC);
+    if (mTimerFd < 0) LOG(ERROR) << "BrowserMode: timerfd_create failed: " << strerror(errno);
+    return mTimerFd;
+}
+
+bool BrowserMode::update(bool bindingsEnabled) {
+    bool fgChanged = false, pkgsChanged = false;
+    const std::string fgPkg = mFgPkgProp.Get(&fgChanged);
+    const char* pkgs = mPkgsProp.Get(&pkgsChanged);
+    if (fgChanged || pkgsChanged || !mMatchValid) {
+        mIsBrowser = false;
+        if (!fgPkg.empty()) {
+            for (const auto& pkg : android::base::Split(*pkgs ? pkgs : kDefaultPackages, ",")) {
+                if (packageMatches(android::base::Trim(pkg), fgPkg)) {
+                    mIsBrowser = true;
+                    break;
+                }
+            }
+        }
+        mBookmarkKey = android::base::StartsWith(fgPkg, kCtrlBBookmarkPrefix) ? KEY_B : KEY_D;
+        mMatchValid = true;
+    }
+    bool want = bindingsEnabled && mIsBrowser && !mUnavailable &&
+                strcmp(mOverlayProp.Get(), "1") != 0;
+    if (want == mActive) return false;
+    if (want) {
+        activate();
+    } else {
+        deactivate();
+    }
+    return true;
+}
+
+void BrowserMode::activate() {
+    if (!mMouse) {
+        mMouse = std::make_unique<VirtualMouse>();
+        if (!mMouse->create()) {
+            LOG(ERROR) << "BrowserMode: no virtual mouse, browser profile disabled";
+            mMouse.reset();
+            mUnavailable = true;
+            return;
+        }
+    }
+    if (!mKeyboard) {
+        mKeyboard = std::make_unique<VirtualKeyboard>();
+        // No KEY_Q: a keyboard with Q counts as alphabetic, and Android then hides the IME.
+        if (!mKeyboard->create({KEY_LEFTCTRL, KEY_LEFTSHIFT, KEY_TAB, KEY_W, KEY_T, KEY_L, KEY_D,
+                                KEY_B, KEY_R, KEY_ENTER, KEY_UP, KEY_DOWN, KEY_LEFT, KEY_RIGHT},
+                               "GammaOS Browser Keys", 0x0b21)) {
+            LOG(ERROR) << "BrowserMode: no virtual keyboard, browser profile disabled";
+            mKeyboard.reset();
+            mUnavailable = true;
+            return;
+        }
+    }
+
+    if (GetIntProperty("persist.gammaos.gamepad.device_pid", 0x0b13) == 0x02fd) {
+        mRxCode = ABS_RX, mRyCode = ABS_RY, mLtCode = ABS_Z, mRtCode = ABS_RZ;
+    } else {
+        mRxCode = ABS_Z, mRyCode = ABS_RZ, mLtCode = ABS_BRAKE, mRtCode = ABS_GAS;
+    }
+
+    // The browser must not see a button left held on the gamepad. Mode passes through, so it
+    // keeps its state.
+    for (int code = BTN_A; code <= BTN_THUMBR; code++) {
+        if (code != BTN_MODE) padEvent(EV_KEY, code, 0);
+    }
+    for (int code = BTN_DPAD_UP; code <= BTN_DPAD_RIGHT; code++) padEvent(EV_KEY, code, 0);
+    for (int code : {ABS_X, ABS_Y, mRxCode, mRyCode, mLtCode, mRtCode, ABS_HAT0X, ABS_HAT0Y}) {
+        padEvent(EV_ABS, code, 0);
+    }
+    padEvent(EV_SYN, SYN_REPORT, 0);
+
+    resetInput();
+    mActive = true;
+    startTimer(true);
+    LOG(INFO) << "BrowserMode: on";
+}
+
+void BrowserMode::deactivate() {
+    releaseOutputs();
+    startTimer(false);
+    resetInput();
+    mActive = false;
+    LOG(INFO) << "BrowserMode: off";
+}
+
+void BrowserMode::inputLost() {
+    if (!mActive) return;
+    releaseOutputs();
+    for (int code : mPadDown) padEvent(EV_KEY, code, 0);
+    padEvent(EV_SYN, SYN_REPORT, 0);
+    resetInput();
+}
+
+void BrowserMode::resetInput() {
+    mRelease.clear();
+    mPadDown.clear();
+    mSelectHeld = mStartHeld = mChord = mModeHeld = false;
+    mLX = mLY = mRX = mRY = mHatX = mHatY = mDpadBtns = 0;
+    mLtBtn = mRtBtn = mLtAxis = mRtAxis = mCursorA = mCursorX = mLtBlock = mRtBlock = false;
+    mAccX = mAccY = mScrollX = mScrollY = 0;
+}
+
+void BrowserMode::releaseOutputs() {
+    if (mArrowX) mKeyboard->emitKey(mArrowX < 0 ? KEY_LEFT : KEY_RIGHT, false);
+    if (mArrowY) mKeyboard->emitKey(mArrowY < 0 ? KEY_UP : KEY_DOWN, false);
+    mArrowX = mArrowY = 0;
+    mLtBtn = mRtBtn = mLtAxis = mRtAxis = mCursorA = mCursorX = false;
+    refreshMouseButtons();
+    if (mBackDown) {
+        mMouse->buttonUp(KEY_BACK);
+        mBackDown = false;
+    }
+}
+
+void BrowserMode::startTimer(bool on) {
+    if (mTimerFd < 0) return;
+    struct itimerspec ts = {};
+    if (on) ts.it_interval.tv_nsec = ts.it_value.tv_nsec = TICK_INTERVAL_MS * 1000000L;
+    timerfd_settime(mTimerFd, 0, &ts, nullptr);
+}
+
+void BrowserMode::padEvent(int type, int code, int value) {
+    struct input_event ev = {};
+    ev.type = type;
+    ev.code = code;
+    ev.value = value;
+    mPadEvents.push_back(ev);
+}
+
+void BrowserMode::toast(const std::string& msg) {
+    if (mToast) mToast(msg);
+}
+
+bool BrowserMode::processEvent(const struct input_event& ev) {
+    if (!mActive || ev.type == EV_SYN) return false;
+
+    if (ev.type == EV_KEY) {
+        int code = ev.code;
+        bool pressed = ev.value != 0;
+        if (code == BTN_MODE || code == KEY_F10) {   // the Anbernic button (F10 on the RG Cube's pad)
+            if (ev.value != 2 && pressed != mModeHeld) {
+                if (pressed) {
+                    mModeHeld = true;
+                    if (!mChord) {
+                        mLtBlock = mLtBlock || mLtAxis;   // a trigger held from before is the hotkey's too
+                        mRtBlock = mRtBlock || mRtAxis;
+                        releaseOutputs();
+                        mSelectHeld = mStartHeld = mSelectUsed = false;   // their releases are not seen
+                    }
+                    mRelease.clear();
+                } else {
+                    mModeHeld = false;
+                    if (!mChord) {
+                        // What is still held from the hotkey stays the pad's until it is let go.
+                        mHatX = mHatY = 0;
+                        mLtBlock = mLtBlock || mLtAxis;
+                        mRtBlock = mRtBlock || mRtAxis;
+                        mLtAxis = mRtAxis = false;
+                        endChord();
+                    }
+                }
+            }
+            return false;
+        }
+        const bool padButton = (code >= BTN_A && code <= BTN_THUMBR) ||
+                               (code >= BTN_DPAD_UP && code <= BTN_DPAD_RIGHT);
+        if (!padButton) return false;   // the system's (a Back key)
+        if (ev.value == 2) return !mPadDown.count(code);
+        if (mChord || (mModeHeld && pressed) || mPadDown.count(code)) {
+            if (pressed) {
+                mPadDown.insert(code);
+            } else {
+                mPadDown.erase(code);
+            }
+            if (code >= BTN_DPAD_UP && code <= BTN_DPAD_RIGHT) {
+                trackDpadButton(code, pressed);
+                if (!mChord && !mModeHeld) refreshArrows();
+            }
+            if (mChord) {
+                if (code == BTN_SELECT) mSelectHeld = pressed;
+                if (code == BTN_START) mStartHeld = pressed;
+                if (!mSelectHeld && !mStartHeld) endChord();
+            }
+            return false;
+        }
+        onButton(code, pressed);
+        return true;
+    }
+
+    if (ev.type == EV_ABS) {
+        if (mChord || mModeHeld) {
+            trackAxis(ev.code, ev.value);
+            return false;
+        }
+        onAxis(ev.code, ev.value);
+        return true;
+    }
+
+    return !mChord;
+}
+
+// Start + Select held together reach the gamepad untouched (system hotkeys, hold to quit)
+// until both are let go.
+void BrowserMode::startChord() {
+    mChord = true;
+    mSelectHeld = mStartHeld = true;
+    releaseOutputs();
+    mRelease.clear();
+    padEvent(EV_KEY, BTN_SELECT, 1);
+    padEvent(EV_KEY, BTN_START, 1);
+    padEvent(EV_SYN, SYN_REPORT, 0);
+    mPadDown.insert(BTN_SELECT);
+    mPadDown.insert(BTN_START);
+}
+
+void BrowserMode::endChord() {
+    mChord = false;
+    for (int code : {ABS_X, ABS_Y, mRxCode, mRyCode, mLtCode, mRtCode, ABS_HAT0X, ABS_HAT0Y}) {
+        padEvent(EV_ABS, code, 0);
+    }
+    padEvent(EV_SYN, SYN_REPORT, 0);
+    refreshArrows();
+    refreshMouseButtons();
+}
+
+void BrowserMode::onButton(int code, bool pressed) {
+    if (code >= BTN_DPAD_UP && code <= BTN_DPAD_RIGHT) {
+        trackDpadButton(code, pressed);
+        refreshArrows();
+        if (mSelectHeld && (mHatX || mHatY)) mSelectUsed = true;
+        return;
+    }
+
+    if (!pressed) {
+        auto it = mRelease.find(code);
+        if (it != mRelease.end()) {
+            auto onRelease = std::move(it->second);
+            mRelease.erase(it);
+            onRelease();
+        }
+        return;
+    }
+    mRelease.erase(code);
+
+    if (code == BTN_SELECT || code == BTN_START) {
+        if (code == BTN_SELECT ? mStartHeld : mSelectHeld) {
+            startChord();
+        } else if (code == BTN_SELECT) {
+            mSelectHeld = true;
+            mSelectUsed = false;
+            refreshArrows();
+            mRelease[code] = [this] {
+                mSelectHeld = false;
+                if (!mSelectUsed) shortcut({KEY_LEFTCTRL, KEY_LEFTSHIFT, KEY_B});
+                refreshArrows();
+            };
+        } else {
+            mStartHeld = true;
+            mRelease[code] = [this] {
+                mStartHeld = false;
+                shortcut({KEY_LEFTCTRL, KEY_L});
+            };
+        }
+        return;
+    }
+
+    if (mSelectHeld) {
+        mSelectUsed = true;
+        switch (code) {
+            case BTN_TL:
+                shortcut({KEY_LEFTCTRL, KEY_W});
+                return;
+            case BTN_TR:
+                shortcut({KEY_LEFTCTRL, KEY_T});
+                return;
+            case BTN_A:
+                mCursorMode = !mCursorMode;
+                mCursorA = mCursorX = false;
+                refreshMouseButtons();
+                refreshArrows();
+                toast(mCursorMode ? "Cursor mode ON" : "Cursor mode OFF");
+                return;
+        }
+    }
+
+    switch (code) {
+        case BTN_A:
+            if (mCursorMode) {
+                mCursorA = true;
+                refreshMouseButtons();
+                mRelease[code] = [this] {
+                    mCursorA = false;
+                    refreshMouseButtons();
+                };
+            } else {
+                shortcut({KEY_ENTER});
+            }
+            break;
+        case BTN_B:
+            mMouse->buttonDown(KEY_BACK);
+            mBackDown = true;
+            mRelease[code] = [this] {
+                if (!mBackDown) return;
+                mMouse->buttonUp(KEY_BACK);
+                mBackDown = false;
+            };
+            break;
+        case BTN_X:
+            if (mCursorMode) {
+                mCursorX = true;
+                refreshMouseButtons();
+                mRelease[code] = [this] {
+                    mCursorX = false;
+                    refreshMouseButtons();
+                };
+            } else {
+                shortcut({KEY_LEFTCTRL, KEY_R});
+            }
+            break;
+        case BTN_Y:
+            shortcut({KEY_LEFTCTRL, mBookmarkKey});
+            break;
+        case BTN_TL:
+            shortcut({KEY_LEFTCTRL, KEY_LEFTSHIFT, KEY_TAB});
+            break;
+        case BTN_TR:
+            shortcut({KEY_LEFTCTRL, KEY_TAB});
+            break;
+        case BTN_TL2:
+        case BTN_TR2: {
+            bool* held = code == BTN_TL2 ? &mLtBtn : &mRtBtn;
+            *held = true;
+            refreshMouseButtons();
+            mRelease[code] = [this, held] {
+                *held = false;
+                refreshMouseButtons();
+            };
+            break;
+        }
+        case BTN_THUMBL:
+            shortcut({KEY_LEFTCTRL, KEY_W});
+            break;
+        case BTN_THUMBR:
+            shortcut({KEY_LEFTCTRL, KEY_T});
+            break;
+    }
+}
+
+void BrowserMode::trackAxis(int code, int value) {
+    if (code == ABS_X) {
+        mLX = value;
+    } else if (code == ABS_Y) {
+        mLY = value;
+    } else if (code == mRxCode) {
+        mRX = value;
+    } else if (code == mRyCode) {
+        mRY = value;
+    } else if (code == ABS_HAT0X || code == ABS_HAT0Y) {
+        int& hat = code == ABS_HAT0X ? mHatX : mHatY;
+        int dir = (value > 0) - (value < 0);
+        if (dir != hat) {
+            hat = dir;
+            mHatSince = std::chrono::steady_clock::now();
+        }
+    } else if (code == mLtCode) {
+        if (mLtBlock) mLtBlock = value >= TRIGGER_RELEASE;
+        else mLtAxis = value > (mLtAxis ? TRIGGER_RELEASE : TRIGGER_PRESS);
+    } else if (code == mRtCode) {
+        if (mRtBlock) mRtBlock = value >= TRIGGER_RELEASE;
+        else mRtAxis = value > (mRtAxis ? TRIGGER_RELEASE : TRIGGER_PRESS);
+    }
+}
+
+// Pads whose D-pad is four buttons: the hat they amount to (both of a pair held cancel out).
+void BrowserMode::trackDpadButton(int code, bool pressed) {
+    int bit = 1 << (code - BTN_DPAD_UP);
+    mDpadBtns = pressed ? (mDpadBtns | bit) : (mDpadBtns & ~bit);
+    auto held = [this](int c) { return (mDpadBtns >> (c - BTN_DPAD_UP)) & 1; };
+    trackAxis(ABS_HAT0X, held(BTN_DPAD_RIGHT) - held(BTN_DPAD_LEFT));
+    trackAxis(ABS_HAT0Y, held(BTN_DPAD_DOWN) - held(BTN_DPAD_UP));
+}
+
+void BrowserMode::onAxis(int code, int value) {
+    trackAxis(code, value);
+    if (code == ABS_HAT0X || code == ABS_HAT0Y) {
+        refreshArrows();
+    } else if (code == mLtCode || code == mRtCode) {
+        refreshMouseButtons();
+    }
+    if (mSelectHeld && (mHatX || mHatY || mLtAxis || mRtAxis)) mSelectUsed = true;
+}
+
+// The D-pad is the arrow keys (Android repeats them while held) unless Select is held (it
+// scrolls) or cursor mode is on (it moves the cursor); both of those run in tick().
+void BrowserMode::refreshArrows() {
+    bool arrows = !mSelectHeld && !mCursorMode && !mChord && !mModeHeld;
+    int x = arrows ? mHatX : 0, y = arrows ? mHatY : 0;
+    if (x != mArrowX) {
+        if (mArrowX) mKeyboard->emitKey(mArrowX < 0 ? KEY_LEFT : KEY_RIGHT, false);
+        if (x) mKeyboard->emitKey(x < 0 ? KEY_LEFT : KEY_RIGHT, true);
+        mArrowX = x;
+    }
+    if (y != mArrowY) {
+        if (mArrowY) mKeyboard->emitKey(mArrowY < 0 ? KEY_UP : KEY_DOWN, false);
+        if (y) mKeyboard->emitKey(y < 0 ? KEY_UP : KEY_DOWN, true);
+        mArrowY = y;
+    }
+}
+
+void BrowserMode::refreshMouseButtons() {
+    // R2 clicks: the same side as the right stick that moves the cursor.
+    bool left = mRtBtn || mRtAxis || mCursorA, right = mLtBtn || mLtAxis || mCursorX;
+    if (left != mLeftDown) {
+        if (left) {
+            mMouse->buttonDown(BTN_LEFT);
+        } else {
+            mMouse->buttonUp(BTN_LEFT);
+        }
+        mLeftDown = left;
+    }
+    if (right != mRightDown) {
+        if (right) {
+            mMouse->buttonDown(BTN_RIGHT);
+        } else {
+            mMouse->buttonUp(BTN_RIGHT);
+        }
+        mRightDown = right;
+    }
+}
+
+void BrowserMode::shortcut(std::initializer_list<int> keys) {
+    for (int key : keys) mKeyboard->emitKey(key, true);
+    for (auto it = std::rbegin(keys); it != std::rend(keys); ++it) mKeyboard->emitKey(*it, false);
+}
+
+void BrowserMode::tick() {
+    uint64_t expirations;
+    if (read(mTimerFd, &expirations, sizeof(expirations)) < 0) return;
+    if (!mActive || mChord || mModeHeld) return;
+
+    float dx = 0, dy = 0, sx = 0, sy = 0;
+
+    // Right stick: the cursor, on a square curve for precision near the center.
+    float fx = mRX / 32767.0f, fy = mRY / 32767.0f;
+    float mag = std::sqrt(fx * fx + fy * fy);
+    if (mag > CURSOR_DEADZONE / 32767.0f) {
+        dx += fx * mag * CURSOR_SPEED;
+        dy += fy * mag * CURSOR_SPEED;
+    }
+
+    // Left stick: the wheel, on the same curve per axis.
+    if (std::abs(mLX) > SCROLL_DEADZONE) {
+        float f = mLX / 32767.0f;
+        sx += f * std::abs(f) * SCROLL_SPEED;
+    }
+    if (std::abs(mLY) > SCROLL_DEADZONE) {
+        float f = mLY / 32767.0f;
+        sy += f * std::abs(f) * SCROLL_SPEED;
+    }
+
+    if ((mHatX || mHatY) && (mSelectHeld || mCursorMode)) {
+        float heldMs = std::chrono::duration<float, std::milli>(
+                std::chrono::steady_clock::now() - mHatSince).count();
+        float ramp = std::min(1.0f, heldMs / DPAD_RAMP_MS);
+        if (mSelectHeld) {
+            mSelectUsed = true;
+            float speed = DPAD_SCROLL_MIN + (DPAD_SCROLL_MAX - DPAD_SCROLL_MIN) * ramp;
+            sx += mHatX * speed;
+            sy += mHatY * speed;
+        } else {
+            float speed = DPAD_CURSOR_MIN + (DPAD_CURSOR_MAX - DPAD_CURSOR_MIN) * ramp;
+            dx += mHatX * speed;
+            dy += mHatY * speed;
+        }
+    }
+
+    mAccX += dx;
+    mAccY += dy;
+    int moveX = static_cast<int>(mAccX), moveY = static_cast<int>(mAccY);
+    mAccX -= moveX;
+    mAccY -= moveY;
+    if (moveX || moveY) mMouse->move(moveX, moveY);
+
+    if (sx == 0) mScrollX = 0;
+    if (sy == 0) mScrollY = 0;
+    mScrollX += sx;
+    mScrollY += sy;
+    int wheelX = static_cast<int>(mScrollX), wheelY = static_cast<int>(mScrollY);
+    mScrollX -= wheelX;
+    mScrollY -= wheelY;
+    // Down is a negative wheel step; right is negative too (as in MouseMode).
+    if (wheelX || wheelY) mMouse->scroll(-wheelY, -wheelX);
+}
+
+} // namespace gammapad
