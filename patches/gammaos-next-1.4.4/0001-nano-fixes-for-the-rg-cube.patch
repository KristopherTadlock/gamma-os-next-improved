+// Game Options: one game's options as a menu level - its own emulator, title, box art, scraping,
+// favourites, collections and information. The rows run the same actions as the XMB's game option
+// menu, on the game it was opened for.
+void NanoMenu::openGameOptions(int sysIdx, int romIdx) {
+    if (sysIdx < 0 || sysIdx >= (int)mXmbSystems.size()) return;
+    if (romIdx < 0 || romIdx >= (int)mXmbSystems[sysIdx].roms.size()) return;
+    mGameOptSys = sysIdx; mGameOptRom = romIdx; mGameOptPath = mXmbSystems[sysIdx].roms[romIdx];
+    if (!mPs3MenuBuilt) initPs3Menu();
+    mPs3Stack.clear();
+    mPs3DlgActive = false; mPs3OptActive = false; mPs3BrightSlider = false;
+    mMenuState = MENU_MAIN;
+    if (mPs3SettingsCatIdx >= 0 && mPs3SettingsCatIdx < (int)mPs3Cats.size()) mPs3CatIdx = mPs3SettingsCatIdx;
