+/*
+ * GammaOS Nano: display mode chooser for an external display.
+ *
+ * When an HDMI / USB-C display connects, Nano lists every mode SurfaceFlinger
+ * reports for it, with the display's preferred mode (the first detailed timing
+ * in its EDID) selected. The choice becomes the display's user-preferred mode
+ * in DisplayManager, which keeps it for that display and applies it again
+ * whenever the display reconnects.
+ */
+#define LOG_TAG "GammaOSNano"
+
+#include "NanoMenu.h"
+
+#include <dirent.h>
+#include <inttypes.h>
+#include <math.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <algorithm>
+#include <atomic>
+#include <string>
+#include <thread>
+#include <vector>
+#include <cutils/properties.h>
+#include <gui/SurfaceComposerClient.h>
+#include <ui/DisplayState.h>
+#include <ui/DynamicDisplayInfo.h>
+#include <ui/StaticDisplayInfo.h>
+#include <utils/Log.h>
+#include <utils/SystemClock.h>
+
+namespace android {
+
+namespace {
+
+// The physical display the chooser was last shown for; cleared once it disconnects, so the home
+// and the overlay ask once per connection.
+constexpr const char* kPromptedProp = "sys.gammaos.nano.ext_prompted";
+// 1: ask for the mode when a display connects; otherwise 1080p at 60 Hz is set without asking.
+constexpr const char* kAskProp = "persist.gammaos.nano.ext_ask";
+
+std::string readFile(const std::string& path, size_t max) {
+    std::string out;
+    FILE* f = fopen(path.c_str(), "rb");
+    if (!f) return out;
+    char buf[512];
+    size_t n;
+    while (out.size() < max && (n = fread(buf, 1, sizeof(buf), f)) > 0) out.append(buf, n);
+    fclose(f);
+    return out;
+}
+
+bool connectorConnected(const std::string& name) {
+    return (name.find("-DP-") != std::string::npos || name.find("-HDMI-") != std::string::npos) &&
+           readFile("/sys/class/drm/" + name + "/status", 32).rfind("connected", 0) == 0;
+}
+
+// The preferred timing of a connected DisplayPort or HDMI connector's EDID.
+bool edidPreferredMode(int* w, int* h, float* hz) {
+    DIR* d = opendir("/sys/class/drm");
+    if (!d) return false;
+    bool found = false;
+    while (struct dirent* e = readdir(d)) {
+        const std::string name = e->d_name;
+        if (!connectorConnected(name)) continue;
+        const std::string dir = "/sys/class/drm/" + name;
+        const std::string edid = readFile(dir + "/edid", 256);
+        static const unsigned char kHeader[8] = {0x00, 0xff, 0xff, 0xff, 0xff, 0xff, 0xff, 0x00};
+        if (edid.size() < 128 || memcmp(edid.data(), kHeader, 8) != 0) continue;
+        const unsigned char* t = reinterpret_cast<const unsigned char*>(edid.data()) + 54;
+        const int clockKhz = (t[0] | (t[1] << 8)) * 10;
+        if (clockKhz == 0) continue;   // a display descriptor, not a timing
+        const int hActive = t[2] | ((t[4] & 0xf0) << 4), hBlank = t[3] | ((t[4] & 0x0f) << 8);
+        const int vActive = t[5] | ((t[7] & 0xf0) << 4), vBlank = t[6] | ((t[7] & 0x0f) << 8);
+        if (hActive + hBlank == 0 || vActive + vBlank == 0) continue;
+        *w = hActive;
+        *h = vActive;
+        *hz = clockKhz * 1000.0f / ((hActive + hBlank) * (float)(vActive + vBlank));
+        found = true;
+        break;
+    }
+    closedir(d);
+    return found;
+}
+
+std::string shellOut(const char* command) {
+    std::string out;
+    FILE* f = popen(command, "r");
+    if (!f) return out;
+    char buf[512];
+    while (fgets(buf, sizeof(buf), f) && out.size() < 512 * 1024) out.append(buf);
+    pclose(f);
+    return out;
+}
+
+// DisplayManager's logical display id for a physical display: its DisplayInfo dump carries
+// `displayId N` and `uniqueId "local:<physical id>"`.
+int logicalDisplayId(uint64_t physicalId) {
+    const std::string out = shellOut("dumpsys display 2>/dev/null");
+    const std::string key = "uniqueId \"local:" + std::to_string(physicalId) + "\"";
+    for (size_t p = out.find(key); p != std::string::npos; p = out.find(key, p + 1)) {
+        const size_t lineStart = out.rfind('\n', p) + 1;
+        const std::string line = out.substr(lineStart, p - lineStart);
+        const size_t id = line.rfind("\", displayId ");
+        if (id != std::string::npos) return atoi(line.c_str() + id + 13);
+    }
+    return -1;
+}
+
+// The monitor kept switched on, 0 for none: keepDisplayEnabled runs while it is this display.
+std::atomic<uint64_t> sKeepEnabledFor{0};
+
+// Android keeps a newly connected external display off until the user agrees to use it, through a
+// System UI prompt Nano covers, and turns it off again as it takes each connection in (a replug or
+// a dropout included). So while the monitor is connected, a display found off is switched on; it
+// then mirrors the console (DisplayContent.setDisplayMirroring allows the display named in
+// sys.gammaos.nano.ext_mirror, set before this starts).
+void keepDisplayEnabled(uint64_t physicalId) {
+    const std::string key = "uniqueId \"local:" + std::to_string(physicalId) + "\"";
+    for (int i = 0; sKeepEnabledFor.load() == physicalId; i++) {
+        if (i) sleep(i < 20 ? 1 : 2);
+        const std::string out = shellOut("dumpsys display 2>/dev/null");
+        // A logical display's dump: mIsEnabled=..., then mBaseDisplayInfo=DisplayInfo{..., displayId N, ...
+        // uniqueId "local:<physical id>", ...}.
+        size_t at = std::string::npos;
+        for (size_t p = out.find(key); p != std::string::npos; p = out.find(key, p + 1)) {
+            const size_t lineStart = out.rfind('\n', p) + 1;
+            if (out.compare(lineStart, 16, "mBaseDisplayInfo") == 0 ||
+                out.find("mBaseDisplayInfo=", lineStart) < p) { at = p; break; }
+        }
+        if (at == std::string::npos) continue;
+        const size_t enabledAt = out.rfind("mIsEnabled=", at);
+        const size_t lineStart = out.rfind('\n', at) + 1;
+        const size_t idAt = out.substr(lineStart, at - lineStart).rfind(", displayId ");
+        if (enabledAt == std::string::npos || idAt == std::string::npos) continue;
+        if (out.compare(enabledAt + 11, 4, "true") == 0) continue;
+        const int displayId = atoi(out.c_str() + lineStart + idAt + 12);
+        char cmd[64];
+        snprintf(cmd, sizeof(cmd), "cmd display enable-display %d 2>&1", displayId);
+        const std::string result = shellOut(cmd);
+        ALOGI("external display %d: switched on%s%s", displayId, result.empty() ? "" : ": ",
+              result.c_str());
+    }
+}
+
+std::string hzLabel(float hz) {
+    char buf[16];
+    if (fabsf(hz - roundf(hz)) < 0.05f) snprintf(buf, sizeof(buf), "%d Hz", (int)lroundf(hz));
+    else snprintf(buf, sizeof(buf), "%.2f Hz", hz);
+    return buf;
+}
+
+} // namespace
+
+// A DisplayPort or HDMI monitor is connected. SurfaceFlinger calls every display but the first
+// External when the composer does not say, as a second built-in panel can be.
+bool NanoMenu::extMonitorConnected() {
+    DIR* d = opendir("/sys/class/drm");
+    if (!d) return false;
+    bool found = false;
+    while (struct dirent* e = readdir(d))
+        if (connectorConnected(e->d_name)) { found = true; break; }
+    closedir(d);
+    return found;
+}
+
+// The external display to ask about: connected, and not yet asked about this connection. 0 if none.
+uint64_t NanoMenu::extDisplayPending() {
+    // A monitor's EDID gives it product info, which a built-in panel called External lacks: first.
+    std::vector<PhysicalDisplayId> external;
+    size_t withProduct = 0;
+    if (extMonitorConnected()) for (const PhysicalDisplayId& id : SurfaceComposerClient::getPhysicalDisplayIds()) {
+        ui::StaticDisplayInfo info;
+        if (SurfaceComposerClient::getStaticDisplayInfo(id.value, &info) != NO_ERROR ||
+            info.connectionType != ui::DisplayConnectionType::External)
+            continue;
+        if (info.deviceProductInfo) external.insert(external.begin() + withProduct++, id);
+        else external.push_back(id);
+    }
+    // An adapter can drop the monitor for a moment (while it is switched on, or a mode changes):
+    // a display is gone once no external display has been seen for a few seconds, or another one
+    // took its place.
+    const int64_t now = uptimeMillis();
+    if (!external.empty()) mExtAbsentMs = 0;
+    else if (!mExtAbsentMs) mExtAbsentMs = now;
+    const bool settledGone = external.empty() && now - mExtAbsentMs > 3000;
+    auto gone = [&](uint64_t value) {
+        if (external.empty()) return settledGone;
+        return std::none_of(external.begin(), external.end(),
+                            [&](const PhysicalDisplayId& id) { return id.value == value; });
+    };
+
+    char prompted[PROPERTY_VALUE_MAX] = {0};
+    property_get(kPromptedProp, prompted, "");
+    const bool askedThisConnection = prompted[0] && !gone(strtoull(prompted, nullptr, 10));
+    if (prompted[0] && !askedThisConnection) property_set(kPromptedProp, "");
+    if (mExtRaisedFor && gone(mExtRaisedFor)) { mExtRaisedFor = 0; mExtRaisePending = false; }
+    if (mExtEnabledFor && gone(mExtEnabledFor)) {
+        mExtEnabledFor = 0;
+        sKeepEnabledFor = 0;
+        property_set("sys.gammaos.nano.ext_mirror", "");
+    }
+    // Once Android has finished booting (it turns displays off until then).
+    if (!external.empty() && external.front().value != mExtEnabledFor &&
+        property_get_bool("sys.boot_completed", false)) {
+        mExtEnabledFor = external.front().value;
+        property_set("sys.gammaos.nano.ext_mirror", ("local:" + std::to_string(mExtEnabledFor)).c_str());
+        sKeepEnabledFor = mExtEnabledFor;
+        std::thread(keepDisplayEnabled, mExtEnabledFor).detach();
+    }
+    if (mPs3DlgActive && mPs3DlgExtMode && mPs3DlgTitle == "External Display" &&
+        gone(mExtModeDisplay))
+        extModeCancel();
+    extMirrorUpdate();
+    return external.empty() || askedThisConnection ? 0 : external.front().value;
+}
+
+// WindowManager mirrors the console's windows onto the monitor, but Nano's own layer is not a
+// window, so the monitor showed the game and never Nano. Put a mirror of Nano's layer on the
+// monitor's layer stack above WindowManager's, scaled to fit and centred as WindowManager places
+// the console's screen there (ContentRecorder.updateMirroredSurface), so it lines up with the game.
+// Nano's surface is what is fitted: with External as Primary the console's screen takes the
+// monitor's size, which a Nano surface still at the panel's size does not fill.
+// The mirror does not follow its source's visibility, so it is shown and hidden with Nano's layer
+// (extMirrorShow); otherwise the menu last drawn stays over the game on the monitor.
+void NanoMenu::extMirrorShow(bool shown) {
+    mExtMirrorSourceShown = shown;
+    if (mExtMirrorRoot == nullptr) return;
+    SurfaceComposerClient::Transaction t;
+    if (shown) t.show(mExtMirrorRoot);
+    else t.hide(mExtMirrorRoot);
+    t.apply();
+}
+
+void NanoMenu::extMirrorUpdate() {
+    ui::DisplayState monitor, panel;
+    bool placed = false;
+    if (mExtEnabledFor && mFlingerSurfaceControl != nullptr && mDisplayToken != nullptr &&
+        SurfaceComposerClient::getDisplayState(mDisplayToken, &panel) == NO_ERROR) {
+        for (const PhysicalDisplayId& id : SurfaceComposerClient::getPhysicalDisplayIds()) {
+            if (id.value != mExtEnabledFor) continue;
+            const sp<IBinder> token = SurfaceComposerClient::getPhysicalDisplayToken(id);
+            placed = token != nullptr && SurfaceComposerClient::getDisplayState(token, &monitor) == NO_ERROR;
+            break;
+        }
+        placed = placed && monitor.layerStack != panel.layerStack &&
+                 monitor.layerStackSpaceRect.width > 0 && monitor.layerStackSpaceRect.height > 0 &&
+                 panel.layerStackSpaceRect.width > 0 && panel.layerStackSpaceRect.height > 0;
+    }
+    if (!placed) {
+        if (mExtMirrorRoot != nullptr) {
+            SurfaceComposerClient::Transaction().reparent(mExtMirrorRoot, nullptr).apply();
+            mExtMirrorRoot.clear();
+            mExtMirror.clear();
+        }
+        return;
+    }
+    const ui::Size in(mWidth > 0 ? mWidth : panel.layerStackSpaceRect.width,
+                      mHeight > 0 ? mHeight : panel.layerStackSpaceRect.height);
+    const ui::Size out = monitor.layerStackSpaceRect;
+    if (mExtMirrorRoot != nullptr && monitor.layerStack.id == mExtMirrorStack &&
+        out.width == mExtMirrorOut[0] && out.height == mExtMirrorOut[1] &&
+        in.width == mExtMirrorIn[0] && in.height == mExtMirrorIn[1])
+        return;
+    // SurfaceFlinger never makes a mirror a root layer (mirrorLayer: addToRoot = false), so it
+    // shows only under a parent: a container root on the monitor's layer stack.
+    if (mExtMirrorRoot == nullptr) {
+        sp<SurfaceControl> root = session()->createSurface(String8("GammaOSNano monitor"), 0, 0,
+                                                           PIXEL_FORMAT_RGBA_8888,
+                                                           ISurfaceComposerClient::eFXSurfaceContainer |
+                                                               ISurfaceComposerClient::eHidden);
+        sp<SurfaceControl> mirror = root != nullptr ? session()->mirrorSurface(mFlingerSurfaceControl.get())
+                                                    : nullptr;
+        if (mirror == nullptr) {
+            if (root != nullptr) SurfaceComposerClient::Transaction().reparent(root, nullptr).apply();
+            return;
+        }
+        SurfaceComposerClient::Transaction().reparent(mirror, root).apply();
+        mExtMirrorRoot = root;
+        mExtMirror = mirror;
+    }
+    const float scale = std::min(out.width / (float)in.width, out.height / (float)in.height);
+    const int x = (out.width - (int)lroundf(scale * in.width)) / 2;
+    const int y = (out.height - (int)lroundf(scale * in.height)) / 2;
+    SurfaceComposerClient::Transaction t;
+    t.setLayerStack(mExtMirrorRoot, monitor.layerStack)
+        .setLayer(mExtMirrorRoot, 0x40000001)
+        .setMatrix(mExtMirror, scale, 0, 0, scale)
+        .setPosition(mExtMirror, x, y)
+        .show(mExtMirror);
+    if (mExtMirrorSourceShown) t.show(mExtMirrorRoot);
+    else t.hide(mExtMirrorRoot);
+    t.apply();
+    mExtMirrorStack = monitor.layerStack.id;
+    mExtMirrorIn[0] = in.width; mExtMirrorIn[1] = in.height;
+    mExtMirrorOut[0] = out.width; mExtMirrorOut[1] = out.height;
+    ALOGI("external display: Nano mirrored at %dx%d+%d+%d", (int)lroundf(scale * in.width),
+          (int)lroundf(scale * in.height), x, y);
+}
+
+// Sets the display's mode through DisplayManager, waiting a few seconds for its logical display. Off
+// the render thread: dumpsys can take a moment.
+static void setExtMode(uint64_t physicalId, int w, int h, float hz) {
+    std::thread([physicalId, w, h, hz] {
+        int displayId = -1;
+        for (int i = 0; i < 10 && (displayId = logicalDisplayId(physicalId)) < 0; i++) sleep(1);
+        if (displayId < 0) {
+            ALOGW("external display %" PRIu64 ": no logical display, mode not set", physicalId);
+            return;
+        }
+        // DisplayManager matches the refresh rate's exact float bits; %.9g round-trips a float.
+        char cmd[160];
+        snprintf(cmd, sizeof(cmd), "cmd display set-user-preferred-display-mode %d %d %.9g %d 2>&1",
+                 w, h, (double)hz, displayId);
+        const std::string out = shellOut(cmd);
+        ALOGI("external display %d: %dx%d %.2f Hz%s%s", displayId, w, h, hz,
+              out.empty() ? "" : ": ", out.c_str());
+    }).detach();
+}
+
+// A display just connected: 1920 x 1080 at the rate nearest 60 Hz, without asking. A display
+// without 1080p keeps the mode it came up in. False while its modes are not reported yet.
+bool NanoMenu::extAutoMode(uint64_t physicalId) {
+    ui::DynamicDisplayInfo dyn;
+    if (SurfaceComposerClient::getDynamicDisplayInfoFromId(physicalId, &dyn) != NO_ERROR ||
+        dyn.supportedDisplayModes.empty())
+        return false;
+    property_set(kPromptedProp, std::to_string(physicalId).c_str());
+    const ui::DisplayMode* best = nullptr;
+    for (const ui::DisplayMode& m : dyn.supportedDisplayModes)
+        if (m.resolution.width == 1920 && m.resolution.height == 1080 &&
+            (!best || fabsf(m.peakRefreshRate - 60.0f) < fabsf(best->peakRefreshRate - 60.0f)))
+            best = &m;
+    if (!best) {
+        ALOGI("external display %" PRIu64 ": no 1920x1080 mode, keeping its own", physicalId);
+        return true;
+    }
+    setExtMode(physicalId, 1920, 1080, best->peakRefreshRate);
+    return true;
+}
+
+void NanoMenu::pollExternalDisplay() {
+    const int64_t now = uptimeMillis();
+    // NanoPauseActivity lets the game go after a minute unless asked again.
+    if (mExtPaused && now - mExtPauseMs > 30000) { pspClockFreezeApp(true); mExtPauseMs = now; }
+    // Raised over a game for a display not asked about yet: ask as soon as possible.
+    if (now - mExtPollMs < (mExtRaisePending ? 100 : 1000)) return;
+    mExtPollMs = now;
+    const uint64_t display = extDisplayPending();
+    if (!display) return;
+    if (!property_get_bool(kAskProp, false)) { extAutoMode(display); return; }
+
+    // Only over Nano's own screen, with nothing else open.
+    if (mOverlayMode && !mOverlayShown) return;
+    if (mPs3DlgActive || mPs3OptActive || mOskActive || mMpActive || mPvActive || mVidActive ||
+        mGSearchActive || mPs3TzActive || mPs3LangActive || mPs3WizActive || mOtaFlowActive ||
+        ps3TopScreenKind() == GS_ICONGRID)
+        return;   // waits for the open dialog, menu or player to close
+    if (mLaunchPending || mShowLaunchBusy || mOverlayLaunchPending ||
+        (!mOverlayMode && (mWaitForRelease || mLaunchFadeStart || mExitRequested)))
+        return;   // a launch in progress would take the chooser's buttons, or close it
+    if (ps3BootActive() || mSetupWizardActive || ndsInModal() || mPs3DlgClosing || mGpTestActive ||
+        mGpCalibActive || mGpCaptureActive || mCpActive ||
+        !(mMenuState == MENU_MAIN || (mPs3Xmb && (mMenuState == MENU_RECENT || mMenuState == MENU_APPS))) ||
+        mWifiManageActive || mPspClockOn || mPspClockReveal > 0.0f || mEsdeViewerActive ||
+        mEsdeInfoActive || mPdfActive)
+        return;   // screens that take the buttons before the chooser would
+    openExtModeChooser(display);
+}
+
+// The overlay, parked behind a game: a display connected, so open the Quick Menu over the game for
+// the chooser, which pauses the game and resumes it once it closes.
+void NanoMenu::raiseForExternalDisplay() {
+    static int64_t sLastMs = 0;
+    const int64_t now = uptimeMillis();
+    if (now - sLastMs < 1000) return;
+    sLastMs = now;
+    // First, so a monitor unplugged while nothing asked is forgotten whatever the gates below say.
+    const uint64_t display = extDisplayPending();
+    if (!property_get_bool(kAskProp, false)) {   // no chooser to raise for
+        if (display) extAutoMode(display);
+        return;
+    }
+    // When PhoneWindowManager would open the Quick Menu over the app (nanoOverApp).
+    if (!property_get_bool("sys.gammaos.nano.app_launched", false) ||
+        !property_get_bool("service.bootanim.exit", false) ||
+        property_get_bool("sys.gammaos.nano.killing", false) ||
+        property_get_bool("sys.gammaos.drastic_nano.session", false) ||
+        property_get_bool("sys.gammaos.nano.show_overlay", false))
+        return;
+    char screen[PROPERTY_VALUE_MAX] = {0};
+    property_get("sys.screen.state", screen, "on");
+    if (strcmp(screen, "off") == 0) return;   // asked once the screen is on
+    if (!display || display == mExtRaisedFor) return;   // once per connection, even if it fails
+    mExtRaisedFor = display;
+    mExtRaisePending = true;
+    property_set("sys.gammaos.nano.qs_summon", "1");
+    property_set("sys.gammaos.nano.show_overlay", "1");
+}
+
+void NanoMenu::openExtModeChooser(uint64_t physicalId) {
+    ui::DynamicDisplayInfo dyn;
+    if (SurfaceComposerClient::getDynamicDisplayInfoFromId(physicalId, &dyn) != NO_ERROR ||
+        dyn.supportedDisplayModes.empty())
+        return;   // not reported yet: the next poll tries again
+    ui::StaticDisplayInfo info;
+    std::string name;
+    if (SurfaceComposerClient::getStaticDisplayInfo(physicalId, &info) == NO_ERROR &&
+        info.deviceProductInfo)
+        name = info.deviceProductInfo->name;
+
+    mExtModes.clear();
+    int current = -1;
+    for (const ui::DisplayMode& m : dyn.supportedDisplayModes) {
+        ExtMode e{m.resolution.width, m.resolution.height, m.peakRefreshRate,
+                  m.id == dyn.activeDisplayModeId};
+        auto same = std::find_if(mExtModes.begin(), mExtModes.end(), [&](const ExtMode& o) {
+            return o.w == e.w && o.h == e.h && o.hz == e.hz;
+        });
+        if (same == mExtModes.end()) mExtModes.push_back(e);
+        else same->active |= e.active;
+    }
+    std::sort(mExtModes.begin(), mExtModes.end(), [](const ExtMode& a, const ExtMode& b) {
+        if (a.w * a.h != b.w * b.h) return a.w * a.h > b.w * b.h;
+        return a.hz > b.hz;
+    });
+    int preferred = -1;
+    int pw, ph;
+    float phz;
+    if (edidPreferredMode(&pw, &ph, &phz)) {
+        float best = 0.5f;
+        for (int i = 0; i < (int)mExtModes.size(); i++) {
+            const ExtMode& m = mExtModes[i];
+            if (m.w == pw && m.h == ph && fabsf(m.hz - phz) < best) { best = fabsf(m.hz - phz); preferred = i; }
+        }
+    }
+    for (int i = 0; i < (int)mExtModes.size(); i++)
+        if (mExtModes[i].active) current = i;
+
+    mPs3DlgOptions.clear(); mPs3DlgSwatch.clear();
+    mPs3DlgBinding = nullptr; mPs3DlgThemeKey = 0; mShaderParamEdit = -1;
+    mPs3DlgSlider = false; mPs3DlgKind = 0; mPs3DlgType = 1;   // fullscreen chooser
+    mPs3DlgIllust = 0; mPs3DlgNotice.clear();
+    mPs3DlgRomInfo = false; mPs3DlgGameInfo = false; mPs3DlgHelp = false; mPs3DlgAppInfo = false;
+    mPs3DlgDualScreen = false;
+    mPs3DlgTitle = "External Display";
+    mPs3DlgBody = (name.empty() ? std::string("An external display") : name) +
+                  " is connected.\n\nChoose its display mode.";
+    for (int i = 0; i < (int)mExtModes.size(); i++) {
+        const ExtMode& m = mExtModes[i];
+        std::string label = std::to_string(m.w) + " \xC3\x97 " + std::to_string(m.h) + ", " + hzLabel(m.hz);
+        if (i == preferred && i == current) label += " (Preferred, Current)";
+        else if (i == preferred) label += " (Preferred)";
+        else if (i == current) label += " (Current)";
+        mPs3DlgOptions.push_back(label);
+    }
+    mPs3DlgSel = preferred >= 0 ? preferred : (current >= 0 ? current : 0);
+    mPs3DlgOrigSel = mPs3DlgSel;
+    mPs3DlgIconTex = 0; mPs3DlgIconNmap = nmapForIcon(16);   // external-display glyph
+    mPs3DlgIconR = mPs3DlgIconG = mPs3DlgIconB = 1.0f;
+    mPs3DlgExtMode = true; mExtModeDisplay = physicalId;
+    mExtResume = mExtRaisePending && mExtRaisedFor == physicalId;
+    mExtRaisePending = false;
+    // Over a game: pause it through its own lifecycle (blocking its input does not stop it).
+    if (mExtResume && !mExtPaused) { pspClockFreezeApp(true); mExtPaused = true; mExtPauseMs = uptimeMillis(); }
+    property_set(kPromptedProp, std::to_string(physicalId).c_str());
+    mPs3DlgActive = true; mPs3DlgAnim = 0.0f; mPs3DlgBlurValid = false;
+    mDisplayDirty = true;
+}
+
+void NanoMenu::extModeAccept() {
+    const int sel = mPs3DlgSel;
+    const uint64_t physicalId = mExtModeDisplay;
+    extModeCancel();
+    if (sel < 0 || sel >= (int)mExtModes.size()) return;
+    const ExtMode m = mExtModes[sel];
+    setExtMode(physicalId, m.w, m.h, m.hz);
+}
+
+void NanoMenu::extModeCancel() {
+    mPs3DlgExtMode = false;
+    mPs3DlgActive = false; mPs3DlgBlurValid = false;
+    mDisplayDirty = true;
+    extReleasePause();
+    if (mExtResume) {   // raised over a game for the chooser: back to the game
+        mExtResume = false;
+        mQsReturn = QsReturn();
+        overlayResume();
+    }
+}
+
+// Lets the game go again if the chooser paused it.
+void NanoMenu::extReleasePause() {
+    if (!mExtPaused) return;
+    mExtPaused = false;
+    pspClockFreezeApp(false);
+}
+
