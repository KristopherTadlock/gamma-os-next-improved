+// Whether a connector is DisplayPort or HDMI, and the encoder driving it. Asks for one mode so the
+// kernel does not probe the connector (an EDID read) as it does when asked for none.
+static bool drmConnectorExternal(int fd, uint32_t connId, uint32_t* encoderId) {
+    struct drm_mode_modeinfo mode;
+    struct drm_mode_get_connector conn = {};
+    conn.connector_id = connId;
+    conn.count_modes = 1;
+    conn.modes_ptr = (uint64_t)(uintptr_t)&mode;
+    if (ioctl(fd, DRM_IOCTL_MODE_GETCONNECTOR, &conn) != 0) return false;
+    if (encoderId) *encoderId = conn.encoder_id;
+    return conn.connector_type == DRM_MODE_CONNECTOR_DisplayPort ||
+           conn.connector_type == DRM_MODE_CONNECTOR_HDMIA ||
+           conn.connector_type == DRM_MODE_CONNECTOR_HDMIB;
