+// Game Options > Emulator: the system's own emulator, then the catalog's emulators for this game's
+// platform (or, when the catalog has none filed under it, every emulator).
+void NanoMenu::openGameEmulatorPicker(int sysIdx, const std::string& romPath) {
+    if (sysIdx < 0 || sysIdx >= (int)mXmbSystems.size()) return;
+    loadEmuCatalog();
+    mGameEmuRom = romPath;
+    const XmbSystem& sys = mXmbSystems[sysIdx];
+    const GameEmulator* cur = gameEmulatorFor(romPath);
+    Ps3Level lvl; lvl.title = "Emulator for This Game"; lvl.sel = 0;
+    auto row = [&](const std::string& label, int catIdx, bool active) {
+        Ps3Item it; it.label = label; it.kind = PS3_QUICK; it.a = QA_GAME_EMU_SET; it.b = catIdx;
+        if (active) { it.value = "Active"; lvl.sel = (int)lvl.items.size(); }
+        it.iconTex = iconTexForIcon(22); it.nmapTex = nmapForIcon(22); it.iconR = it.iconG = it.iconB = 1.0f;
+        lvl.items.push_back(it);
+    };
+    std::string sysEmu = sys.launchType == XLT_CUSTOM_PACKAGE ? sys.packageName : sys.coreSo;
+    row(sysEmu.empty() ? std::string("System Default") : "System Default (" + sysEmu + ")", -1, cur == nullptr);
+    const std::string filter = sys.shortname.empty() ? sys.name : sys.shortname;
+    std::vector<int> picks;
+    for (int i = 0; i < (int)mEmuCatalog.size(); i++)
+        if (!sys.romDir.empty() && !strcasecmp(mEmuCatalog[i].platformId.c_str(), sys.romDir.c_str())) picks.push_back(i);
+    const bool byPlatform = !picks.empty();
+    if (!byPlatform)
+        for (int i = 0; i < (int)mEmuCatalog.size(); i++)
+            if (strcasestr(mEmuCatalog[i].platform.c_str(), filter.c_str())) picks.push_back(i);
+    if (picks.empty()) for (int i = 0; i < (int)mEmuCatalog.size(); i++) picks.push_back(i);
+    for (int i : picks) {
+        const EmuCatEntry& e = mEmuCatalog[i];
+        row(byPlatform ? e.player : e.platform + " - " + e.player, i, cur && cur->amArgs == e.amArgs);
+    }
+    mPs3Stack.push_back(lvl);
+    mDisplayDirty = true;
+}
