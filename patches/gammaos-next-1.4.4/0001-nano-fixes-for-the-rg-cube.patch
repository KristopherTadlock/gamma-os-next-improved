+    const auto& sys = mXmbSystems[s];
+    if (mEsdeGameSel < 0 || mEsdeGameSel >= (int)sys.roms.size()) return;
+    const std::string rom = sys.roms[mEsdeGameSel];
+    const ScrapeEntry* meta = esdeMetaFor(rom);
+    const bool metaFav = meta && meta->favorite;
+    auto un = std::find(mEsdeUnfavorites.begin(), mEsdeUnfavorites.end(), rom);
+    if (esdeIsFavorite(rom, meta)) {
+        if (isFavorite(rom)) toggleFavorite(rom);
+        if (metaFav && un == mEsdeUnfavorites.end()) { mEsdeUnfavorites.push_back(rom); saveFavorites(); }
+    } else {
+        if (un != mEsdeUnfavorites.end()) { mEsdeUnfavorites.erase(un); saveFavorites(); }
+        if (!metaFav) toggleFavorite(rom);
+    }
+    esdeSfx(5);                                // favorite
+    mDisplayDirty = true;
+}
+
+// The gamelist's X VIEW MEDIA help prompt: nano has no ES-DE media viewer, so open the focused
+// game's Information page (cover, fanart and scraped metadata) instead.
+void NanoMenu::esdeOpenGameInfo() {
+    int s;
+    if (!esdeFocusedSystem(s)) return;
+    const auto& sys = mXmbSystems[s];
+    if (mEsdeGameSel < 0 || mEsdeGameSel >= (int)sys.roms.size()) return;
+    mPs3OptCtxKind = PS3_ROM; mPs3OptCtxA = s; mPs3OptCtxB = mEsdeGameSel;
+    mPs3OptCtxLabel = mEsdeGameSel < (int)sys.displayNames.size() ? sys.displayNames[mEsdeGameSel] : std::string();
+    mPs3OptCtxPayload.clear(); mPs3OptCtxDesc.clear();
+    mPs3OptCtxList.clear(); mPs3OptCtxSel = 0;
+    mRomInfoEsdeMeta = true;   // the gamelist's own metadata, not only nano's scrapes
+    xmbOptAction("rominfo");
+    mRomInfoEsdeMeta = false;
+}
+
+// The gamelist's L/R SYSTEM help prompt (QuickSystemSelect=leftrightshoulders): the shoulders
+// switch to the previous or next system and stay in the gamelist, whatever its primary.
+void NanoMenu::esdeQuickSystemSelect(int dir) {
+    int s;
+    if (!esdeFocusedSystem(s)) return;
+    const int nSys = (int)mEsdeSysList.size();
+    mEsdeSysSel = ((mEsdeSysSel + dir) % nSys + nSys) % nSys;
+    mEsdeGameSel = 0;
+    mEsdeGridCursor = -1; mEsdeGridScroll = 0.0f; mEsdeGridAnimDur = 0.0f; mEsdeGridTransFactor = 1.0f;
+    esdeSfx(1);                                // quicksysselect
+    mDisplayDirty = true;
+}
+
+// The triggers jump to the first or last game, as in ES-DE's gamelists.
+void NanoMenu::esdeJumpToEdge(int dir) {
+    int s;
+    if (!esdeFocusedSystem(s)) return;
+    const int n = (int)mXmbSystems[s].roms.size();
+    if (n <= 0) return;
+    const int sel = dir < 0 ? 0 : n - 1;
+    if (sel != mEsdeGameSel) { mEsdeGameSel = sel; esdeSfx(4); }   // scroll
+    mDisplayDirty = true;
+}
+
+// The gamelist's thumbstick-click RANDOM help prompt: focus a random game, without launching it.
+void NanoMenu::esdeRandomGame() {
+    int s;
+    if (!esdeFocusedSystem(s)) return;
+    const int n = (int)mXmbSystems[s].roms.size();
+    if (n < 2) return;
+    int sel = rand() % (n - 1);
+    if (sel >= mEsdeGameSel) sel++;            // never the game already focused
+    mEsdeGameSel = sel;
+    esdeSfx(4);                                // scroll
+    mDisplayDirty = true;
+}
