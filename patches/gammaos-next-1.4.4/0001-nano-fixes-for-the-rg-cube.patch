+// Anbernic + a button: drastic-nano's own quick save / load (slot 0), fast forward and exit.
+// It has no rewind.
+void hotkey(InputState* st, int code, InputActions* out) {
+    if (code == hotkeyButton("save", BTN_TR)) out->actQuickSave = true;
+    else if (code == hotkeyButton("load", BTN_TL)) out->actQuickLoad = true;
+    else if (code == hotkeyButton("fastforward", BTN_TR2)) st->ffToggled = !st->ffToggled;
+    else if (code == hotkeyButton("quit", BTN_START)) {
+        if (property_get_bool("persist.gammaos.hotkeys.quithold", true))
+            st->quitHoldStartMs = android::elapsedRealtime();
+        else
+            out->exitRequested = true;
+    } else {
+        return;
+    }
+    ALOGI("DrasticNano::input: hotkey for button %d", code);
+}
