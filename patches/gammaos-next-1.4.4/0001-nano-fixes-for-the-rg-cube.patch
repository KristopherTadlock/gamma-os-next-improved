+package com.android.server.policy;
+
+import android.content.ComponentName;
+import android.content.Context;
+import android.content.Intent;
+import android.hardware.input.InputManager;
+import android.os.Handler;
+import android.os.SystemClock;
+import android.os.UserHandle;
+import android.util.Slog;
+import android.view.InputDevice;
+import android.view.KeyCharacterMap;
+import android.view.KeyEvent;
+
+import org.json.JSONArray;
+import org.json.JSONObject;
+
+import java.io.File;
+import java.net.DatagramPacket;
+import java.net.DatagramSocket;
+import java.net.InetAddress;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.util.HashMap;
+import java.util.Iterator;
+import java.util.Map;
+import java.util.Objects;
+
+/**
+ * GammaOS Nano universal hotkeys: Anbernic + a button does the same thing in every emulator.
+ *
+ * Each emulator has a JSON profile naming, per action, the driver that does it there (a keyboard key
+ * the emulator binds, a RetroArch network command, the system exit, ...). Built-in profiles are in
+ * /system/etc/gammaos/hotkeys; a file in /data/system/gammaos/hotkeys with the same id replaces one,
+ * and a new file adds an emulator. HOTKEYS.md in the project describes the format. Runs on the
+ * policy handler.
+ */
+final class GammaHotkeyController {
+    private static final String TAG = "GammaHotkeys";
+
+    static final String SAVE_STATE = "save_state";
+    static final String LOAD_STATE = "load_state";
+    static final String FAST_FORWARD = "fast_forward";
+    static final String REWIND = "rewind";
+    static final String QUIT = "quit";
+
+    private static final String[] DIRS = {"/system/etc/gammaos/hotkeys", "/data/system/gammaos/hotkeys"};
+
+    interface Host {
+        String foregroundPackage();
+        /** The long-press-Back exit: the emulator saves and closes, or is stopped, and nano returns. */
+        void exitApp();
+        /** Stops the app and returns to nano. */
+        void forceStopApp(String pkg);
+    }
+
+    private final Context mContext;
+    private final Handler mHandler;
+    private final Host mHost;
+
+    private final Map<String, JSONObject> mByPackage = new HashMap<>();
+    private JSONObject mFallback;
+    private String mLoadedStamp;
+
+    // Toggles of the app in front; reset when another app comes to the front.
+    private String mStatePkg;
+    private final Map<String, Boolean> mToggles = new HashMap<>();
+    private volatile int mHeldKey;   // a key_hold key that is down, or 0
+    private String mHeldAction;
+
+    GammaHotkeyController(Context context, Handler handler, Host host) {
+        mContext = context;
+        mHandler = handler;
+        mHost = host;
+    }
+
+    /** A key is being held down for a toggle. Safe from any thread. */
+    boolean isHolding() {
+        return mHeldKey != 0;
+    }
+
+    /** Lets go of a held key: on the overlay, quit, app exit and sleep. */
+    void reset() {
+        final int key = mHeldKey;
+        if (key == 0) return;
+        mHeldKey = 0;
+        if (mHeldAction != null) mToggles.put(mHeldAction, false);
+        mHeldAction = null;
+        injectKey(key, 0, false);
+    }
+
+    void onAction(String action) {
+        final String pkg = mHost.foregroundPackage();
+        if (!Objects.equals(pkg, mStatePkg)) {
+            reset();
+            mToggles.clear();
+            mStatePkg = pkg;
+        }
+        if (QUIT.equals(action)) reset();
+        loadProfiles();
+        JSONObject profile = pkg != null ? mByPackage.get(pkg) : null;
+        if (profile == null) profile = mFallback;
+        JSONObject spec = actionSpec(profile, action);
+        if (spec == null && profile != mFallback) spec = actionSpec(mFallback, action);
+        if (spec == null && QUIT.equals(action)) spec = new JSONObject();   // driver "exit"
+        if (spec == null) {
+            Slog.i(TAG, action + ": not available in " + pkg);
+            return;
+        }
+        Slog.i(TAG, action + " -> " + pkg + " (" + (profile != null ? profile.optString("id") : "-")
+                + ", " + spec.optString("driver", "exit") + ")");
+        run(spec, action, pkg);
+    }
+
+    private static JSONObject actionSpec(JSONObject profile, String action) {
+        if (profile == null) return null;
+        final JSONObject actions = profile.optJSONObject("actions");
+        return actions != null ? actions.optJSONObject(action) : null;
+    }
+
+    private void run(JSONObject spec, String action, String pkg) {
+        final String driver = spec.optString("driver", "exit");
+        switch (driver) {
+            case "key":
+                tap(keyCode(spec.optString("key")), metaState(spec.optJSONArray("mods")));
+                break;
+            case "key_toggle":
+                tap(keyCode(spec.optString("key")), metaState(spec.optJSONArray("mods")));
+                mToggles.put(action, !mToggles.getOrDefault(action, false));
+                break;
+            case "key_hold": {
+                final int key = keyCode(spec.optString("key"));
+                if (key == KeyEvent.KEYCODE_UNKNOWN) break;
+                final boolean on = action.equals(mHeldAction);
+                reset();
+                if (!on) {
+                    mHeldKey = key;
+                    mHeldAction = action;
+                    mToggles.put(action, true);
+                    injectKey(key, 0, true);
+                }
+                break;
+            }
+            case "retroarch_cmd":
+                retroarchCommand(spec.optString("command"), spec.optInt("port", 55355));
+                break;
+            case "intent":
+                sendIntent(spec);
+                break;
+            case "exit":
+                reset();
+                mHost.exitApp();
+                break;
+            case "force_stop":
+                reset();
+                if (pkg != null) mHost.forceStopApp(pkg);
+                break;
+            case "none":
+                Slog.i(TAG, action + ": not available in " + pkg);
+                return;
+            default:
+                Slog.w(TAG, "unknown driver " + driver);
+                return;
+        }
+        // A graceful quit that did not close the app within timeout_ms falls back to "then".
+        final String then = spec.optString("then", "");
+        if (!then.isEmpty() && pkg != null) {
+            final JSONObject next = new JSONObject();
+            try {
+                next.put("driver", then);
+            } catch (Exception ignore) {
+            }
+            mHandler.postDelayed(() -> {
+                if (pkg.equals(mHost.foregroundPackage())) run(next, action, pkg);
+            }, spec.optInt("timeout_ms", 3000));
+        }
+    }
+
+    // Reads the profiles again when a file in either folder changed.
+    private void loadProfiles() {
+        final StringBuilder stamp = new StringBuilder();
+        final File[][] lists = new File[DIRS.length][];
+        for (int d = 0; d < DIRS.length; d++) {
+            lists[d] = new File(DIRS[d]).listFiles((dir, name) -> name.endsWith(".json"));
+            if (lists[d] == null) continue;
+            for (File f : lists[d]) {
+                stamp.append(f.getPath()).append(':').append(f.lastModified()).append(':')
+                        .append(f.length()).append(';');
+            }
+        }
+        if (stamp.toString().equals(mLoadedStamp)) return;
+        mLoadedStamp = stamp.toString();
+        final Map<String, JSONObject> byId = new HashMap<>();
+        for (File[] list : lists) {
+            if (list == null) continue;
+            for (File f : list) {
+                try {
+                    final JSONObject p = new JSONObject(
+                            new String(Files.readAllBytes(f.toPath()), StandardCharsets.UTF_8));
+                    byId.put(p.optString("id", f.getName()), p);
+                } catch (Exception e) {
+                    Slog.w(TAG, "bad profile " + f + ": " + e.getMessage());
+                }
+            }
+        }
+        mByPackage.clear();
+        mFallback = null;
+        for (JSONObject p : byId.values()) {
+            final JSONArray pkgs = p.optJSONArray("packages");
+            if (pkgs == null) continue;
+            for (int i = 0; i < pkgs.length(); i++) {
+                final String pkg = pkgs.optString(i);
+                if ("*".equals(pkg)) mFallback = p;
+                else if (!pkg.isEmpty()) mByPackage.put(pkg, p);
+            }
+        }
+        Slog.i(TAG, "loaded " + byId.size() + " profiles");
+    }
+
+    private static int keyCode(String name) {
+        if (name == null || name.isEmpty()) return KeyEvent.KEYCODE_UNKNOWN;
+        return KeyEvent.keyCodeFromString(name.startsWith("KEYCODE_") ? name : "KEYCODE_" + name);
+    }
+
+    private static int metaState(JSONArray mods) {
+        int meta = 0;
+        if (mods == null) return meta;
+        for (int i = 0; i < mods.length(); i++) {
+            switch (mods.optString(i)) {
+                case "CTRL": meta |= KeyEvent.META_CTRL_ON | KeyEvent.META_CTRL_LEFT_ON; break;
+                case "SHIFT": meta |= KeyEvent.META_SHIFT_ON | KeyEvent.META_SHIFT_LEFT_ON; break;
+                case "ALT": meta |= KeyEvent.META_ALT_ON | KeyEvent.META_ALT_LEFT_ON; break;
+                default: break;
+            }
+        }
+        return meta;
+    }
+
+    private void tap(int key, int meta) {
+        if (key == KeyEvent.KEYCODE_UNKNOWN) return;
+        final int[] mods = {KeyEvent.KEYCODE_CTRL_LEFT, KeyEvent.KEYCODE_SHIFT_LEFT,
+                KeyEvent.KEYCODE_ALT_LEFT};
+        final int[] bits = {KeyEvent.META_CTRL_ON, KeyEvent.META_SHIFT_ON, KeyEvent.META_ALT_ON};
+        for (int i = 0; i < mods.length; i++) if ((meta & bits[i]) != 0) injectKey(mods[i], meta, true);
+        injectKey(key, meta, true);
+        injectKey(key, meta, false);
+        for (int i = mods.length - 1; i >= 0; i--) {
+            if ((meta & bits[i]) != 0) injectKey(mods[i], 0, false);
+        }
+    }
+
+    private static void injectKey(int key, int meta, boolean down) {
+        final long now = SystemClock.uptimeMillis();
+        final KeyEvent ev = new KeyEvent(now, now, down ? KeyEvent.ACTION_DOWN : KeyEvent.ACTION_UP,
+                key, 0, meta, KeyCharacterMap.VIRTUAL_KEYBOARD, 0, KeyEvent.FLAG_FROM_SYSTEM,
+                InputDevice.SOURCE_KEYBOARD);
+        InputManager.getInstance().injectInputEvent(ev, InputManager.INJECT_INPUT_EVENT_MODE_ASYNC);
+    }
+
+    private static void retroarchCommand(String command, int port) {
+        if (command == null || command.isEmpty()) return;
+        new Thread(() -> {
+            try (DatagramSocket s = new DatagramSocket()) {
+                final byte[] b = command.getBytes(StandardCharsets.US_ASCII);
+                s.send(new DatagramPacket(b, b.length, InetAddress.getLoopbackAddress(), port));
+            } catch (Exception e) {
+                Slog.w(TAG, "RetroArch command " + command + ": " + e.getMessage());
+            }
+        }, "GammaHotkeyCmd").start();
+    }
+
+    // {"driver": "intent", "action": ..., "package": ..., "class": ..., "extras": {...},
+    //  "broadcast": true}
+    private void sendIntent(JSONObject spec) {
+        final Intent intent = new Intent();
+        if (!spec.optString("action").isEmpty()) intent.setAction(spec.optString("action"));
+        final String pkg = spec.optString("package");
+        final String cls = spec.optString("class");
+        if (!pkg.isEmpty() && !cls.isEmpty()) intent.setComponent(new ComponentName(pkg, cls));
+        else if (!pkg.isEmpty()) intent.setPackage(pkg);
+        final JSONObject extras = spec.optJSONObject("extras");
+        if (extras != null) {
+            for (Iterator<String> it = extras.keys(); it.hasNext(); ) {
+                final String k = it.next();
+                final Object v = extras.opt(k);
+                if (v instanceof Boolean) intent.putExtra(k, (Boolean) v);
+                else if (v instanceof Integer) intent.putExtra(k, (Integer) v);
+                else intent.putExtra(k, String.valueOf(v));
+            }
+        }
+        try {
+            if (spec.optBoolean("broadcast", true)) {
+                mContext.sendBroadcastAsUser(intent, UserHandle.CURRENT);
+            } else {
+                intent.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK);
+                mContext.startActivityAsUser(intent, UserHandle.CURRENT);
+            }
+        } catch (Exception e) {
+            Slog.w(TAG, "intent: " + e.getMessage());
+        }
+    }
+}
