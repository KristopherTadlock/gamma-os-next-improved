+// Wi-Fi signal icons, one per bar count (0..4): the familiar 90-degree fan of four bands rising from
+// a point at the bottom, the lit bands solid and the rest faint. Supersampled like the heart.
+void NanoMenu::ensureWifiIcons() {
+    if (mWifiIconTex[0]) return;
+    const int N = 128, SS = 3;
+    const float cx = N * 0.5f, cy = N * 0.86f, R = N * 0.74f, band = R / 4.0f, gap = band * 0.3f;
+    for (int bars = 0; bars <= 4; bars++) {
+        std::vector<uint8_t> px((size_t)N * N * 4, 0);
+        for (int iy = 0; iy < N; iy++) {
+            for (int ix = 0; ix < N; ix++) {
+                int lit = 0, dim = 0;
+                for (int sy = 0; sy < SS; sy++) {
+                    for (int sx = 0; sx < SS; sx++) {
+                        float dx = ix + (sx + 0.5f) / SS - cx, dy = cy - (iy + (sy + 0.5f) / SS);
+                        if (dy <= 0.0f || fabsf(dx) > dy) continue;   // outside the 90-degree fan
+                        float r = sqrtf(dx * dx + dy * dy);
+                        if (r > R) continue;
+                        int k = (int)(r / band);
+                        if (k > 3) k = 3;
+                        if (k > 0 && r - k * band < gap) continue;     // the gap below each arc
+                        if (k < bars) lit++; else dim++;
+                    }
+                }
+                int a = (lit * 255 + dim * 70) / (SS * SS);
+                if (a > 0) {
+                    size_t o = (size_t)(iy * N + ix) * 4;
+                    px[o + 0] = 255; px[o + 1] = 255; px[o + 2] = 255; px[o + 3] = (uint8_t)a;
+                }
+            }
+        }
+        mWifiIconTex[bars] = uploadRGBA(px.data(), N, N);
+        mWifiNmapTex[bars] = bevelFromRGBA(px.data(), N, N);
+    }
+}
