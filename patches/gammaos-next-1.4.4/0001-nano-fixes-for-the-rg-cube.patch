+    std::vector<uint32_t> conns, crtcs;
+    if (!drmResources(fd, &conns, &crtcs)) return 0;
+    for (uint32_t connId : conns) {
+        uint32_t encoderId = 0;
+        const bool ext = drmConnectorExternal(fd, connId, &encoderId);
+        if (encoderId == 0) continue;
+        struct drm_mode_get_encoder enc = {};
+        enc.encoder_id = encoderId;
+        if (ioctl(fd, DRM_IOCTL_MODE_GETENCODER, &enc) == 0 && enc.crtc_id == crtcId) {
