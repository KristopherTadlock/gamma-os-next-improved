+#pragma once
+
+#include <SkImage.h>
+#include <SkMatrix.h>
+#include <SkRect.h>
+#include <SkShader.h>
+#include <renderengine/GammaSurfaceFilter.h>
+
+#include <optional>
+
+namespace android {
+namespace renderengine {
+namespace skia {
+
+// GammaOS 4:3 Cropped and 8:7 Cropped: samples a layer's buffer through its projection
+// (gammaCropProjection) with a sharp bilinear kernel, directly while the layer is drawn.
+struct GammaSurfaceScaler {
+    struct Result {
+        // Expects logical display coordinates as its local coordinates.
+        sk_sp<SkShader> shader;
+        // The visible picture in logical display coordinates.
+        SkRect dstRect;
+    };
+
+    // layerToTexel maps coordinates relative to the layer bounds' top-left corner to image
+    // texels, as the regular layer draw does. None when the picture is drawn unmodified.
+    static std::optional<Result> make(const sk_sp<SkImage>& image, const SkMatrix& layerToTexel,
+                                      SkSize layerSize, const SkRect& displayClip,
+                                      GammaCrop crop);
+};
+
+} // namespace skia
+} // namespace renderengine
+} // namespace android
