+    if (epoch <= 0) return false;
+    char cmd[96];
+    snprintf(cmd, sizeof(cmd), "cmd alarm set-time %lld 2>/dev/null", (long long)epoch * 1000LL);
+    return system(cmd) == 0;
+}
