+void NanoMenu::buildGpHotkeySupport(Ps3Level& out) {
+    out.items.clear(); out.sel = 0; out.title = "Emulator Support"; out.screenKind = 0;
+    static const struct { const char* key; const char* label; } kActions[] = {
+        {"save_state", "Save"}, {"load_state", "Load"}, {"fast_forward", "Fast Forward"},
+        {"rewind", "Rewind"}, {"quit", "Quit"},
+    };
+    for (const auto& p : nanohotkeys::loadProfiles()) {
+        const njson::Value* acts = p.json.find("actions");
+        std::string yes, no;
+        for (const auto& a : kActions) {
+            const njson::Value* spec = acts ? acts->find(a.key) : nullptr;
+            const bool ok = !strcmp(a.key, "quit") || (spec && spec->getString("driver") != "none");
+            std::string& list = ok ? yes : no;
+            if (!list.empty()) list += ", ";
+            list += trDyn(a.label);
+        }
+        gpAct(out, p.name.c_str(), QA_GP_HOTKEY_INFO, 74, nullptr);
+        Ps3Item& it = out.items.back();
+        it.desc = no.empty() ? ps3Fmt(trDyn("Works: %s."), yes.c_str())
+                             : ps3Fmt(trDyn("Works: %s. Not available: %s."), yes.c_str(), no.c_str());
+        const std::string note = p.json.getString("note");
+        if (!note.empty()) it.desc += " " + note;
+    }
+}
+
+// Two hotkeys cannot share a button: the one that had the button takes this one's old button.
+void NanoMenu::hotkeyTakeButton(const Ps3SettingBinding* b, const std::string& v) {
+    static const char* const kRows[] = {"Save State Button", "Load State Button", "Fast Forward Button",
+                                        "Rewind Button", "Quit Game Button"};
+    if (std::find_if(std::begin(kRows), std::end(kRows), [&](const char* r) { return !strcmp(r, b->label); })
+        == std::end(kRows) || v == "NONE") return;
+    const std::string mine = readSettingValue(b->source, b->key, b->def);
+    for (const char* r : kRows) {
+        const Ps3SettingBinding* o = ps3BindingFor(r);
+        if (!o || o == b || readSettingValue(o->source, o->key, o->def) != v) continue;
+        writeSettingValue(o->source, o->key, mine);
+        mPs3BindCache.erase(o->label);
+    }
+}
