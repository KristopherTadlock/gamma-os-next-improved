-    <string name="title_launch_guard">GammaOS Launch Guard</string>
+    <string name="title_launch_guard">Thimsy Launch Guard</string>
     <string name="launch_guard_toggle_label">Launch Guard\'ı etkinleştir</string>
     <string name="launch_guard_toggle_summary">Etkinleştirildiğinde, seçili çağıran uygulamalardan başlatıldığında sistem seçili hedef uygulamaları zorla durduracaktır. Bu, bir uygulama hâlâ çalışırken yeniden başlatıldığında oluşan emülatör çökmelerini çözebilir.</string>
     <string name="callers_section_title">Çağıran uygulamalar</string>
diff --git a/packages/apps/LaunchGuardControl/res/values-uk/strings.xml b/packages/apps/LaunchGuardControl/res/values-uk/strings.xml
