+
+// A drag along the primary's axis moves it one entry per pitch; in the system view, one system a
+// swipe, with no flick.
+void NanoMenu::esdeTouchListZone(const TouchRect& area, bool games, int axis, float pitch) {
+    if (pitch < 1.0f) pitch = std::min(mWidth, mHeight) * 0.2f;   // a wheel carousel has no straight pitch
