+// Zone actions are not handed the touch position, so the seek bar reads where the finger is: on the
+// release for a tap, at each step for a drag (a small pitch keeps it following the finger).
+void NanoMenu::touchSeekBarZone(const TouchRect& bar, std::function<void(float)> seek) {
+    if (bar.w <= 1.0f) return;
+    const float unit = (float)std::min(mWidth, mHeight);
+    const TouchRect r = bar.grownTo(bar.w + unit * 0.04f, unit * 0.09f);
+    auto at = [this, bar, seek]() {
+        float px, py;
+        if (!touchLogicalPx(px, py)) return;
+        seek(std::max(0.0f, std::min(1.0f, (px - bar.x) / bar.w)));
+    };
+    mTouch.scroll(r, TouchZones::kAcross, std::max(1.0f, bar.w / 256.0f), [this, at](int) {
+        if (!mTouch.tracking()) return false;   // let go: the bar does not fling
+        at();
+        return true;
+    });
+    mTouch.tap(r, at);
+}
