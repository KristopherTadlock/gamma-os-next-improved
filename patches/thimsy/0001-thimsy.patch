+        }
+    }
+    {
+        std::lock_guard<std::mutex> lk(mStreamM);
+        mPcm.swap(out);
+        mRate = rate;
+        for (int v = 0; v < kVoices; v++) { mVoiceOn[v].store(false); mVoicePos[v].store(0); }
+    }
+    mLoaded.store(true);
+    ALOGI("NanoSfx: loaded %s (%dHz %dch, %zu frames of it, master %.2f)", path.c_str(), rate, ch, frames, master);
+    return true;
+}
+
+bool NanoSfxPlayer::prepare() {
+    if (!mLoaded.load() || mShutdown.load()) return false;
+    std::lock_guard<std::mutex> lk(mStreamM);
+    return openStreamLocked();
+}
