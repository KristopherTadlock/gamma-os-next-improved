+// A Quick Menu action row (PS3_QUICK, dispatched by its QA_ code).
+NanoMenu::Ps3Item NanoMenu::quickActionItem(const char* label, int action, int icon) {
+    Ps3Item it; it.label = label; it.kind = PS3_QUICK; it.a = action;
+    // The flat mono icon too (as makeDataItem sets), so the DSi carousel draws these flat like
+    // every other row; the XMB keeps the glass nmap.
+    it.iconTex = iconTexForIcon(icon); it.nmapTex = nmapForIcon(icon);
+    it.iconR = it.iconG = it.iconB = 1.0f;
+    return it;
+}
+
+// A Quick Menu settings row bound to a kPs3Bindings entry (A opens its chooser), named after the
+// GammaOS Quick Settings tile that drives the same setting. A tile the device blacklists for
+// Android's shade (persist.gammaos.qs.blacklist) is left out here too.
+void NanoMenu::quickLeafItem(std::vector<Ps3Item>& out, const char* label, const char* bindLabel,
+                             int icon, const char* spec, const char* desc) {
+    if (qsTileHidden(spec)) return;
+    Ps3Item it; it.label = label; it.kind = PS3_DATA_LEAF; it.action = 1;
+    it.binding = ps3BindingFor(bindLabel ? bindLabel : label);
+    if (it.binding) it.value = resolvePs3ItemValue(it);
+    if (desc) it.desc = desc;
+    it.iconTex = iconTexForIcon(icon); it.nmapTex = nmapForIcon(icon);
+    it.iconR = it.iconG = it.iconB = 1.0f;
+    out.push_back(it);
+}
+
+// The Quick Menu's rows. Kiosk Mode is the last row, or the first while it is on.
+void NanoMenu::buildQuickMenuItems(std::vector<Ps3Item>& out) {
+    out.clear();
+    static const char* kKioskDesc =
+        "Start opens Applications instead of the ES-DE menu, and Select does nothing in a game list.";
+    const bool kiosk = kioskMode();
+    if (kiosk) quickLeafItem(out, "Kiosk Mode (ON)", "Kiosk Mode", 5, "kiosk", kKioskDesc);
+    out.push_back(quickActionItem("Power", QA_POWER_SUBMENU, 54));
+    // Resume Audio Player: only while music plays in the background (musicTick rebuilds the
+    // categories as it starts and stops).
+    if (mMusicResumeShown) out.push_back(quickActionItem("Resume Audio Player", QA_RESUME_AUDIO, 3));
+    // Close Current App acts on the foreground app: only over a running app, never at the home.
+    if (quickAppBehind()) out.push_back(quickActionItem("Close Current App", QA_CLOSE_APP, 83));
+    if (!qsTileHidden("gammashader")) out.push_back(quickActionItem("Global Shaders", QA_SHADER_MENU, 16));
+    out.push_back(quickActionItem("Notifications", QA_NOTIFICATIONS, 71));
+    quickLeafItem(out, "Wi-Fi",     nullptr, 85, "internet");
+    quickLeafItem(out, "Bluetooth", nullptr, 86, "bt");
+    out.push_back(quickActionItem("Display",    QA_DISPLAY_MENU,    73));
+    out.push_back(quickActionItem("Device",     QA_DEVICE_MENU,     81));
+    out.push_back(quickActionItem("Controller", QA_CONTROLLER_MENU,  5));
+    if (!kiosk) quickLeafItem(out, "Kiosk Mode", nullptr, 5, "kiosk", kKioskDesc);
+    // Seed the cached Performance Mode row value from the persisted governor prop.
+    { char pm[PROPERTY_VALUE_MAX]; property_get("persist.gammaos.performance_mode", pm, "stock");
+      mPs3PerfModeLabel = !strcmp(pm, "max") ? "Max Performance"
+                        : (!strcmp(pm, "powersave") ? "Power Saver" : "Normal"); }
+}
+
+// The Quick Menu is over an app (launched_pkg set), not the home.
+bool NanoMenu::quickAppBehind() const {
+    // The overlay is also the home once an app has run, with launched_pkg still naming that app:
+    // app_launched says whether one is behind it now.
+    if (!mOverlayMode || !property_get_bool("sys.gammaos.nano.app_launched", false)) return false;
+    char lp[PROPERTY_VALUE_MAX] = {};
+    property_get("sys.gammaos.nano.launched_pkg", lp, "");
+    return lp[0] != 0;
+}
