+
+// An entry where it was drawn, inside the primary's box (what is clipped off is not touchable).
+void NanoMenu::esdeTouchEntryZone(const TouchRect& area, const TouchRect& r, bool games, int idx) {
+    const TouchRect hit = (area.w > 1.0f && area.h > 1.0f) ? r.clippedTo(area) : r;
+    mTouch.tap(hit, [this, games, idx]() { esdeTouchEntry(games, idx); });
+}
+
+// A tap: a system opens; a game is picked, and starts when it already was.
+void NanoMenu::esdeTouchEntry(bool games, int idx) {
+    if (!esdeHomeTouchLive() || games != mEsdeInGamelist) return;
+    esdeRebuildSysList();
+    if (mEsdeSysList.empty()) return;
+    if (!games) {
+        if (idx < 0 || idx >= (int)mEsdeSysList.size()) return;
+        if (idx != mEsdeSysSel) { mEsdeSysSel = idx; mEsdeGameSel = 0; }
+        esdeSelect();
+    } else if (idx == mEsdeGameSel) {
+        esdeSelect();
+    } else {
+        if (idx < 0 || idx >= (int)mXmbSystems[mEsdeSysList[mEsdeSysSel]].roms.size()) return;
+        mEsdeGameSel = idx;
+        esdeSfx(4);
+    }
+    mDisplayDirty = true;
+}
+
+// One entry of a drag or fling (dir +1 = later entries); false at the end. The systems loop; a game
+// list stops at its first and last game.
+bool NanoMenu::esdeTouchStep(bool games, int axis, int dir) {
+    if (!esdeHomeTouchLive() || games != mEsdeInGamelist) return false;
+    esdeRebuildSysList();
+    if (mEsdeSysList.empty()) return false;
+    const int dx = axis == TouchZones::kAcross ? dir : 0, dy = axis == TouchZones::kUpDown ? dir : 0;
+    mEsdeTouchStepping = true;
+    bool moved = true;
+    if (!games) {
+        esdeNav(dx, dy);
+    } else {
+        const int n = (int)mXmbSystems[mEsdeSysList[mEsdeSysSel]].roms.size();
+        const int before = mEsdeGameSel;
+        if (esdeGamelistIsGrid() && dy) esdeNav(0, dy);   // a whole row, stopping at the first and last
+        else if (mEsdeGameSel + dir >= 0 && mEsdeGameSel + dir < n) esdeNav(dx, dy);
+        moved = mEsdeGameSel != before;
+    }
+    mEsdeTouchStepping = false;
+    return moved;
+}
+
+// A swipe no list took: across changes system (in a game list too), up opens the system's games,
+// down goes back to the systems.
+void NanoMenu::esdeTouchSwipe(int axis, int dir) {
+    if (!esdeHomeTouchLive()) return;
+    esdeRebuildSysList();
+    if (mEsdeSysList.empty()) return;
+    if (axis == TouchZones::kAcross) {
+        const int step = -dir;   // a swipe left brings the next system
+        if (!mEsdeInGamelist) { esdeNav(step, 0); return; }
+        const int n = (int)mEsdeSysList.size();
+        mEsdeSysSel = ((mEsdeSysSel + step) % n + n) % n;
+        mEsdeGameSel = 0;
+        mEsdeGridCursor = -1; mEsdeGridScroll = 0.0f; mEsdeGridAnimDur = 0.0f; mEsdeGridTransFactor = 1.0f;
+        esdeSfx(0);
+        mDisplayDirty = true;
+    } else if (dir < 0 && !mEsdeInGamelist) {
+        esdeSelect();
+    } else if (dir > 0 && mEsdeInGamelist) {
+        esdeBack();
+    }
+}
+
+// The gamelist's focused system: false outside a gamelist or during a view transition.
+bool NanoMenu::esdeFocusedSystem(int& sysIdx) {
+    if (mEsdeXsActive || !mEsdeInGamelist) return false;
+    esdeRebuildSysList();
+    if (mEsdeSysList.empty()) return false;
+    sysIdx = mEsdeSysList[mEsdeSysSel];
+    return true;
+}
+
+// The gamelist's Y FAVORITES help prompt: toggle the focused game's favourite, which the gamelist's
+// star, favourite badge and favourite counts read. Switching off a favourite imported from ES-DE's
+// metadata is remembered in mEsdeUnfavorites.
+void NanoMenu::esdeToggleFavorite() {
+    int s;
+    if (!esdeFocusedSystem(s)) return;
+    const auto& sys = mXmbSystems[s];
+    if (mEsdeGameSel < 0 || mEsdeGameSel >= (int)sys.roms.size()) return;
+    esdeToggleFavoriteRom(std::string(sys.roms[mEsdeGameSel]), s);   // a copy: the toggle re-sorts the list
+}
+
+// sysIdx: the system it is listed under (the first system holding it when -1).
+void NanoMenu::esdeToggleFavoriteRom(const std::string& rom, int sysIdx) {
+    if (esdeStoreMode()) {   // the favourites are the gamelists' own: one list
+        toggleFavorite(rom);
+        if (sysIdx >= 0) favoritesResort(sysIdx, rom);
+        else favoritesResort(rom);
+        esdeSfx(5);
+        mDisplayDirty = true;
+        return;
+    }
+    const ScrapeEntry* meta = esdeMetaFor(rom);
+    const bool metaFav = meta && meta->favorite;
+    auto un = std::find(mEsdeUnfavorites.begin(), mEsdeUnfavorites.end(), rom);
+    if (esdeIsFavorite(rom, meta)) {
+        if (isFavorite(rom)) toggleFavorite(rom);
+        if (metaFav && un == mEsdeUnfavorites.end()) { mEsdeUnfavorites.push_back(rom); saveFavorites(); }
+    } else {
+        if (un != mEsdeUnfavorites.end()) { mEsdeUnfavorites.erase(un); saveFavorites(); }
+        if (!metaFav) toggleFavorite(rom);
+    }
+    if (sysIdx >= 0) favoritesResort(sysIdx, rom);
+    else favoritesResort(rom);
+    esdeSfx(5);                                // favorite
+    mDisplayDirty = true;
+}
+
+// The gamelist's X VIEW MEDIA help prompt: the focused game's media viewer.
+void NanoMenu::esdeOpenGameInfo() {
+    int s;
+    if (!esdeFocusedSystem(s)) return;
+    esdeViewerOpen(s, mEsdeGameSel);
+}
+
+// The gamelist's BACK OPTIONS help prompt (Select): the focused game's Game Options - its own
+// emulator, title, box art and scraping, as ES-DE's gamelist options menu edits them.
+bool NanoMenu::esdeOpenGameOptions() {
+    int s;
+    if (!esdeFocusedSystem(s)) return false;
+    if (mEsdeGameSel < 0 || mEsdeGameSel >= (int)mXmbSystems[s].roms.size()) return false;
+    openGameOptions(s, mEsdeGameSel);
+    return true;
+}
+
+// The gamelist's L/R SYSTEM help prompt (QuickSystemSelect=leftrightshoulders): the shoulders
