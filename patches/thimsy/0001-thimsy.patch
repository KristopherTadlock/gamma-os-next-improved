+// Whether a connector is DisplayPort or HDMI, and the encoder driving it. Asks for one mode so the
+// kernel does not probe the connector (an EDID read) as it does when asked for none.
+static bool drmConnectorExternal(int fd, uint32_t connId, uint32_t* encoderId) {
+    struct drm_mode_modeinfo mode;
+    struct drm_mode_get_connector conn = {};
+    conn.connector_id = connId;
+    conn.count_modes = 1;
+    conn.modes_ptr = (uint64_t)(uintptr_t)&mode;
+    if (ioctl(fd, DRM_IOCTL_MODE_GETCONNECTOR, &conn) != 0) return false;
+    if (encoderId) *encoderId = conn.encoder_id;
+    return conn.connector_type == DRM_MODE_CONNECTOR_DisplayPort ||
+           conn.connector_type == DRM_MODE_CONNECTOR_HDMIA ||
+           conn.connector_type == DRM_MODE_CONNECTOR_HDMIB;
+}
+
+// The card's connector and CRTC ids.
+static bool drmResources(int fd, std::vector<uint32_t>* conns, std::vector<uint32_t>* crtcs) {
+    struct drm_mode_card_res res = {};
+    if (ioctl(fd, DRM_IOCTL_MODE_GETRESOURCES, &res) != 0) return false;
+    conns->resize(res.count_connectors);
+    crtcs->resize(res.count_crtcs);
+    struct drm_mode_card_res res2 = {};
+    res2.count_connectors = res.count_connectors;
+    res2.connector_id_ptr = (uint64_t)(uintptr_t)conns->data();
+    res2.count_crtcs = res.count_crtcs;
+    res2.crtc_id_ptr = (uint64_t)(uintptr_t)crtcs->data();
+    if (ioctl(fd, DRM_IOCTL_MODE_GETRESOURCES, &res2) != 0) return false;
+    conns->resize(std::min(res.count_connectors, res2.count_connectors));
+    crtcs->resize(std::min(res.count_crtcs, res2.count_crtcs));
+    return true;
+}
+
+// The connector driving this CRTC, 0 if none; *external says whether it is DisplayPort or HDMI.
+static uint32_t drmCrtcConnector(int fd, uint32_t crtcId, bool* external) {
+    std::vector<uint32_t> conns, crtcs;
+    if (!drmResources(fd, &conns, &crtcs)) return 0;
+    for (uint32_t connId : conns) {
+        uint32_t encoderId = 0;
+        const bool ext = drmConnectorExternal(fd, connId, &encoderId);
+        if (encoderId == 0) continue;
+        struct drm_mode_get_encoder enc = {};
+        enc.encoder_id = encoderId;
+        if (ioctl(fd, DRM_IOCTL_MODE_GETENCODER, &enc) == 0 && enc.crtc_id == crtcId) {
+            *external = ext;
+            return connId;
+        }
+    }
+    return 0;
+}
