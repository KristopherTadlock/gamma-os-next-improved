 <?xml version="1.0" encoding="utf-8"?>
 <resources>
-    <string name="title_launch_guard">GammaOS Launch Guard</string>
+    <string name="title_launch_guard">Thimsy Launch Guard</string>
     <string name="launch_guard_toggle_label">Ativar Launch Guard</string>
     <string name="launch_guard_toggle_summary">Quando ativado, o sistema forçará a parada dos apps alvo selecionados quando forem iniciados pelos apps chamadores selecionados. Isso pode resolver travamentos do emulador quando um app é reiniciado enquanto ainda está em execução.</string>
     <string name="callers_section_title">Apps chamadores</string>
diff --git a/packages/apps/LaunchGuardControl/res/values-ru/strings.xml b/packages/apps/LaunchGuardControl/res/values-ru/strings.xml
index cc4bb1c8456..0e3a0bbfb99 100644
