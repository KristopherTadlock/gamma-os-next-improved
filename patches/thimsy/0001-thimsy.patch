 <resources>
-    <string name="title_launch_guard">GammaOS Launch Guard</string>
+    <string name="title_launch_guard">Thimsy Launch Guard</string>
     <string name="launch_guard_toggle_label">Включить Launch Guard</string>
     <string name="launch_guard_toggle_summary">При включении система принудительно остановит выбранные целевые приложения при их запуске из выбранных вызывающих приложений. Это может решить проблему сбоя эмулятора при повторном запуске приложения, которое ещё работает.</string>
     <string name="callers_section_title">Вызывающие приложения</string>
diff --git a/packages/apps/LaunchGuardControl/res/values-tr/strings.xml b/packages/apps/LaunchGuardControl/res/values-tr/strings.xml
