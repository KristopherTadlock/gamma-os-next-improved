+
+## 4:3 Cropped (`4x3-cropped`)
+
+Unlike the other types, this is not a post-process. SurfaceFlinger picks the game layer of the
+emulator Nano launched (`sys.gammaos.nano.launch_app`) on each display, whatever it shows; the
+shader is turned off for a game it doesn't suit. The game area (`gammaCropProjection`) is the
+picture (the layer's buffer, in its own pixels) when that is within 5% of 4:3, or else its largest
+centred 4:3 rectangle, where an emulator such as Dolphin letterboxes its game. A marked layer is
+client composited. RetroArch draws its game into its window, so it is filtered as if
+`persist.gammaos.shader.4x3.window.<package>` were set (the property can turn that off); its
+own menu, drawn in the same window, is projected with the game.
+
+RenderEngine draws a marked layer through `ThimsySurfaceScaler`: the game area fills an 800 × 600
+projection on the panel (1600 × 1200 on a 1080p display), one display pixel per projected pixel,
+centred and cropped to the display, with black around it. On the panel that cuts 40 projected
+pixels from each side and leaves 60 black rows above and below; at 1080p it cuts 60 rows from the
+top and bottom and leaves 160 black columns each side. Sampling is sharp bilinear: each texel is
+held flat and blended with its neighbour only across the display pixel on their shared edge. When
+the picture is shrunk the kernel is plain bilinear.
+
+The game layer is the launched package's SurfaceView, then its opaque buffer layer, then the one
+with the largest area, so a SurfaceView wins over the translucent window above it. A window that is
+opaque outside its SurfaceView still covers the extended picture there.
+
+## 8:7 Cropped (`8x7-cropped`)
+
+4:3 Cropped stretched vertically (`GammaCrop::k8x7`): the same 4:3 game area, or a picture within
+5% of 8:7 such as a core's raw 256 × 224 frame, fills an 800 × 720 projection on the panel (40 projected pixels cut from
+each side, as 4:3 Cropped) or 1200 × 1080 on a 1080p display. The game layer
+choice and the exclusions are the same; RetroArch's copy is `rg_cube_8_7_cropped`.
 
 ## SELinux Policy
 
diff --git a/frameworks/native/libs/renderengine/skia/filters/ThimsySurfaceScaler.cpp b/frameworks/native/libs/renderengine/skia/filters/ThimsySurfaceScaler.cpp
new file mode 100644
index 00000000000..bcb243bd04c
--- /dev/null
+++ b/frameworks/native/libs/renderengine/skia/filters/ThimsySurfaceScaler.cpp
@@ -0,0 +1,98 @@
+#include "ThimsySurfaceScaler.h"
+
+#include <SkM44.h>
+#include <SkRuntimeEffect.h>
+#include <SkSamplingOptions.h>
+#include <SkTileMode.h>
+#include <log/log.h>
+
+#include <algorithm>
+#include <cmath>
+#include <mutex>
+
+namespace android {
+namespace renderengine {
+namespace skia {
+
+namespace {
+
+// Sharp bilinear: texel centres sit on integers in c. Each texel is held flat and neighbours
+// are blended only across the one display pixel that straddles their shared edge, so scale is
+// display pixels per texel (>= 1). At scale 1 this is plain bilinear, which is also the
+// minification policy: one hardware bilinear sample, no extra antialiasing.
+static const char* kSkSL = R"(
+    uniform shader image;
+    uniform float3x3 displayToTexel;
+    uniform float2 scale;
+    uniform float4 texClamp;
+
+    half4 main(float2 p) {
+        float2 c = (displayToTexel * float3(p, 1)).xy - 0.5;
+        float2 i = floor(c);
+        float2 f = clamp((c - i - 0.5) * scale + 0.5, 0.0, 1.0);
+        return image.eval(clamp(i + f + 0.5, texClamp.xy, texClamp.zw));
+    }
+)";
+
+sk_sp<SkRuntimeEffect> effect() {
+    static std::once_flag once;
+    static sk_sp<SkRuntimeEffect> sEffect;
+    std::call_once(once, [] {
+        auto [fx, error] = SkRuntimeEffect::MakeForShader(SkString(kSkSL));
+        ALOGE_IF(!fx, "ThimsySurfaceScaler: SkSL compile failed: %s", error.c_str());
+        sEffect = std::move(fx);
+    });
+    return sEffect;
+}
+
+} // namespace
+
+std::optional<ThimsySurfaceScaler::Result> ThimsySurfaceScaler::make(
+        const sk_sp<SkImage>& image, const SkMatrix& layerToTexel, SkSize layerSize,
+        const SkRect& displayClip, GammaCrop crop) {
+    const float bw = layerSize.width();
+    const float bh = layerSize.height();
+    const auto proj = gammaCropProjection(crop, bw, bh, displayClip.width(), displayClip.height());
+    const sk_sp<SkRuntimeEffect> fx = effect();
+    if (!proj || !fx || !image) return std::nullopt;
+
+    // The game area fills the projection, one display pixel per projected pixel, centred on the
+    // display and cropped to it.
+    const float projX = displayClip.fLeft + (displayClip.width() - proj->width) / 2.f;
+    const float projY = displayClip.fTop + (displayClip.height() - proj->height) / 2.f;
+    SkRect dst = SkRect::MakeXYWH(projX, projY, proj->width, proj->height);
+    if (!dst.intersect(displayClip)) {
+        return std::nullopt;
+    }
+
+    // display -> projection -> game area -> layer-relative -> texels
+    const float sx = proj->gameW / proj->width;
+    const float sy = proj->gameH / proj->height;
+    const SkMatrix displayToLayer =
+            SkMatrix::MakeAll(sx, 0.f, proj->gameX - projX * sx, 0.f, sy,
+                              proj->gameY - projY * sy, 0.f, 0.f, 1.f);
+    const SkMatrix displayToTexel = SkMatrix::Concat(layerToTexel, displayToLayer);
+
+    SkRect texClamp = layerToTexel.mapRect(
+            SkRect::MakeXYWH(proj->gameX, proj->gameY, proj->gameW, proj->gameH));
+    texClamp.inset(std::min(0.5f, texClamp.width() / 2.f),
+                   std::min(0.5f, texClamp.height() / 2.f));
+
+    const float texelsPerPxX = std::hypot(displayToTexel.getScaleX(), displayToTexel.getSkewX());
+    const float texelsPerPxY = std::hypot(displayToTexel.getSkewY(), displayToTexel.getScaleY());
+    const SkV2 scale{texelsPerPxX > 0.f ? std::max(1.f, 1.f / texelsPerPxX) : 1.f,
+                     texelsPerPxY > 0.f ? std::max(1.f, 1.f / texelsPerPxY) : 1.f};
+
+    SkRuntimeShaderBuilder builder(fx);
+    builder.child("image") = image->makeShader(SkTileMode::kClamp, SkTileMode::kClamp,
+                                               SkSamplingOptions(SkFilterMode::kLinear));
+    builder.uniform("displayToTexel") = displayToTexel;
+    builder.uniform("scale") = scale;
+    builder.uniform("texClamp") =
+            SkV4{texClamp.fLeft, texClamp.fTop, texClamp.fRight, texClamp.fBottom};
+    return Result{builder.makeShader(), dst};
+}
+
+} // namespace skia
+} // namespace renderengine
+} // namespace android
