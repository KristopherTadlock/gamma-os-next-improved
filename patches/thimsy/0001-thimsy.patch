+        {"Date Format", trDyn(kDateFmts[std::clamp(mPs3DateFormatIdx, 0, 2)])},
+        {"Time Format", trDyn(kTimeFmts[std::clamp(mPs3TimeFormatIdx, 0, 1)])},
