+// A connected connector's preferred mode, probing it.
+static bool drmConnectorMode(int fd, uint32_t connId, struct drm_mode_modeinfo* mode) {
+    struct drm_mode_get_connector conn = {};
+    conn.connector_id = connId;
+    if (ioctl(fd, DRM_IOCTL_MODE_GETCONNECTOR, &conn) != 0 || conn.count_modes == 0 ||
+        conn.connection != 1 /* connected */)
+        return false;
+    std::vector<struct drm_mode_modeinfo> modes(conn.count_modes);
+    struct drm_mode_get_connector conn2 = {};
+    conn2.connector_id = connId;
+    conn2.count_modes = conn.count_modes;
+    conn2.modes_ptr = (uint64_t)(uintptr_t)modes.data();
+    if (ioctl(fd, DRM_IOCTL_MODE_GETCONNECTOR, &conn2) != 0 || conn2.count_modes == 0) return false;
+    *mode = modes[0];   // first mode is preferred
+    return true;
+}
