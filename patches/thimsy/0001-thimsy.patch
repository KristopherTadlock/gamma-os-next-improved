+// Turn on Android automatic time for ongoing syncs, then ACTIVELY fetch the current UTC and set the
+// clock: the network_time_update service is not reachable on this build, so just enabling auto_time
+// does not re-sync (it stays on whatever Set Manually left). curl the Date response header (UTC,
+// second precision) and set-time from it.
+bool NanoMenu::setClockFromInternet() {
+    system("settings put global auto_time 1 2>/dev/null");
+    FILE* f = popen("curl -sI --max-time 8 http://example.com 2>/dev/null | grep -i '^date:'", "r");
+    if (!f) return false;
+    char line[160] = {};
+    bool got = fgets(line, sizeof(line), f) != nullptr;
+    pclose(f);
+    const char* colon = got ? strchr(line, ':') : nullptr;   // after "Date"
+    if (!colon) return false;
+    const char* ds = colon + 1;
+    while (*ds == ' ') ds++;                                   // -> "Wed, 04 Jun 2026 13:57:10 GMT"
+    struct tm tmv; memset(&tmv, 0, sizeof(tmv));
+    if (!strptime(ds, "%a, %d %b %Y %H:%M:%S", &tmv)) return false;
+    time_t epoch = timegm(&tmv);                               // header is GMT/UTC
+    if (epoch <= 0) return false;
+    char cmd[96];
+    snprintf(cmd, sizeof(cmd), "cmd alarm set-time %lld 2>/dev/null", (long long)epoch * 1000LL);
+    return system(cmd) == 0;
+}
