+// What the startup worker produced. The worker writes it only before join(); the render thread
+// reads it only after, so nothing in it is shared while both run.
+struct NanoMenu::StartupPreload {
+    std::thread worker;
+    bool joined = false;
+    int64_t startMs = 0;
+    int64_t workerMs = 0;
+    // Font faces, opened in initFonts' order on the worker's own FT_Library (fontsOk). Skipped when
+    // the persist props were not loaded yet (persist.gammaos.nano.font): initFonts opens them then.
+    bool fontsOk = false;
+    FT_Library ftLib = nullptr;
+    FT_Face faces[MAX_FT_FACES] = {};
+    int numFaces = 0, ndsFontIdx = -1, ndsNumIdx = -1, esdeDefaultFace = -1;
+    // The 21 menu icons decoded to RGBA (iconsOk); initIconTextures resizes and uploads them.
+    bool iconsOk = false;
+    struct Icon {
+        bool ok = false, fromFile = false;
+        std::string path;
+        int w = 0, h = 0;
+        std::vector<uint8_t> px;
+    };
+    Icon icons[21];
+
+    ~StartupPreload() {
+        if (worker.joinable()) worker.join();
+        if (ftLib) {   // never adopted (initFonts did not run)
+            for (int i = 0; i < numFaces; i++) if (faces[i]) FT_Done_Face(faces[i]);
+            FT_Done_FreeType(ftLib);
+        }
+    }
+};
+
+// Started at the top of readyToRun, before EGL. Reads files only: no GL, no NanoMenu member.
+void NanoMenu::startupPreloadStart() {
+    auto pre = std::make_shared<StartupPreload>();
+    pre->startMs = (int64_t)uptimeMillis();
+    char ready[PROPERTY_VALUE_MAX] = {};
+    property_get("ro.persistent_properties.ready", ready, "");
+    const bool fonts = strcmp(ready, "true") == 0;
+    const bool icons = !sDrasticQrFastPath;
+    StartupPreload* p = pre.get();
+    pre->worker = std::thread([p, fonts, icons] {
+        pthread_setname_np(pthread_self(), "nano-preload");
+        setpriority(PRIO_PROCESS, 0, ANDROID_PRIORITY_NORMAL);   // not the display priority it inherits
+        if (fonts && FT_Init_FreeType(&p->ftLib) == 0) {
+            openFontFaces(p->ftLib, p->faces, MAX_FT_FACES, &p->numFaces, &p->ndsFontIdx,
+                          &p->ndsNumIdx, &p->esdeDefaultFace);
+            p->fontsOk = true;
+        } else {
+            p->ftLib = nullptr;
+        }
+        if (icons) {
+            for (int i = 0; i < 21; i++) {
+                StartupPreload::Icon& ic = p->icons[i];
+                const bool mono = (i != 14);
+                if (kIconPngNames[i]) {
+                    ic.path = std::string(kIconPngDir) + "/" + kIconPngNames[i];
+                    if (decodePngFile(ic.path.c_str(), mono, &ic.w, &ic.h, &ic.px)) {
+                        ic.ok = ic.fromFile = true;
+                        continue;
+                    }
+                }
+                ic.px.clear();
+                ic.ok = decodePngMemory(kEmbeddedIcons[i].data, kEmbeddedIcons[i].size, mono, &ic.w, &ic.h,
+                                        &ic.px);
+            }
+            p->iconsOk = true;
+        }
+        p->workerMs = (int64_t)uptimeMillis() - p->startMs;
+        ALOGI("startup preload: worker done in %lld ms (fonts %s, %d faces; icons %s)",
+              (long long)p->workerMs, p->fontsOk ? "opened" : "left to initFonts", p->numFaces,
+              p->iconsOk ? "decoded" : "skipped");
+        if (!icons) return;
+        // initXmbSystems parses these on the render thread; reading them here brings them into the
+        // page cache first. Its own thread, so the render thread's join does not wait for it.
+        std::thread([] {
+            pthread_setname_np(pthread_self(), "nano-prefetch");
+            setpriority(PRIO_PROCESS, 0, ANDROID_PRIORITY_BACKGROUND);
+            std::vector<std::string> files = {"/data/system/nano_systems.json"};
+            if (DIR* d = opendir("/data/system/nano_xmb_cache")) {
+                while (struct dirent* e = readdir(d)) {
+                    const size_t n = strlen(e->d_name);
+                    if (n > 5 && strcmp(e->d_name + n - 5, ".list") == 0)
+                        files.push_back(std::string("/data/system/nano_xmb_cache/") + e->d_name);
+                }
+                closedir(d);
+            }
+            std::vector<char> buf(64 * 1024);
+            for (const auto& f : files) {
+                int fd = open(f.c_str(), O_RDONLY | O_CLOEXEC);
+                if (fd < 0) continue;
+                while (read(fd, buf.data(), buf.size()) > 0) {}
+                close(fd);
+            }
+        }).detach();
+    });
+    mStartupPreload = pre;
+    ALOGI("startup preload: worker started (fonts=%d icons=%d)", fonts ? 1 : 0, icons ? 1 : 0);
+}
+
+// The render thread's first use of the startup work: wait for the worker once.
+NanoMenu::StartupPreload* NanoMenu::startupPreloadJoin() {
+    StartupPreload* p = mStartupPreload.get();
+    if (!p) return nullptr;
+    if (!p->joined) {
+        const int64_t t0 = (int64_t)uptimeMillis();
+        if (p->worker.joinable()) p->worker.join();
+        p->joined = true;
+        const int64_t waited = (int64_t)uptimeMillis() - t0;
+        ALOGI("startup preload: overlap %lld ms (render thread reached fonts %lld ms after the worker "
+              "started, waited %lld ms; worker %lld ms)",
+              (long long)std::min(p->workerMs, t0 - p->startMs), (long long)(t0 - p->startMs),
+              (long long)waited, (long long)p->workerMs);
+    }
+    return p;
+}
