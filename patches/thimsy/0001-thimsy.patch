+// Where a game's ES-DE media can be: the system folder names to try and the file names (without
+// extension) to try, best first. ES-DE keeps a game's media under the same subfolders as the game
+// (covers/Game/EBOOT.png for psp/Game/EBOOT.PBP), so two games in different folders with the same
+// file name never share media. A rom outside every scanned folder falls back to its parent folder
+// as the system. canon (may be null) gets the ES-DE name of the rom's system, if known.
+bool NanoMenu::esdeMediaLayout(const std::string& romPath, int sysIdx, std::vector<std::string>* sysDirs,
+                               std::vector<std::string>* names, std::string* canon) {
+    int romSys = -1;
+    std::string sys, rel;
+    if (!esdeRomSubPath(romPath, sysIdx, &romSys, &sys, &rel)) {
+        size_t sl = romPath.find_last_of('/');
+        std::string dir = (sl == std::string::npos) ? std::string() : romPath.substr(0, sl);
+        size_t sl2 = dir.find_last_of('/');
+        sys = (sl2 == std::string::npos) ? dir : dir.substr(sl2 + 1);
+        rel = (sl == std::string::npos) ? romPath : romPath.substr(sl + 1);
+    }
+    size_t relSl = rel.find_last_of('/');
+    const std::string sub = (relSl == std::string::npos) ? std::string() : rel.substr(0, relSl + 1);   // "Game/"
+    const std::string file = (relSl == std::string::npos) ? rel : rel.substr(relSl + 1);
+    size_t dot = file.find_last_of('.');
+    const std::string base = (dot == std::string::npos) ? file : file.substr(0, dot);
+    if (sys.empty() || base.empty()) return false;
