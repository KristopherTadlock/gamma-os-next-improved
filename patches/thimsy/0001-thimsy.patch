+// Built-in panel connectors that could light this unlit CRTC, best first: not DisplayPort or HDMI,
+// with an encoder that lists the CRTC, and not driven by another CRTC. A panel the callers pair (by
+// index) with another CRTC it can drive is left for that CRTC unless this one has no other. The
+// caller's connector leads, and may also be taken from a CRTC Nano has not added (lit by the
+// bootloader), as when it was used alone, so panels keep their order, but only while a free panel
+// can still light that CRTC. Ahead of all that, a choice that leaves the callers' other unlit CRTC
+// a panel comes first. Others already known to be disconnected are skipped; whether a candidate is
+// connected is left to the probe that reads its modes.
+static std::vector<uint32_t> drmPanelConnectorsFor(int fd, uint32_t crtcId, uint32_t preferred) {
+    std::vector<uint32_t> out;
+    std::vector<uint32_t> conns, crtcs;
+    if (!drmResources(fd, &conns, &crtcs)) return out;
+    auto bitOf = [&](uint32_t id) -> uint32_t {
+        const size_t i = std::find(crtcs.begin(), crtcs.end(), id) - crtcs.begin();
+        return i < crtcs.size() && i < 32 ? 1u << i : 0;
+    };
+    const uint32_t crtcBit = bitOf(crtcId);
+    if (!crtcBit) return out;
+
+    struct Panel { uint32_t id, mask, drivenBy, connection; };
+    std::vector<Panel> panels;
+    for (uint32_t connId : conns) {
+        uint32_t current = 0;
+        if (drmConnectorExternal(fd, connId, &current)) continue;
+        Panel p = {connId, 0, 0, 0};
+        if (current != 0) {
+            struct drm_mode_get_encoder enc = {};
+            enc.encoder_id = current;
+            if (ioctl(fd, DRM_IOCTL_MODE_GETENCODER, &enc) == 0 && enc.crtc_id != crtcId)
+                p.drivenBy = enc.crtc_id;
+        }
+        struct drm_mode_modeinfo mode;
+        struct drm_mode_get_connector conn = {};
+        conn.connector_id = connId;
+        conn.count_modes = 1;   // no probe, as in drmConnectorExternal
+        conn.modes_ptr = (uint64_t)(uintptr_t)&mode;
+        if (ioctl(fd, DRM_IOCTL_MODE_GETCONNECTOR, &conn) != 0 || conn.count_encoders == 0) continue;
+        p.connection = conn.connection;
+        std::vector<uint32_t> encoders(conn.count_encoders);
+        struct drm_mode_get_connector conn2 = {};
+        conn2.connector_id = connId;
+        conn2.count_modes = 1;
+        conn2.modes_ptr = (uint64_t)(uintptr_t)&mode;
+        conn2.count_encoders = conn.count_encoders;
+        conn2.encoders_ptr = (uint64_t)(uintptr_t)encoders.data();
+        if (ioctl(fd, DRM_IOCTL_MODE_GETCONNECTOR, &conn2) != 0) continue;
+        encoders.resize(std::min(conn.count_encoders, conn2.count_encoders));
+        for (uint32_t encoderId : encoders) {
+            struct drm_mode_get_encoder enc = {};
+            enc.encoder_id = encoderId;
+            if (ioctl(fd, DRM_IOCTL_MODE_GETENCODER, &enc) == 0) p.mask |= enc.possible_crtcs;
+        }
+        panels.push_back(p);
+    }
+    auto panelOf = [&](uint32_t id) {
+        return std::find_if(panels.begin(), panels.end(), [&](const Panel& p) { return p.id == id; });
+    };
+    // The callers pair connectors[c] with crtcs[c] for the first two CRTCs; a CRTC Nano has added
+    // or that a panel already drives is not waiting for its pair.
+    auto taken = [&](uint32_t crtc) {
+        return std::any_of(sDrmDisplays.begin(), sDrmDisplays.end(),
+                           [&](const DrmDisplay& d) { return d.crtcId == crtc; }) ||
+               std::any_of(panels.begin(), panels.end(),
+                           [&](const Panel& p) { return p.drivenBy == crtc; });
+    };
+    auto reserved = [&](uint32_t id) {
+        for (size_t c = 0; c < 2 && c < crtcs.size() && c < conns.size(); c++) {
+            if (crtcs[c] == crtcId || conns[c] != id || taken(crtcs[c])) continue;
+            const auto p = panelOf(id);
+            if (p != panels.end() && (p->mask & (1u << c))) return true;
+        }
+        return false;
+    };
+
+    const auto pref = panelOf(preferred);
+    if (pref != panels.end() && (pref->mask & crtcBit)) {
+        if (!pref->drivenBy) {
+            out.push_back(pref->id);
+        } else {
+            // Lit on a CRTC Nano has not added: taken only if another free panel fits that CRTC.
+            const bool ours = std::any_of(sDrmDisplays.begin(), sDrmDisplays.end(),
+                                          [&](const DrmDisplay& d) { return d.crtcId == pref->drivenBy; });
+            const uint32_t theirBit = bitOf(pref->drivenBy);
+            const bool replaceable = std::any_of(panels.begin(), panels.end(), [&](const Panel& q) {
+                return q.id != pref->id && !q.drivenBy && (q.mask & theirBit) &&
+                       q.connection != 2 /* disconnected */;
+            });
+            if (!ours && replaceable) out.push_back(pref->id);
+        }
+    }
+    std::vector<uint32_t> others;   // paired with another CRTC: only when this CRTC has nothing else
+    for (const Panel& p : panels) {
+        if (p.id == preferred || p.drivenBy || !(p.mask & crtcBit) ||
+            p.connection == 2 /* disconnected */)
+            continue;
+        (reserved(p.id) ? others : out).push_back(p.id);
+    }
+    if (out.empty()) out = others;
+
+    // The other of the callers' two CRTCs, still waiting for a panel: a choice that leaves it one
+    // goes first, so both light when some assignment lights both.
+    for (size_t j = 0; j < 2 && j < crtcs.size(); j++) {
+        if (crtcs[j] == crtcId || taken(crtcs[j])) continue;
+        const uint32_t pairOfJ = j < conns.size() ? conns[j] : 0;
+        auto leavesJ = [&](uint32_t chosen) {
+            return std::any_of(panels.begin(), panels.end(), [&](const Panel& q) {
+                return q.id != chosen && !q.drivenBy && (q.mask & (1u << j)) &&
+                       (q.connection != 2 || q.id == pairOfJ);
+            });
+        };
+        std::stable_partition(out.begin(), out.end(), leavesJ);
+    }
+    return out;
+}
