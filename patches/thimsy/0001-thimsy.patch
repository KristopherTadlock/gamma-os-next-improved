+void NanoMenu::fileCopyThreadFunc(std::vector<FileCopyPair> pairs) {
+    std::vector<std::string> stopPkgs;
+    stopPkgs.swap(mFileJobStopPkgs);   // this job's only
+    // Collect (relative path) for every regular file first, so the modal can show a total. A
+    // folder or file that is there but cannot be read (a card pulled mid-copy), or a required
+    // source that is missing, counts as a failure, so the setting is not switched to an incomplete
+    // copy; an optional source that does not exist (an unused default folder) is simply skipped.
+    // result: 0 copied, 1 already there (a different file), 2 failed, 3 merged, 4 already there (the same)
+    struct Item { size_t pair; std::string rel; int result = -1; bool created = false; };
+    std::vector<Item> items;
+    int unreadable = 0, missingRequired = 0;
+    std::function<void(size_t, const std::string&, const std::string&)> walk =
+        [&](size_t pi, const std::string& dir, const std::string& rel) {
+            DIR* d = opendir(dir.c_str());
+            if (!d) { unreadable++; return; }
+            for (;;) {
+                errno = 0;
+                dirent* e = readdir(d);
+                if (!e) { if (errno != 0) unreadable++; break; }
+                if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+                const std::string full = dir + "/" + e->d_name;
+                const std::string r = rel.empty() ? std::string(e->d_name) : rel + "/" + e->d_name;
+                struct stat st;
+                if (lstat(full.c_str(), &st) != 0) { if (errno != ENOENT) unreadable++; continue; }
+                const auto& skip = pairs[pi].skipDirs;
+                if (S_ISDIR(st.st_mode)) { if (std::find(skip.begin(), skip.end(), r) == skip.end()) walk(pi, full, r); }
+                else if (S_ISREG(st.st_mode)) items.push_back({pi, r});
+                else if (S_ISLNK(st.st_mode) && pairs[pi].move) unreadable++;   // would be lost: nothing moves
+            }
+            closedir(d);
+        };
+    auto collect = [&]() {
+        items.clear();
+        unreadable = 0; missingRequired = 0;
+        for (size_t i = 0; i < pairs.size(); i++) {
+            if (pairs[i].src == pairs[i].dst) continue;
+            struct stat st;
+            if (stat(pairs[i].src.c_str(), &st) != 0) {
+                if (errno != ENOENT) unreadable++;
+                else if (pairs[i].required) missingRequired++;
+                continue;
+            }
+            if (S_ISDIR(st.st_mode)) walk(i, pairs[i].src, std::string());
+            else if (S_ISREG(st.st_mode)) items.push_back({i, std::string()});   // a single file
+        }
+    };
+    collect();
+    // Room for what will be copied, on each destination drive, before anything is closed or
+    // copied: every file the job writes (not the ones it leaves because one is there), rounded up
+    // to the drive's cluster, a cluster per new folder, and 8 MB to spare.
+    {
+        // An overwrite needs only what it adds, but its copy sits beside the old file until the rename.
+        struct Need { std::string path; uint64_t want = 0, avail = 0, cluster = 4096, peak = 0; bool known = false; };
+        std::map<dev_t, Need> need;
+        std::set<std::string> newDirs, counted;
+        std::map<std::string, std::pair<dev_t, std::string>> parentOf;   // a folder: its drive and nearest existing folder
+        std::vector<std::string> canonDst(pairs.size());
+        for (size_t i = 0; i < pairs.size(); i++) canonDst[i] = nanoCanonPath(pairs[i].dst);
+        auto drive = [&](dev_t dev, const std::string& path) -> Need& {
+            Need& n = need[dev];
+            if (n.path.empty()) {
+                n.path = path;
+                struct statvfs vfs;
+                if (statvfs(path.c_str(), &vfs) == 0) {
+                    n.known = true;
+                    if (vfs.f_bsize) n.cluster = (uint64_t)vfs.f_bsize;
+                    n.avail = (uint64_t)vfs.f_bavail * (uint64_t)vfs.f_frsize;
+                    n.want = 8ull * 1024 * 1024;
+                }
+            }
+            return n;
+        };
+        size_t seen = 0;
+        for (const auto& it : items) {
+            if ((++seen & 255) == 0) {
+                std::lock_guard<std::mutex> lk(mScrapeMutex);
+                if (mScrapeCancel) break;
+            }
+            const FileCopyPair& pr = pairs[it.pair];
+            if (!pr.merged.empty() && std::find(pr.merged.begin(), pr.merged.end(), it.rel) != pr.merged.end()) continue;
+            const std::string src = it.rel.empty() ? pr.src : pr.src + "/" + it.rel;
+            const std::string dst = it.rel.empty() ? canonDst[it.pair] : canonDst[it.pair] + "/" + it.rel;
+            if (!counted.insert(dst).second) continue;   // another pair of the job writes it already
+            struct stat sst, dstSt;
+            if (stat(src.c_str(), &sst) != 0) continue;
+            const bool exists = lstat(dst.c_str(), &dstSt) == 0;
+            if (exists && !pr.overwrite && (pr.move || !pr.replaceOlder || sst.st_mtime <= dstSt.st_mtime)) continue;
+            const std::string parent = dst.substr(0, dst.find_last_of('/'));
+            auto pit = parentOf.find(parent);
+            if (pit == parentOf.end()) {
+                std::string dir = parent;
+                std::vector<std::string> made;
+                struct stat dirSt{};
+                while (dir.size() > 1 && stat(dir.c_str(), &dirSt) != 0) {
+                    made.push_back(dir);
+                    dir = dir.substr(0, dir.find_last_of('/'));
+                }
+                pit = parentOf.emplace(parent, std::make_pair(dirSt.st_dev, dir)).first;
+                if (dir.size() > 1) {
+                    Need& n = drive(dirSt.st_dev, dir);
+                    for (const auto& m : made) if (newDirs.insert(m).second) n.want += n.cluster;
+                }
+            }
+            if (pit->second.second.size() <= 1) continue;
+            Need& n = drive(pit->second.first, pit->second.second);
+            if (!n.known) continue;
+            const uint64_t size = ((uint64_t)sst.st_size + n.cluster - 1) / n.cluster * n.cluster;
+            if (exists && S_ISREG(dstSt.st_mode)) {
+                const uint64_t old = ((uint64_t)dstSt.st_size + n.cluster - 1) / n.cluster * n.cluster;
+                if (size > old) n.want += size - old;
+                n.peak = std::max(n.peak, size);
+            } else {
+                n.want += size;
+            }
+        }
+        for (auto& kv : need) kv.second.want += kv.second.peak;
+        std::string problem;
+        for (const auto& kv : need) {
+            const Need& n = kv.second;
+            if (!n.known) continue;
+            ALOGI("ps3menu: copy: %s needs %llu bytes, %llu free", n.path.c_str(),
+                  (unsigned long long)n.want, (unsigned long long)n.avail);
+            if (n.want > n.avail) {
+                char buf[256];
+                snprintf(buf, sizeof(buf), trDyn("Not enough space: %s needed, %s free. Nothing was copied."),
+                         nanoSizeText(n.want).c_str(), nanoSizeText(n.avail).c_str());
+                problem = buf;
+                break;
+            }
+        }
+        std::lock_guard<std::mutex> lk(mScrapeMutex);
+        if (!problem.empty() || mScrapeCancel) {   // nothing stopped or copied yet
+            mScrapeTotal = (int)items.size();
+            if (!problem.empty()) {
+                mScrapeFail++;
+                mScrapeError = problem;
+            }
+            mFileJobConflicts.clear();
+            mFileJobFailedGroups.clear();
+            mFileJobIncomplete = false;
+            mScrapeRunning = false;
+            mScrapeDoneFlag = true;
+            return;
+        }
+    }
+    // The programs whose files move are closed first (they write their settings when they close).
+    const bool stopRa = std::find(stopPkgs.begin(), stopPkgs.end(), "com.retroarch.aarch64") != stopPkgs.end();
+    for (const auto& pkg : stopPkgs) {
+        if (pkg == "com.retroarch.aarch64") continue;
+        const std::string cmd = "am force-stop '" + pkg + "' >/dev/null 2>&1";
+        system(cmd.c_str());
+    }
+    if (stopRa && isRetroArchRunning()) {
+        // RetroArch rewrites its config on exit: ask it to save and quit first (as a power-off
+        // does), and stop it only if it does not.
+        property_set("sys.gammaos.nano.drop_input", "0");
+        property_set("sys.gammaos.nano.overlay_esc", "1");
+        for (int i = 0; i < 50 && isRetroArchRunning(); i++) {
+            if (i == 10 || i == 25) property_set("sys.gammaos.nano.overlay_esc", "1");
+            usleep(100000);
+        }
+        if (isRetroArchRunning()) system("am force-stop com.retroarch.aarch64 >/dev/null 2>&1");
+    }
+    if (!stopPkgs.empty()) collect();
+    {
+        std::lock_guard<std::mutex> lk(mScrapeMutex);
+        mScrapeTotal = (int)items.size();
+        if (missingRequired > 0) {
+            mScrapeFail += missingRequired;
+            mScrapeError = trDyn("The current folder is missing. Is the SD card in?");
+        } else if (unreadable > 0) {
+            mScrapeFail += unreadable;
+            mScrapeError = trDyn("Some folders could not be read.");
+        }
+    }
+    for (auto& it : items) {
+        const FileCopyPair& pr = pairs[it.pair];
+        if (!pr.merged.empty() && std::find(pr.merged.begin(), pr.merged.end(), it.rel) != pr.merged.end()) {
+            it.result = 3;   // its data is in another file of the job
+            std::lock_guard<std::mutex> lk(mScrapeMutex);
+            mScrapeDone++;
+            continue;
+        }
+        const std::string src = it.rel.empty() ? pr.src : pr.src + "/" + it.rel;
+        const std::string dst = it.rel.empty() ? pr.dst : pr.dst + "/" + it.rel;
+        {
+            std::lock_guard<std::mutex> lk(mScrapeMutex);
+            if (mScrapeCancel) break;
+            mScrapeStatus = it.rel.empty() ? src.substr(src.find_last_of('/') + 1) : it.rel;
+        }
+        errno = 0;
+        struct stat st, sst;
+        int result;   // 0 copied, 1 already there, 2 failed
+        const bool exists = lstat(dst.c_str(), &st) == 0;
+        const bool checkAge = exists && pr.replaceOlder && S_ISREG(st.st_mode);
+        if (checkAge && stat(src.c_str(), &sst) != 0) {
+            result = 2;
+        } else if (exists && pr.move) {
+            // The very same file reached another way is never "moved" (that deletes it).
+            struct stat a, b;
+            const bool one = stat(rawStoragePath(src).c_str(), &a) == 0 && stat(rawStoragePath(dst).c_str(), &b) == 0
+                             && a.st_dev == b.st_dev && a.st_ino == b.st_ino;
+            if (one) result = 2;
+            else if (pr.overwrite) result = nanoCopyFile(src, dst) ? 0 : 2;
+            else result = S_ISREG(st.st_mode) && nanoSameFile(src, dst) ? 4 : 1;
+        } else if (exists && !pr.overwrite && !(checkAge && sst.st_mtime > st.st_mtime)) {
+            result = 1;
+        } else {
+            nanoMkdirs(dst.substr(0, dst.find_last_of('/')));
+            result = nanoCopyFile(src, dst) ? 0 : 2;
+            it.created = result == 0 && !exists;
+        }
+        const bool full = result == 2 && errno == ENOSPC;
+        it.result = result;
+        std::lock_guard<std::mutex> lk(mScrapeMutex);
+        mScrapeDone++;
+        if (result == 0 || result == 4) mScrapeHits++;
+        else if (result == 1) mScrapeSkip++;
+        else { mScrapeFail++; if (mScrapeError.empty()) mScrapeError = trDyn("Some files could not be copied."); }
+        if (full) {
+            mScrapeError = trDyn("The destination is full. The copy stopped.");
+            break;
+        }
+    }
+    bool clean;
+    { std::lock_guard<std::mutex> lk(mScrapeMutex); clean = !mScrapeCancel && mScrapeFail == 0; }
+    // A move: point each group's program at the copy, then take the originals away (the ones of
+    // a group whose program could not be pointed at it stay where they were). Once that starts the
+    // job can no longer be cancelled.
+    std::vector<FileConflict> conflicts;
+    std::vector<int> failedGroups;
+    bool backupFailed = false, dstMissing = false;
+    const bool anyMove = std::any_of(pairs.begin(), pairs.end(), [](const FileCopyPair& p) { return p.move; });
+    if (anyMove && !clean) {
+        // Cancelled or failed: the card gets back what it had (the files this job created there).
+        for (const auto& it : items) {
+            if (!it.created) continue;
+            const FileCopyPair& pr = pairs[it.pair];
+            unlink((it.rel.empty() ? pr.dst : pr.dst + "/" + it.rel).c_str());
+        }
+    }
+    if (clean && anyMove) {
+        { std::lock_guard<std::mutex> lk(mScrapeMutex); mFileJobCommitted = true; }
+        std::set<int> groups;
+        for (const auto& p : pairs) if (p.group >= 0) groups.insert(p.group);
+        for (int g : groups) {
+            { std::lock_guard<std::mutex> lk(mScrapeMutex); mScrapeStatus = trDyn("Updating settings..."); }
+            if (!fileJobRelocate(g)) { failedGroups.push_back(g); continue; }
+            // A folder its program has no setting for: set aside (emptied below like any original) and
+            // replaced by a link to its copy. Any of the group's links failing puts them all back.
+            std::vector<std::pair<size_t, std::string>> linked;   // pair, its original's own path
+            bool ok = true;
+            for (size_t i = 0; i < pairs.size() && ok; i++) {
+                if (pairs[i].group != g || pairs[i].linkTo.empty()) continue;
+                const std::string src = pairs[i].src;
+                ok = nanoLinkFolder(&pairs[i].src, pairs[i].linkTo);
+                if (ok) linked.emplace_back(i, src);
+            }
+            if (!ok) {
+                for (const auto& l : linked) {
+                    unlink(l.second.c_str());
+                    if (pairs[l.first].src != l.second) rename(pairs[l.first].src.c_str(), l.second.c_str());
+                    pairs[l.first].src = l.second;
+                }
+                failedGroups.push_back(g);
+            }
+        }
+        // A group left where it was: what this job put on the card for it goes, or a later move
+        // would keep it over newer originals.
+        for (const auto& it : items) {
+            const FileCopyPair& pr = pairs[it.pair];
+            if (it.created && std::find(failedGroups.begin(), failedGroups.end(), pr.group) != failedGroups.end())
+                unlink((it.rel.empty() ? pr.dst : pr.dst + "/" + it.rel).c_str());
+        }
+        { std::lock_guard<std::mutex> lk(mScrapeMutex); mScrapeStatus = trDyn("Removing moved files..."); }
+        sync();   // the copies are on the card before an original goes
+        auto skipped = [&](const FileCopyPair& pr) {
+            return !pr.move || std::find(failedGroups.begin(), failedGroups.end(), pr.group) != failedGroups.end();
+        };
+        std::set<std::string> written;   // what this job put on the card
+        for (const auto& it : items)
+            if (it.result == 0) written.insert(it.rel.empty() ? pairs[it.pair].dst : pairs[it.pair].dst + "/" + it.rel);
+        // The clashing originals to the backup first: if one cannot go there, nothing is deleted.
+        for (const auto& it : items) {
+            const FileCopyPair& pr = pairs[it.pair];
+            if (skipped(pr) || it.result != 1 || pr.backup.empty()) continue;
+            const std::string src = it.rel.empty() ? pr.src : pr.src + "/" + it.rel;
+            const std::string dst = it.rel.empty() ? pr.dst : pr.dst + "/" + it.rel;
+            std::string bak = it.rel.empty() ? pr.backup : pr.backup + "/" + it.rel;
+            nanoMkdirs(bak.substr(0, bak.find_last_of('/')));
+            struct stat bst;
+            if (lstat(bak.c_str(), &bst) == 0) {   // one there already (this job's, or an earlier one's): both kept
+                const size_t sl = bak.find_last_of('/'), dot = bak.find_last_of('.');
+                const bool hasExt = dot != std::string::npos && dot > sl + 1;
+                const std::string stem = hasExt ? bak.substr(0, dot) : bak, ext = hasExt ? bak.substr(dot) : "";
+                for (int n = 2; lstat(bak.c_str(), &bst) == 0; n++) bak = stem + " (" + std::to_string(n) + ")" + ext;
+            }
+            if (rename(src.c_str(), bak.c_str()) == 0 || (nanoCopyFile(src, bak) && unlink(src.c_str()) == 0)) {
+                conflicts.push_back({bak, dst, written.count(dst) > 0});
+            } else {
+                ALOGW("ps3menu: move: %s could not go to the backup folder", src.c_str());
+                backupFailed = true;
+                break;
+            }
+        }
+        if (!backupFailed) {
+            for (const auto& it : items) {
+                const FileCopyPair& pr = pairs[it.pair];
+                if (skipped(pr) || (it.result != 0 && it.result != 4)) continue;
+                const std::string src = it.rel.empty() ? pr.src : pr.src + "/" + it.rel;
+                struct stat st;   // its copy must still be on the card (pulled out meanwhile?)
+                if (lstat((it.rel.empty() ? pr.dst : pr.dst + "/" + it.rel).c_str(), &st) != 0) { dstMissing = true; continue; }
+                unlink(src.c_str());
+            }
+            // Merged originals last: once the file holding their data has gone to the card or the backup.
+            for (const auto& it : items) {
+                const FileCopyPair& pr = pairs[it.pair];
+                if (skipped(pr) || it.result != 3) continue;
+                if (!pr.mergedInto.empty() && access((pr.mergedInto + "/" + it.rel).c_str(), F_OK) == 0) { dstMissing = true; continue; }
+                unlink((it.rel.empty() ? pr.src : pr.src + "/" + it.rel).c_str());
+            }
+        }
+        // The folders left empty, the moved folder itself included.
+        std::function<bool(const std::string&)> prune = [&](const std::string& dir) -> bool {
+            DIR* d = opendir(dir.c_str());
+            if (!d) return false;
+            bool empty = true;
+            while (dirent* e = readdir(d)) {
+                if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+                const std::string full = dir + "/" + e->d_name;
+                struct stat st;
+                if (lstat(full.c_str(), &st) == 0 && S_ISDIR(st.st_mode) && prune(full)) continue;
+                empty = false;
+            }
+            closedir(d);
+            return empty && rmdir(dir.c_str()) == 0;
+        };
+        for (const auto& pr : pairs) {
+            struct stat st;
+            if (pr.move && std::find(failedGroups.begin(), failedGroups.end(), pr.group) == failedGroups.end()
+                && (pr.linkTo.empty() ? stat(pr.src.c_str(), &st) : lstat(pr.src.c_str(), &st)) == 0
+                && S_ISDIR(st.st_mode))   // a folder linked without one before is the link now: not into the card
+                prune(pr.src);
+        }
+    }
+    std::lock_guard<std::mutex> lk(mScrapeMutex);
+    if (!failedGroups.empty()) {
+        mScrapeFail += (int)failedGroups.size();
+        if (mScrapeError.empty()) mScrapeError = trDyn("Some programs could not be set to use the microSD card.");
+    }
+    if (backupFailed || dstMissing) {
+        mScrapeFail++;
+        if (mScrapeError.empty())
+            mScrapeError = backupFailed ? trDyn("Some files could not be put in the backup folder. Nothing was deleted.")
+                                        : trDyn("Some copies are missing from the microSD card. Their originals were kept.");
+    }
+    mFileJobConflicts = std::move(conflicts);
+    mFileJobFailedGroups = std::move(failedGroups);
+    mFileJobIncomplete = backupFailed || dstMissing;
+    mScrapeRunning = false;
+    mScrapeDoneFlag = true;
+}
+
+// Render thread, every frame: once a copy has finished, switch the folder it was copying for.
+// A cancelled copy leaves the setting as it was.
+void NanoMenu::fileJobTick() {
+    if (mFileJobKind == 0) return;
+    bool done, cancelled; int failed;
+    {
+        std::lock_guard<std::mutex> lk(mScrapeMutex);
+        done = mScrapeDoneFlag && !mScrapeRunning;
+        cancelled = mScrapeCancel && !mFileJobCommitted;   // a move past its copy finished anyway
+        failed = mScrapeFail;
+    }
+    if (!done) return;
+    const int kind = mFileJobKind;
+    mFileJobKind = 0;
+    if (kind >= 3) {   // a move to the microSD card (NanoSdMove.cpp)
+        sdMoveFinish(kind, cancelled, failed);
+        return;
+    }
+    if (cancelled) {
+        photoShowBanner(trDyn("Copy cancelled. The folder was not changed."));
+        return;
+    }
+    if (failed > 0) {   // switching would leave the files that failed behind
+        photoShowBanner(trDyn("Some files could not be copied. The folder was not changed."));
+        return;
+    }
+    if (kind == 1) esdeMediaFolderApply(mFileJobTo);
+}
+
+// ---------------------------------------------------------------------------
+// RetroArch Folder. RetroArch's settings file and the folders of the user's own setup live
+// either in RetroArch's defaults (its RetroArch folder on internal storage, its config in
+// Android/data, shaders/overlays/filters/controller profiles in its app folder) or together in
+// one chosen folder T: T/retroarch.cfg, T/system, T/saves, ..., T/shaders, T/overlays,
+// T/filters, T/autoconfig. Moving copies the files (keeping any already at the destination),
+// then rewrites the folder settings in RetroArch's config files to the new place.
+// ---------------------------------------------------------------------------
+
+namespace {
+const char* const kRaPkgData = "/data/user/0/com.retroarch.aarch64";
+const char* const kRaDefSd = "/storage/emulated/0/RetroArch";
+const char* const kRaDefCfgDir = "/storage/emulated/0/Android/data/com.retroarch.aarch64/files";
+// The folders kept in RetroArch's app folder by default (copied out, never back: the app
+// folder keeps its own copies, and files written there by nano would not belong to RetroArch).
+const char* const kRaAppParts[] = {"shaders", "overlays", "filters", "autoconfig"};
+
+std::string raPart(const std::string& loc, const char* part) {   // part "" = the RetroArch folder itself
+    if (loc.empty()) return *part ? std::string(kRaPkgData) + "/" + part : std::string(kRaDefSd);
+    return *part ? loc + "/" + part : loc;
+}
+std::string raCfgDir(const std::string& loc) { return loc.empty() ? std::string(kRaDefCfgDir) : loc; }
+
+// The folder settings every RetroArch config gets for location `loc`.
+std::vector<std::pair<std::string, std::string>> raDirKeys(const std::string& loc) {
+    const std::string sd = raPart(loc, "");
+    return {
+        {"system_directory", sd + "/system"},          {"savefile_directory", sd + "/saves"},
+        {"savestate_directory", sd + "/states"},       {"screenshot_directory", sd + "/screenshots"},
+        {"recording_output_directory", sd + "/recordings"}, {"recording_config_directory", sd + "/records_config"},
+        {"rgui_config_directory", sd + "/config"},     {"input_remapping_directory", sd + "/config/remaps"},
+        {"cheat_database_path", sd + "/cheats"},       {"playlist_directory", sd + "/playlists"},
+        {"thumbnails_directory", sd + "/thumbnails"},  {"core_assets_directory", sd + "/downloads"},
+        {"log_dir", sd + "/logs"},                     {"cache_directory", sd + "/temp"},
+        {"content_favorites_path", sd + "/playlists/builtin/content_favorites.lpl"},
+        {"content_history_path", sd + "/playlists/builtin/content_history.lpl"},
+        {"content_image_history_path", sd + "/playlists/builtin/content_image_history.lpl"},
+        {"content_music_history_path", sd + "/playlists/builtin/content_music_history.lpl"},
+        {"content_video_history_path", sd + "/playlists/builtin/content_video_history.lpl"},
+        {"video_shader_dir", raPart(loc, "shaders")},  {"overlay_directory", raPart(loc, "overlays")},
+        {"osk_overlay_directory", raPart(loc, "overlays") + "/keyboards"},
+        {"audio_filter_dir", raPart(loc, "filters") + "/audio"},
+        {"video_filter_dir", raPart(loc, "filters") + "/video"},
+        {"joypad_autoconfig_dir", raPart(loc, "autoconfig")},
+    };
+}
+
+// Old path prefix -> new, longest first, for every path in a config or shader preset (an
+// overlay or shader picked from the old folder).
+std::vector<std::pair<std::string, std::string>> raPrefixMap(const std::string& from, const std::string& to) {
+    std::vector<std::pair<std::string, std::string>> m;
+    for (const char* part : kRaAppParts) {
+        // Back to the defaults, a folder's files land in the RetroArch folder (T/shaders ->
+        // RetroArch/shaders), not RetroArch's app folder.
+        const std::string dst = to.empty() && !from.empty() ? std::string(kRaDefSd) + "/" + part : raPart(to, part);
+        m.push_back({raPart(from, part), dst});
+        if (from.empty()) m.push_back({std::string("/data/data/com.retroarch.aarch64/") + part, dst});
+    }
+    m.push_back({raPart(from, ""), raPart(to, "")});
+    std::sort(m.begin(), m.end(), [](const auto& a, const auto& b) { return a.first.size() > b.first.size(); });
+    return m;
+}
+
+// Rewrites a RetroArch config/preset in place: every quoted path under an old prefix moves to the
+// new one, and (forceKeys) the folder settings are set to the new location.
+bool raRewriteFile(const std::string& path, const std::vector<std::pair<std::string, std::string>>& map,
+                   const std::vector<std::pair<std::string, std::string>>* forceKeys) {
+    FILE* f = fopen(path.c_str(), "re");
+    if (!f) return false;
+    std::vector<std::string> lines;
+    char buf[4096];
+    while (fgets(buf, sizeof(buf), f)) {
+        std::string l = buf;
+        while (!l.empty() && (l.back() == '\n' || l.back() == '\r')) l.pop_back();
+        lines.push_back(l);
+    }
+    fclose(f);
+    std::set<std::string> seen;
+    bool changed = false;
+    for (auto& l : lines) {
+        size_t q1 = l.find('"'), q2 = l.rfind('"');
+        if (q1 == std::string::npos || q2 <= q1) continue;
+        std::string v = l.substr(q1 + 1, q2 - q1 - 1);
+        for (const auto& pm : map) {
+            if (v == pm.first || v.compare(0, pm.first.size() + 1, pm.first + "/") == 0) {
+                v = pm.second + v.substr(pm.first.size());
+                break;
+            }
+        }
+        if (forceKeys) {   // an empty folder setting gets the new folder; the user's own paths stay
+            size_t eq = l.find('=');
+            std::string key = l.substr(0, eq == std::string::npos ? 0 : eq);
+            while (!key.empty() && key.back() == ' ') key.pop_back();
+            for (const auto& fk : *forceKeys)
+                if (key == fk.first) { seen.insert(key); if (v.empty() || v == "default") v = fk.second; }   // "default": RetroArch's folder, the one moved
+        }
+        const std::string nl = l.substr(0, q1 + 1) + v + l.substr(q2);
+        if (nl != l) { l = nl; changed = true; }
+    }
+    if (forceKeys)
+        for (const auto& fk : *forceKeys)
+            if (!seen.count(fk.first)) { lines.push_back(fk.first + " = \"" + fk.second + "\""); changed = true; }
+    if (!changed) return true;
+    const std::string tmp = path + ".nanotmp";
+    FILE* o = fopen(tmp.c_str(), "we");
+    if (!o) return false;
+    for (const auto& l : lines) fprintf(o, "%s\n", l.c_str());
+    if (fclose(o) != 0 || rename(tmp.c_str(), path.c_str()) != 0) { unlink(tmp.c_str()); return false; }
+    return true;
+}
+
+void raRewriteTree(const std::string& dir, const std::vector<std::pair<std::string, std::string>>& map) {
+    DIR* d = opendir(dir.c_str());
+    if (!d) return;
+    while (dirent* e = readdir(d)) {
+        if (e->d_name[0] == '.') continue;
+        const std::string full = dir + "/" + e->d_name;
+        struct stat st;
+        if (lstat(full.c_str(), &st) != 0) continue;
+        if (S_ISDIR(st.st_mode)) { raRewriteTree(full, map); continue; }
+        const char* ext = strrchr(e->d_name, '.');
+        if (ext && (!strcasecmp(ext, ".cfg") || !strcasecmp(ext, ".slangp") || !strcasecmp(ext, ".glslp")
+                    || !strcasecmp(ext, ".cgp")))
+            raRewriteFile(full, map, nullptr);
+    }
+    closedir(d);
+}
+}  // namespace
+
+std::string NanoMenu::rawStoragePath(const std::string& p) {
+    const std::string emu = "/storage/emulated/0";
+    if (p == emu || p.compare(0, emu.size() + 1, emu + "/") == 0) return "/data/media/0" + p.substr(emu.size());
+    if (p.compare(0, 9, "/storage/") == 0 && p.compare(0, 14, "/storage/self/") != 0) return "/mnt/media_rw/" + p.substr(9);
+    return p;
+}
+
+std::string NanoMenu::retroarchDirRaw() {
+    char d[PROPERTY_VALUE_MAX] = {};
+    property_get("persist.gammaos.retroarch.dir", d, "");
+    return d[0] == '/' ? rawStoragePath(d) : std::string();
+}
+
+std::string NanoMenu::retroarchConfigFile() {
+    char d[PROPERTY_VALUE_MAX] = {};
+    property_get("persist.gammaos.retroarch.dir", d, "");
+    if (d[0] == '/') {
+        const std::string cfg = std::string(d) + "/retroarch.cfg";
+        if (access(cfg.c_str(), R_OK) == 0) return cfg;
+    }
+    return std::string(kRaDefCfgDir) + "/retroarch.cfg";   // default, or the card is not in
+}
+
+// Move Emulator Files: RetroArch's folder moves to `to`; its app-folder parts and default config
+// are copied (RetroArch keeps its own, the rewrite points them at the new folder).
+void NanoMenu::retroarchMovePairs(const std::string& to, const std::string& backup, int group,
+                                  std::vector<FileCopyPair>* pairs) {
+    char cur[PROPERTY_VALUE_MAX] = {};
+    property_get("persist.gammaos.retroarch.dir", cur, "");
+    const std::string from = cur[0] == '/' ? std::string(cur) : std::string();
+    mFileJobFrom = from;
+    mFileJobTo = to;
+    FileCopyPair main{raPart(from, ""), raPart(to, ""), false, !from.empty()};
+    main.move = true;
+    main.backup = backup;
+    main.group = group;
+    pairs->push_back(main);
+    if (from.empty()) {
+        for (const char* part : kRaAppParts) {
+            FileCopyPair p{raPart(from, part), raPart(to, part)};
+            p.group = group;
