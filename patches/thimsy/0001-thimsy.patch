+// The touchscreen's mounting, as main.cpp's DS touch and Nano's touchMapRaw read it: quarter turns to
+// undo from ro.input_flinger.primary_touch_orientation (the RG Cube's digitizer is ORIENTATION_90)
+// when no osk_touch calibration is on; persist.gammaos.nano.touch_orientation overrides it.
+static int touchMountRot() {
+    static const int rot = [] {
+        char v[PROPERTY_VALUE_MAX] = {};
+        if (property_get("persist.gammaos.nano.touch_orientation", v, "") > 0) return (atoi(v) / 90) & 3;
+        if (property_get_bool("persist.gammaos.nano.osk_touch_swap", false)
+            || property_get_bool("persist.gammaos.nano.osk_touch_flipx", false)
+            || property_get_bool("persist.gammaos.nano.osk_touch_flipy", false)
+            || property_get_bool("persist.gammaos.drastic_nano.osk_touch_flipx", false)
+            || property_get_bool("persist.gammaos.drastic_nano.osk_touch_flipy", false)
+            || property_get("ro.input_flinger.primary_touch_orientation", v, "") <= 0)
+            return 0;
+        return !strcmp(v, "ORIENTATION_90") ? 1 : !strcmp(v, "ORIENTATION_180") ? 1
+             : !strcmp(v, "ORIENTATION_270") ? 3 : 0;
+    }();
+    return rot;
+}
+static void touchUnmount(float& nx, float& ny) {
+    switch (touchMountRot()) {
+    case 1: { float t = nx; nx = ny;        ny = 1.0f - t; break; }
+    case 2: {               nx = 1.0f - nx; ny = 1.0f - ny; break; }
+    case 3: { float t = nx; nx = 1.0f - ny; ny = t;        break; }
+    default: break;
+    }
+}
