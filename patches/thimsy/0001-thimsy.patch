+                    [&](const std::string& from, const std::string& to, int depth) {
+                    if (depth > 8) return;
+                    DIR* d = opendir(from.c_str());
+                    if (!d) return;
+                    std::vector<std::string> names;
+                    while (dirent* e = readdir(d)) if (strcmp(e->d_name, ".") && strcmp(e->d_name, "..")) names.push_back(e->d_name);
