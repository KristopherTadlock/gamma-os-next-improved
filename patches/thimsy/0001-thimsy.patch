+// The network wizard's rows (choosers, scan lists): a drag moves the selection, a tap on a row
+// picks it and confirms, like Cross.
+void NanoMenu::wizTouchList(const TouchRect& area, float left, float width, float top, float pitch,
+                            int first, int last, int n) {
+    const int id = mPs3WizId;
+    mTouch.scroll(area, TouchZones::kUpDown, fmaxf(1.0f, pitch), [this, id, n](int dir) {
+        if (!mPs3WizActive || mPs3WizId != id || mPs3WizSel + dir < 0 || mPs3WizSel + dir >= n) return false;
+        wizNav(dir, false);
+        return true;
+    });
+    for (int i = first; i <= last; i++) wizTouchRow({left, top + pitch * (float)(i - first), width, pitch}, i);
+}
+
+void NanoMenu::wizTouchRow(const TouchRect& r, int idx) {
+    const int id = mPs3WizId;
+    mTouch.tap(r, [this, id, idx]() {
+        if (!mPs3WizActive || mPs3WizId != id || mOskActive) return;
+        mPs3WizSel = idx;
+        wizConfirm();
+        mDisplayDirty = true;
+    });
+}
