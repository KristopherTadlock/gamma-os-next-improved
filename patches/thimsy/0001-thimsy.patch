 // with the battery percent as text and a rounded background plate.
+// A <clock>: the time in the element's strftime format (DateTimeComponent), one line seated on
+// its pos by its origin, on the theme's plate.
+void NanoMenu::esdeDrawClock(const nanoesde::Element* e) {
+    std::string fmt = e->getS("format", std::string());
+    if (fmt.empty()) fmt = "%H:%M";
+    time_t now = time(nullptr); struct tm lt; localtime_r(&now, &lt);
+    char out[64] = {0};
+    if (strftime(out, sizeof(out), fmt.c_str(), &lt) == 0) out[0] = 0;
+    std::string s = out;
+    esdeLetterCase(s, e->getS("letterCase", std::string()));
+    if (s.empty()) return;
+    float c[4];
+    if (!e->getColor("color", c)) { c[0] = c[1] = c[2] = c[3] = 1.0f; }
+    c[3] *= e->getF("opacity", 1.0f);
+    const float sc = e->getF("fontSize", 0.033f) * (float)std::min(mWidth, mHeight) / (float)FONT_CHAR_H;
+    const int face = esdeFontFace(e->getPath("fontPath"));
+    float w = e->getPair("size", 0, 0.0f), h = e->getPair("size", 1, 0.0f);
+    if (w <= 0.0f && h <= 0.0f) w = e->getPair("maxSize", 0, 0.0f);
+    w *= mWidth;
+    const float ox = e->getPair("origin", 0, 0.0f), oy = e->getPair("origin", 1, 0.0f);
+    const float tw = measureText(s.c_str(), sc), th = sc * FONT_CHAR_H;
+    float x = e->getPair("pos", 0, 0.0f) * mWidth - ox * w;
+    if (w <= 1.0f && ox != 0.0f) x -= ox * tw;
+    const float y = e->getPair("pos", 1, 0.0f) * mHeight - oy * th;
+    esdeDrawPlate(e, x, y, tw, th);
+    const std::string& align = e->getS("horizontalAlignment", std::string());
+    const float dw = measureText(s.c_str(), sc, face);
+    float tx = x;
+    if (align == "center") tx = x + (w - dw) * 0.5f;
+    else if (align == "right") tx = x + (w - dw);
+    drawText(s.c_str(), tx, y, sc, c[0], c[1], c[2], c[3], face);
