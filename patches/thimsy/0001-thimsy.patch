+    <string name="title_launch_guard">Thimsy Launch Guard</string>
     <string name="launch_guard_toggle_label">تفعيل Launch Guard</string>
     <string name="launch_guard_toggle_summary">عند التفعيل، سيقوم النظام بإيقاف التطبيقات المستهدفة المحددة بالقوة عند تشغيلها من تطبيقات الاستدعاء المحددة. يمكن أن يحل هذا مشكلة تعطل المحاكي عند إعادة تشغيل تطبيق لا يزال قيد التشغيل.</string>
     <string name="callers_section_title">تطبيقات الاستدعاء</string>
diff --git a/packages/apps/LaunchGuardControl/res/values-de/strings.xml b/packages/apps/LaunchGuardControl/res/values-de/strings.xml
index 8f4d98181cb..6477d36d7e5 100644
--- a/packages/apps/LaunchGuardControl/res/values-de/strings.xml
+++ b/packages/apps/LaunchGuardControl/res/values-de/strings.xml
@@ -1,6 +1,6 @@
 <?xml version="1.0" encoding="utf-8"?>
 <resources>
-    <string name="title_launch_guard">GammaOS Launch Guard</string>
+    <string name="title_launch_guard">Thimsy Launch Guard</string>
     <string name="launch_guard_toggle_label">Launch Guard aktivieren</string>
     <string name="launch_guard_toggle_summary">Wenn aktiviert, werden ausgewählte Ziel-Apps beim Start durch ausgewählte Aufrufer-Apps zwangsgestoppt. Dies kann Abstürze des Emulators vermeiden, wenn eine App erneut gestartet wird, während sie noch läuft.</string>
     <string name="callers_section_title">Aufrufer-Apps</string>
diff --git a/packages/apps/LaunchGuardControl/res/values-es/strings.xml b/packages/apps/LaunchGuardControl/res/values-es/strings.xml
index ec280a5a522..b5ab3938d25 100644
--- a/packages/apps/LaunchGuardControl/res/values-es/strings.xml
+++ b/packages/apps/LaunchGuardControl/res/values-es/strings.xml
@@ -1,6 +1,6 @@
 <?xml version="1.0" encoding="utf-8"?>
 <resources>
-    <string name="title_launch_guard">GammaOS Launch Guard</string>
+    <string name="title_launch_guard">Thimsy Launch Guard</string>
     <string name="launch_guard_toggle_label">Activar Launch Guard</string>
     <string name="launch_guard_toggle_summary">Cuando está activado, el sistema detendrá forzosamente las apps objetivo seleccionadas cuando se lancen desde las apps llamadoras seleccionadas. Esto puede solucionar bloqueos del emulador cuando una app se relanza mientras aún se está ejecutando.</string>
     <string name="callers_section_title">Apps llamadoras</string>
diff --git a/packages/apps/LaunchGuardControl/res/values-fr/strings.xml b/packages/apps/LaunchGuardControl/res/values-fr/strings.xml
index 0688e7f53e5..c39723bf443 100644
--- a/packages/apps/LaunchGuardControl/res/values-fr/strings.xml
+++ b/packages/apps/LaunchGuardControl/res/values-fr/strings.xml
@@ -1,6 +1,6 @@
 <?xml version="1.0" encoding="utf-8"?>
 <resources>
-    <string name="title_launch_guard">GammaOS Launch Guard</string>
+    <string name="title_launch_guard">Thimsy Launch Guard</string>
     <string name="launch_guard_toggle_label">Activer Launch Guard</string>
     <string name="launch_guard_toggle_summary">Lorsqu\'il est activé, le système force l\'arrêt des applications cibles sélectionnées lorsqu\'elles sont lancées depuis les applications appelantes sélectionnées. Cela peut résoudre les plantages de l\'émulateur lorsqu\'une application est relancée alors qu\'elle est encore en cours d\'exécution.</string>
     <string name="callers_section_title">Applications appelantes</string>
diff --git a/packages/apps/LaunchGuardControl/res/values-it/strings.xml b/packages/apps/LaunchGuardControl/res/values-it/strings.xml
index 7fbfd8b41fe..d5b5c1087d4 100644
--- a/packages/apps/LaunchGuardControl/res/values-it/strings.xml
+++ b/packages/apps/LaunchGuardControl/res/values-it/strings.xml
@@ -1,6 +1,6 @@
 <?xml version="1.0" encoding="utf-8"?>
 <resources>
-    <string name="title_launch_guard">GammaOS Launch Guard</string>
+    <string name="title_launch_guard">Thimsy Launch Guard</string>
     <string name="launch_guard_toggle_label">Attiva Launch Guard</string>
     <string name="launch_guard_toggle_summary">Se attivato, il sistema forzerà la chiusura delle app bersaglio selezionate quando vengono avviate dalle app chiamanti selezionate. Questo può risolvere i crash dell\'emulatore quando un\'app viene riavviata mentre è ancora in esecuzione.</string>
     <string name="callers_section_title">App chiamanti</string>
diff --git a/packages/apps/LaunchGuardControl/res/values-ja/strings.xml b/packages/apps/LaunchGuardControl/res/values-ja/strings.xml
