+// Anbernic + Start: the Applications view from any home state. Dialogs, option menus, choosers, the
+// global search, the ES-DE menu and overlays and the Wi-Fi / Bluetooth screens close; the setup,
+// the keyboard and the media players keep it from opening.
+void NanoMenu::openApplicationsView() {
+    if (mSetupWizardActive || mPs3WizActive || mPs3TzActive || mPs3LangActive || mOskActive
+        || mVidActive || mMpActive || mPvActive || mPhotoMultiActive || mScrapeProgActive
+        || ps3TopScreenKind() == PHOTO_GRID || mPspClockOn || mPspClockReveal > 0.0f) return;
+    mAppsSummoned = false;   // opened here; overlayShow sets it again when it raised the overlay for it
+    if (mPs3OptActive) closeXmbOpt();
+    if (mPs3DlgActive) closePs3Dialog(false);
+    if (mPs3DlgActive || mPs3OptActive) return;   // a dialog that must stay up
+    if (mGSearchActive) gsearchClose();
+    if (mMpPlChooserActive) mpPlChooserCancel();
+    if (mPvPlChooserActive) pvPlChooserCancel();
+    if (mVidPlChooserActive) vidPlChooserCancel();
+    esdeOverlayCloseAll();
+    if (esdeMenuInContext()) {
+        mEsdeMenuReturn = false;
+        mPs3Stack.clear();
+        mEsdeMenuActive = false; mEsdeMenuClosing = false; mEsdeMenuAnim = 0.0f;
+    }
+    if (mMenuState == MENU_WIFI) closeWifiScreen();
+    else if (mMenuState == MENU_BT) closeBtScreen();
+    if (!mPs3MenuBuilt) initPs3Menu();
+    mAppsReturn.valid = true;
+    mAppsReturn.stack = mPs3Stack;
+    mAppsReturn.cat = mPs3CatIdx; mAppsReturn.item = mPs3ItemIdx;
+    if (mPs3CatIdx >= 0 && mPs3CatIdx < (int)mPs3Cats.size()
+        && mPs3ItemIdx >= 0 && mPs3ItemIdx < (int)mPs3Cats[mPs3CatIdx].items.size()) {
+        mAppsReturn.itemKind = mPs3Cats[mPs3CatIdx].items[mPs3ItemIdx].kind;
+        mAppsReturn.itemLabel = mPs3Cats[mPs3CatIdx].items[mPs3ItemIdx].label;
+    }
+    mAppsReturn.atRoot = mNdsAtRoot; mAppsReturn.camera = mNdsCamera;
+    mPs3Stack.clear();
+    mPs3BrightSlider = false;
+    mMenuState = MENU_MAIN;
+    // The XMB, DSi and Minima homes reach Applications from a category: land on its row there.
+    if (!mEsdeTheme && !mEsdeSettingsMinima) {
+        for (int c = 0; c < (int)mPs3Cats.size(); c++) {
+            const std::vector<Ps3Item>& items = mPs3Cats[c].items;
+            auto it = std::find_if(items.begin(), items.end(), [](const Ps3Item& i) { return i.kind == PS3_APP_LIST; });
+            if (it == items.end()) continue;
+            mAppsReturn.appCat = c;
+            mAppsReturn.appCatSel = mPs3CatItemSel[c];
+            mPs3CatIdx = c;
+            mPs3ItemIdx = (int)(it - items.begin());
+            mPs3CatItemSel[mPs3CatIdx] = mPs3ItemIdx;
+            mPs3AnimItem = (float)mPs3ItemIdx; mPs3ItemAnimStart = -1.0f;
+            mPs3CatAnimActive = false; mPs3CatT = 1.0f; mPs3CatFromOffset = 0.0f;
+            break;
+        }
+        mNdsAtRoot = false;
+    }
+    mPs3SubAnimStart = -1.0f;
+    Ps3Level lvl; buildAppSubmenu(lvl); mPs3Stack.push_back(lvl);
+    mNdsCamera = (float)ndsFocusSel(); mNdsScrubbing = false; mNdsFlingVel = 0.0f;
+    esdeApplySettingsTheme();
+    ps3Sfx(PS3_SFX_OK);
+    mDisplayDirty = true;
+}
