+// Two fingers put down and lifted together, without moving: the Quick Menu opens or closes, as with
+// the Anbernic button. The first finger's press is dropped once the second lands, so it taps nothing.
+void NanoMenu::twoFingerTapFrame() {
+    // Typing with two thumbs puts two fingers down: each key still types.
+    if (mOskActive || mSetupWizardActive) { mTwoTap = false; return; }
+    const int64_t now = android::uptimeMillis();
+    if (mTouchId[0] >= 0 && mTouchId[1] >= 0 && !mTwoTap) {
+        mTwoTap = true; mTwoTapMoved = false; mTwoTapMs = now;
+        for (int i = 0; i < 2; i++) { mTwoTapX[i] = mTouchSX[i]; mTwoTapY[i] = mTouchSY[i]; }
+        mTouch.cancel();
+    }
+    if (!mTwoTap) return;
+    const int rx = std::max(1, mTouchMaxX - mTouchMinX), ry = std::max(1, mTouchMaxY - mTouchMinY);
+    for (int i = 0; i < 2; i++) {
+        if (mTouchId[i] >= 0 && (std::abs(mTouchSX[i] - mTwoTapX[i]) * 25 > rx
+                                 || std::abs(mTouchSY[i] - mTwoTapY[i]) * 25 > ry))
+            mTwoTapMoved = true;   // a pinch or a two-finger drag
+    }
+    if (mTouchId[0] >= 0 || mTouchId[1] >= 0) return;
+    mTwoTap = false;
+    if (!mTwoTapMoved && now - mTwoTapMs < 500) quickMenuButtonReleased();
+}
