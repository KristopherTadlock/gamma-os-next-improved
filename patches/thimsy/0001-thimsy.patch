+// Kiosk Mode changed: its row moves (first while on, last while off), wherever the Quick Menu is
+// shown - the category, and the ES-DE home's pushed copy of it - with the cursor kept on it.
+void NanoMenu::quickMenuRefresh() {
+    if (mPs3QuickCatIdx < 0 || mPs3QuickCatIdx >= (int)mPs3Cats.size()) return;
+    std::vector<Ps3Item> items;
+    buildQuickMenuItems(items);
+    int kioskRow = 0;
+    for (size_t i = 0; i < items.size(); i++)
+        if (items[i].label.compare(0, 10, "Kiosk Mode") == 0) kioskRow = (int)i;
+    auto onKiosk = [](const std::vector<Ps3Item>& v, int sel) {
+        return sel >= 0 && sel < (int)v.size() && v[sel].label.compare(0, 10, "Kiosk Mode") == 0;
+    };
+    Ps3Cat& qc = mPs3Cats[mPs3QuickCatIdx];
+    int& catSel = mPs3CatItemSel[mPs3QuickCatIdx];
+    const bool catOn = onKiosk(qc.items, mPs3CatIdx == mPs3QuickCatIdx ? mPs3ItemIdx : catSel);
+    qc.items = items;
+    if (catOn) catSel = kioskRow;
+    if (catSel >= (int)items.size()) catSel = items.empty() ? 0 : (int)items.size() - 1;
+    if (mPs3CatIdx == mPs3QuickCatIdx) {
+        mPs3ItemIdx = catSel;
+        mPs3AnimItem = (float)catSel; mPs3ItemAnimStart = -1.0f;
+    }
+    for (auto& lvl : mPs3Stack) {
+        if (lvl.title != "Quick Menu") continue;
+        const bool on = onKiosk(lvl.items, lvl.sel);
+        lvl.items = items;
+        if (on) lvl.sel = kioskRow;
+        if (lvl.sel >= (int)items.size()) lvl.sel = items.empty() ? 0 : (int)items.size() - 1;
+    }
+    mDisplayDirty = true;
+}
