+                break;
+            }
+            case SLOT_AZAHAR: { std::string prefs, uri; sdReadPrefs(kAzaharPrefs, &prefs); const std::string a = azaharDir(prefs, &uri); if (!a.empty()) b = rawStoragePath(a); break; }
