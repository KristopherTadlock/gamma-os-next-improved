+            }
+            if (!m.src.empty()) matches.push_back(std::move(m));
+        }
+    }
+    std::stable_sort(matches.begin(), matches.end(), [](const BiosMatch& a, const BiosMatch& b) { return a.file < b.file; });
+
+    // ---- 2. where each goes ----
+    std::string raSys, scummExtra;
+    bool raSysDone = false, scummSetPath = false;
+    std::map<int, std::string> baseCache;
+    auto base = [&](int kind) -> std::string {
+        auto it = baseCache.find(kind);
+        if (it != baseCache.end()) return it->second;
+        std::string b;
+        switch (kind) {
+            case SLOT_RA: case SLOT_RA_FOLDER: {
+                if (!raSysDone) {
+                    raSysDone = true;
+                    std::string text, v;
+                    sdReadFile(rawStoragePath(raConfig), &text);
+                    for (size_t pos = 0; pos < text.size();) {
+                        size_t end = text.find('\n', pos);
+                        if (end == std::string::npos) end = text.size();
+                        const std::string line = text.substr(pos, end - pos);
+                        pos = end + 1;
+                        const size_t eq = line.find('=');
+                        if (eq == std::string::npos || sdTrimDir(line.substr(0, eq)) != "system_directory") continue;
+                        v = sdTrimDir(line.substr(eq + 1));
+                    }
+                    if (v.empty() || v == "default" || v[0] != '/') v = kRaDefSystem;
+                    raSys = rawStoragePath(v);
+                }
+                b = raSys;
+                break;
+            }
+            case SLOT_ARMSX2: b = kArmsx2Bios; break;
+            case SLOT_DOLPHIN_GC: b = kDolphinGc; break;
+            case SLOT_FLYCAST: { std::string prefs; const std::string h = flycastHome(&prefs); if (!h.empty()) b = rawStoragePath(h) + "/data"; break; }
+            case SLOT_DRASTIC: {
+                std::string d = sdTrimDir(drasticSystemDir());
+                if (!d.empty()) b = rawStoragePath(d) + "/system";
+                break;
+            }
+            case SLOT_DRASTIC_NANO: b = kDrasticNanoSys; break;
+            case SLOT_MUPEN: b = kMupenFiles; break;
+            case SLOT_PPSSPP_FONT: {
+                const std::string ms = ppssppMemstick();
+                if (!ms.empty()) b = rawStoragePath(ms) + (strcasecmp(baseName(ms).c_str(), "PSP") == 0 ? "" : "/PSP") + "/flash0/font";
