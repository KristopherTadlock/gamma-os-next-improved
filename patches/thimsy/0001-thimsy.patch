+namespace gammapad {
+
+// The browser controller profile (Brave, Fulguris). While a browser package
+// (persist.gammaos.gamepad.browser_pkgs) is in front, Controller Bindings are on
+// (sys.gammaos.bindings.enabled) and Nano's overlay is not up, the controller drives a mouse and
+// the browser's keyboard shortcuts instead of reaching the browser as a gamepad, so the browser's
+// own controller handling never sees it. Every action also has a button-only form (Select
+// combos and cursor mode) for devices without thumbsticks. Start + Select held together passes
+// through to the virtual gamepad for the system hotkeys; the Anbernic button (Mode, or F10 on the
+// RG Cube) always does, with the buttons pressed while it is held, and so does any key that is not
+// one of the pad's buttons (a Back key).
+class BrowserMode {
+public:
+    using ToastCallback = std::function<void(const std::string&)>;
+
+    BrowserMode();
+    ~BrowserMode();
+
+    // Creates the tick timer. Returns its fd for the epoll loop, or -1.
+    int init();
+    int timerFd() const { return mTimerFd; }
+    void setToastCallback(ToastCallback cb) { mToast = std::move(cb); }
+
+    // Re-checks the foreground package (sys.gammaos.gamepad.fg_pkg) against the browsers and
+    // Nano's overlay. Cheap enough for every input batch. Returns true when the profile switched
+    // on or off; switching on queues releases for the virtual gamepad (getPadEvents) so the
+    // browser sees no button held.
+    bool update(bool bindingsEnabled);
+    // A pad went away: let go of everything held through it.
+    void inputLost();
+    bool isActive() const { return mActive; }
+
+    // A transformed event. True when the profile consumed it, false when it goes to the
+    // virtual gamepad.
+    bool processEvent(const struct input_event& ev);
+
+    // Timer: cursor movement, scrolling.
+    void tick();
+
+    // Events for the virtual gamepad (the releases on activation, a Start + Select chord).
+    const std::vector<struct input_event>& getPadEvents() const { return mPadEvents; }
+    void clearPadEvents() { mPadEvents.clear(); }
+
+private:
+    void activate();
+    void deactivate();
+    void resetInput();
+    void trackDpadButton(int code, bool pressed);
+    void releaseOutputs();
+    void startTimer(bool on);
+    void padEvent(int type, int code, int value);
+    void startChord();
+    void endChord();
+    void trackAxis(int code, int value);
+    void toast(const std::string& msg);
+
+    void onButton(int code, bool pressed);
+    void onAxis(int code, int value);
+    void refreshArrows();
+    void refreshMouseButtons();
+    void shortcut(std::initializer_list<int> keys);
+
+    bool mActive = false;
+    bool mUnavailable = false;   // the mouse or keyboard could not be created
+    bool mCursorMode = false;
+    int mTimerFd = -1;
+    ToastCallback mToast;
+    std::unique_ptr<VirtualMouse> mMouse;
+    std::unique_ptr<VirtualKeyboard> mKeyboard;
+    std::vector<struct input_event> mPadEvents;
+
+    // Axis codes of the virtual gamepad's layout (persist.gammaos.gamepad.device_pid).
+    android::base::CachedProperty mFgPkgProp{"sys.gammaos.gamepad.fg_pkg"};
+    android::base::CachedProperty mPkgsProp{"persist.gammaos.gamepad.browser_pkgs"};
+    android::base::CachedProperty mOverlayProp{"sys.gammaos.nano.show_overlay"};
+    bool mMatchValid = false;
+    bool mIsBrowser = false;    // the foreground package is one of the browsers
+    int mBookmarkKey = KEY_D;   // with Ctrl, for the browser in front
+    int mRxCode = ABS_Z, mRyCode = ABS_RZ, mLtCode = ABS_BRAKE, mRtCode = ABS_GAS;
+
+    // What each held button does when it is let go. Buttons held when the profile switched on
+    // have no entry, so their release is ignored.
+    std::unordered_map<int, std::function<void()>> mRelease;
+    // Buttons pressed on the virtual gamepad (during a Start + Select chord); their releases go
+    // there too.
+    std::unordered_set<int> mPadDown;
+    bool mSelectHeld = false, mSelectUsed = false;
+    bool mStartHeld = false;
+    bool mChord = false;
+    bool mModeHeld = false;   // the Anbernic button: the buttons pressed with it are its hotkeys
+    bool mLtBlock = false, mRtBlock = false;   // a trigger held through an Anbernic hotkey, until let go
+
+    int mLX = 0, mLY = 0, mRX = 0, mRY = 0;
+    int mHatX = 0, mHatY = 0;
+    int mDpadBtns = 0;   // BTN_DPAD_* held, bit (code - BTN_DPAD_UP)
+    int mArrowX = 0, mArrowY = 0;   // arrow keys held
+    std::chrono::steady_clock::time_point mHatSince;
+    bool mLtBtn = false, mRtBtn = false, mLtAxis = false, mRtAxis = false;
+    bool mCursorA = false, mCursorX = false;   // cursor mode clicks
+    bool mLeftDown = false, mRightDown = false, mBackDown = false;
+    float mAccX = 0, mAccY = 0, mScrollX = 0, mScrollY = 0;
+};
+
+} // namespace gammapad
