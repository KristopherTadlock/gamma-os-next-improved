+struct NanoMenu::EsdeArtResult {
+    std::string key;
+    uint64_t ticket = 0;
+    bool svg = false;
+    bool cancelled = false;   // dropped from a full queue before it was decoded
+    EsdeArtPixels px;
+};
+
+// Newest request first (the focused carousel item is drawn last). The queue and the finished
+// results are bounded; a full queue drops its oldest job, reported as cancelled so the render thread
+// asks again if it still draws it. cancelAll bumps the epoch, so a decode already running when the
+// cache was cleared is thrown away instead of delivered.
+struct NanoMenu::EsdeArtPool {
+    struct Job { std::string key, path; uint64_t ticket = 0; bool svg = false; int boxW = 0, boxH = 0; };
+    static constexpr size_t kMaxQueued = 64;
+    const size_t kMaxDoneBytes = esdeArtDoneBudget();
+
+    std::mutex mu;
+    std::condition_variable cv;
+    std::deque<Job> queue;
+    std::vector<EsdeArtResult> done;
+    size_t doneBytes = 0;
+    uint64_t epoch = 0;
+    bool stop = false;
+    std::vector<std::thread> threads;
+    std::atomic<int> decodes{0};
+    std::atomic<int64_t> decodeUs{0};
+
+    explicit EsdeArtPool(int n) {
+        for (int i = 0; i < n; i++) threads.emplace_back([this] { run(); });
+    }
+    ~EsdeArtPool() {
+        {
+            std::lock_guard<std::mutex> lk(mu);
+            stop = true;
+            queue.clear();
+            done.clear();
+        }
+        cv.notify_all();
+        for (auto& t : threads) if (t.joinable()) t.join();
+    }
+    void submit(Job&& j) {
+        {
+            std::lock_guard<std::mutex> lk(mu);
+            if (queue.size() >= kMaxQueued) {
+                EsdeArtResult c;
+                c.key = std::move(queue.front().key);
+                c.ticket = queue.front().ticket;
+                c.cancelled = true;
+                done.push_back(std::move(c));
+                queue.pop_front();
+            }
+            queue.push_back(std::move(j));
+        }
+        cv.notify_all();
+    }
+    void cancelAll() {
+        {
+            std::lock_guard<std::mutex> lk(mu);
+            queue.clear();
+            done.clear();
+            doneBytes = 0;
+            epoch++;
+        }
+        cv.notify_all();
+    }
+    bool take(const std::string& key, uint64_t ticket, EsdeArtResult* out) {
+        std::lock_guard<std::mutex> lk(mu);
+        for (size_t i = 0; i < done.size(); i++) {
+            if (done[i].ticket != ticket || done[i].key != key) continue;
+            doneBytes -= done[i].px.rgba.size();
+            *out = std::move(done[i]);
+            done.erase(done.begin() + (long)i);
+            cv.notify_all();
+            return true;
+        }
+        return false;
+    }
+    // Hand back the results `live` still wants (at most maxUploads that carry pixels; cancelled
+    // notes always) and drop the ones it does not.
+    template <typename Live>
+    void drain(int maxUploads, Live live, std::vector<EsdeArtResult>* out) {
+        std::lock_guard<std::mutex> lk(mu);
+        size_t w = 0;
+        for (size_t i = 0; i < done.size(); i++) {
+            EsdeArtResult& r = done[i];
+            const bool want = live(r);
+            if (want && (r.cancelled || r.px.rgba.empty() || maxUploads > 0)) {
+                if (!r.cancelled && !r.px.rgba.empty()) maxUploads--;
+                doneBytes -= r.px.rgba.size();
+                out->push_back(std::move(r));
+            } else if (!want) {
+                doneBytes -= r.px.rgba.size();
+            } else {
+                if (w != i) done[w] = std::move(r);
+                w++;
+            }
+        }
+        done.resize(w);
+        cv.notify_all();
+    }
+    void run() {
+        // Decoders run at normal priority (not the render thread's real-time class), slightly ahead
+        // of ordinary background work.
+        sched_param sp{};
+        pthread_setschedparam(pthread_self(), SCHED_OTHER, &sp);
+        setpriority(PRIO_PROCESS, (id_t)syscall(SYS_gettid), -4);
+        pthread_setname_np(pthread_self(), "nano-esdeart");
+        for (;;) {
+            Job job;
+            uint64_t ep;
+            {
+                std::unique_lock<std::mutex> lk(mu);
+                cv.wait(lk, [&] { return stop || !queue.empty(); });
+                if (stop) return;
+                job = std::move(queue.back());
+                queue.pop_back();
+                ep = epoch;
+            }
+            EsdeArtResult r;
+            r.key = std::move(job.key);
+            r.ticket = job.ticket;
+            r.svg = job.svg;
+            const auto t0 = std::chrono::steady_clock::now();
+            bool ok = job.svg ? esdeArtRasterSvgCpu(job.path, job.boxW, job.boxH, &r.px)
+                              : esdeArtDecodeRaster(job.path, job.boxW, job.boxH, &r.px);
+            if (!ok) r.px = EsdeArtPixels{};
+            decodes.fetch_add(1, std::memory_order_relaxed);
+            decodeUs.fetch_add(std::chrono::duration_cast<std::chrono::microseconds>(
+                                   std::chrono::steady_clock::now() - t0).count(),
+                               std::memory_order_relaxed);
+            std::unique_lock<std::mutex> lk(mu);
+            cv.wait(lk, [&] {
+                return stop || epoch != ep || done.empty() || doneBytes + r.px.rgba.size() <= kMaxDoneBytes;
+            });
+            if (stop) return;
+            if (epoch != ep) continue;
+            doneBytes += r.px.rgba.size();
+            done.push_back(std::move(r));
+        }
+    }
+};
