-        || (cp >= 0x3000 && cp <= 0x3020)
-        || (cp >= 0xFE30 && cp <= 0xFE6F)
-        || (cp >= 0xFF01 && cp <= 0xFF0F) || (cp >= 0xFF1A && cp <= 0xFF20)
