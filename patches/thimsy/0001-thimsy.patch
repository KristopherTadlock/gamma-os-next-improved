@@ -44,6 +44,7 @@
 #include <unistd.h>
 #include <cutils/properties.h>
 #include <utils/SystemClock.h>   // android::uptimeMillis() for touch-gesture timing
+#include <linux/input.h>          // BTN_* codes for the touch button hints
