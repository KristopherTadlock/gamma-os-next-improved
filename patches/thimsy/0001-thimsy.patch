+    if (mPs3OptActive) closeXmbOpt();
+    if (mPs3DlgActive) closePs3Dialog(false);
+    if (mPs3DlgActive || mPs3OptActive) return;   // a dialog that must stay up
+    if (mAppsSummoned && mOverlayMode && mOverlayShown && !mOverlayWallpaper) {
+        mAppsSummoned = false;
+        mAppsReturn = QsReturn();
+        overlayResume();
+        return;
+    }
+    mAppsSummoned = false;
+    esdeOverlayCloseAll();
+    if (mAppsReturn.valid && mPs3Stack.size() == 1 && mAppsReturn.cat >= 0 && mAppsReturn.cat < (int)mPs3Cats.size()) {
+        mPs3Stack = mAppsReturn.stack;
+        if (mAppsReturn.appCat >= 0 && mAppsReturn.appCat < (int)mPs3Cats.size()
+            && mAppsReturn.appCatSel < (int)mPs3Cats[mAppsReturn.appCat].items.size())
+            mPs3CatItemSel[mAppsReturn.appCat] = mAppsReturn.appCatSel;   // the category it landed on
+        mPs3CatIdx = mAppsReturn.cat; mPs3ItemIdx = mAppsReturn.item;
+        // Pinning an app meanwhile adds or removes the Pinned Apps row: find the row again.
+        const auto& ci = mPs3Cats[mPs3CatIdx].items;
+        bool same = mPs3ItemIdx >= 0 && mPs3ItemIdx < (int)ci.size()
+                    && ci[mPs3ItemIdx].kind == mAppsReturn.itemKind && ci[mPs3ItemIdx].label == mAppsReturn.itemLabel;
+        for (int k = 0; k < (int)ci.size() && !same; k++)
+            if (ci[k].kind == mAppsReturn.itemKind && ci[k].label == mAppsReturn.itemLabel) { mPs3ItemIdx = k; same = true; }
+        if (mPs3ItemIdx >= (int)ci.size()) mPs3ItemIdx = ci.empty() ? 0 : (int)ci.size() - 1;
+        if (mPs3ItemIdx < 0) mPs3ItemIdx = 0;
+        mPs3CatItemSel[mPs3CatIdx] = mPs3ItemIdx;
+        mPs3AnimItem = (float)mPs3ItemIdx; mPs3ItemAnimStart = -1.0f;
+        mNdsAtRoot = mAppsReturn.atRoot; mNdsCamera = mAppsReturn.camera;
+    } else {
+        if (!mPs3Stack.empty()) mPs3Stack.pop_back();
+        mNdsCamera = mPs3Stack.empty() ? (float)mPs3ItemIdx : (float)mPs3Stack.back().sel;
+    }
+    mAppsReturn = QsReturn();
+    mPs3SubAnimStart = -1.0f;
+    mNdsScrubbing = false; mNdsFlingVel = 0.0f;
+    esdeApplySettingsTheme();
+    ps3Sfx(PS3_SFX_BACK);
+    mDisplayDirty = true;
+}
