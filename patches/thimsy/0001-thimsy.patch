+
+// The theme keys the last boot built ("rep" / "repx": ensureEsdeTheme's representative-system load
+// and its variant-trigger reload, "foc": the first focused-system reload), one record per line with
+// \x1f between fields. Read at startup so those builds can start before EGL is up.
+static const char* kEsdePrebuildFile = "/data/system/nano_esde_prebuild";
+
+// nanoesde::Theme::setLocale's form, so equal locales give equal keys.
+static std::string esdeNormLocale(const std::string& in) {
+    std::string l = in;
+    for (auto& c : l) if (c == '-') c = '_';
+    return l.empty() ? std::string("en_US") : l;
+}
+
+// Parses themes on worker threads. Each build parses into its own nanoesde::Theme, and a finished
+// one is handed over whole by obtain(), so no Theme is ever shared or written by two threads. Every
+// job carries a generation; invalidate() raises the floor, cancels the running jobs (the parse stops
+// at its next file) and drops the queued and finished ones, so a stale build is never adopted.
+// Worker threads for theme loading and art decoding: the cores beside the render thread, 1 to 4, so
+// a 4-core part (an H700, say) keeps a core for drawing and for Android's own start.
+static size_t esdeWorkerCount() {
+    static const size_t n = [] {
+        const long cores = sysconf(_SC_NPROCESSORS_CONF);
+        return (size_t)std::max(1L, std::min(4L, cores - 1));
+    }();
+    return n;
+}
+
+// Decoded art waiting for upload: 48 MB on a 3 GB device or larger (its MemTotal, which leaves out
+// the kernel's reservations, is about 2.7 GiB), 16 MB below.
+static size_t esdeArtDoneBudget() {
+    static const size_t bytes = [] {
+        const long pages = sysconf(_SC_PHYS_PAGES), page = sysconf(_SC_PAGESIZE);
+        const unsigned long long ram = pages > 0 && page > 0 ? (unsigned long long)pages * page : 0;
+        return ram >= (5ull << 29) ? (size_t)(48u << 20) : (size_t)(16u << 20);
+    }();
+    return bytes;
+}
+
+struct NanoMenu::EsdeThemeBuilder {
+    struct Job {
+        EsdeBuildKey key;
+        uint64_t gen = 0;
+        std::shared_ptr<std::atomic<bool>> cancel;
+    };
+    struct Done {
+        EsdeBuildKey key;
+        uint64_t gen = 0;
+        std::unique_ptr<nanoesde::Theme> doc;
+        int64_t ms = 0;
+    };
+    const size_t kMaxThreads = esdeWorkerCount();
+
+    std::mutex mu;
+    std::condition_variable cv;
+    std::deque<Job> queue;
+    std::vector<Job> running;
+    std::vector<Done> done;
+    uint64_t nextGen = 1;
+    uint64_t floor = 1;
+    bool stop = false;
+    std::vector<std::thread> threads;
+
+    ~EsdeThemeBuilder() {
+        {
+            std::lock_guard<std::mutex> lk(mu);
+            stop = true;
+            queue.clear();
+            for (auto& j : running) j.cancel->store(true, std::memory_order_relaxed);
+        }
+        cv.notify_all();
+        for (auto& t : threads) if (t.joinable()) t.join();
+    }
+    // A build of k that will be kept is queued, running or finished.
+    bool liveLocked(const EsdeBuildKey& k) const {
+        for (const auto& d : done) if (d.gen >= floor && d.key == k) return true;
+        for (const auto& j : running) if (j.gen >= floor && j.key == k) return true;
+        for (const auto& j : queue) if (j.gen >= floor && j.key == k) return true;
+        return false;
+    }
+    void submitLocked(const EsdeBuildKey& k, bool front) {
+        Job j;
+        j.key = k;
+        j.gen = nextGen++;
+        j.cancel = std::make_shared<std::atomic<bool>>(false);
+        if (front) queue.push_front(std::move(j));
+        else queue.push_back(std::move(j));
+        // A job the render thread waits for never queues behind other builds for a worker: it may
+        // start one thread beyond the cap.
+        if (threads.size() < kMaxThreads + (front ? 1 : 0) && running.size() + queue.size() > threads.size())
+            threads.emplace_back([this] { run(); });
+        cv.notify_all();
+    }
+    void prebuild(const EsdeBuildKey& k) {
+        std::lock_guard<std::mutex> lk(mu);
+        if (!liveLocked(k)) submitLocked(k, /*front=*/false);
+    }
+    void invalidate() {
+        std::lock_guard<std::mutex> lk(mu);
+        floor = nextGen;
+        queue.clear();
+        done.clear();
+        for (auto& j : running) j.cancel->store(true, std::memory_order_relaxed);
+    }
+    // The build of k: one already finished or under way (prebuilt), else a new one. Waits for it.
+    std::unique_ptr<nanoesde::Theme> obtain(const EsdeBuildKey& k, bool* prebuilt, int64_t* buildMs) {
+        std::unique_lock<std::mutex> lk(mu);
+        *prebuilt = liveLocked(k);
+        if (!*prebuilt) {
+            submitLocked(k, /*front=*/true);
+        } else {
+            for (size_t i = 0; i < queue.size(); i++) {
+                if (queue[i].gen < floor || !(queue[i].key == k)) continue;
+                Job j = std::move(queue[i]);
+                queue.erase(queue.begin() + (long)i);
+                queue.push_front(std::move(j));
+                if (threads.size() < kMaxThreads + 1 && running.size() + queue.size() > threads.size())
+                    threads.emplace_back([this] { run(); });
+                cv.notify_all();
+                break;
+            }
+        }
+        for (;;) {
+            for (size_t i = 0; i < done.size(); i++) {
+                if (done[i].gen < floor || !(done[i].key == k)) continue;
+                std::unique_ptr<nanoesde::Theme> doc = std::move(done[i].doc);
+                *buildMs = done[i].ms;
+                done.erase(done.begin() + (long)i);
+                return doc;
+            }
+            if (!liveLocked(k)) submitLocked(k, /*front=*/true);
+            cv.wait(lk);
+        }
+    }
+    void run() {
+        // Normal priority, as the art decoders: a worker made from the render thread would
+        // otherwise inherit its real-time class.
+        sched_param sp{};
+        pthread_setschedparam(pthread_self(), SCHED_OTHER, &sp);
+        setpriority(PRIO_PROCESS, (id_t)syscall(SYS_gettid), -4);
+        pthread_setname_np(pthread_self(), "nano-esdetheme");
+        for (;;) {
+            Job job;
+            {
+                std::unique_lock<std::mutex> lk(mu);
+                cv.wait(lk, [&] { return stop || !queue.empty(); });
+                if (stop) return;
+                job = std::move(queue.front());
+                queue.pop_front();
+                running.push_back(job);
+            }
+            const int64_t t0 = (int64_t)uptimeMillis();
+            std::unique_ptr<nanoesde::Theme> doc = std::make_unique<nanoesde::Theme>();
+            doc->setCancel(job.cancel.get());
+            doc->setLocale(job.key.locale);
+            doc->load(job.key.dir, /*systemName=*/"", job.key.variant, job.key.colorScheme,
+                      /*aspect=*/job.key.aspectRatio, job.key.fontSize, job.key.aspect,
+                      esdeSysVars(job.key.sysTheme, job.key.sysName));
+            doc->setCancel(nullptr);
+            const int64_t ms = (int64_t)uptimeMillis() - t0;
+            {
+                std::lock_guard<std::mutex> lk(mu);
+                for (size_t i = 0; i < running.size(); i++)
+                    if (running[i].gen == job.gen) { running.erase(running.begin() + (long)i); break; }
+                const bool keep = !stop && job.gen >= floor && !job.cancel->load(std::memory_order_relaxed);
+                ALOGI("esde: theme build %llu (sys='%s' variant='%s') finished in %lld ms at %lld ms%s",
+                      (unsigned long long)job.gen, job.key.sysTheme.c_str(), job.key.variant.c_str(),
+                      (long long)ms, (long long)uptimeMillis(), keep ? "" : ", discarded (stale)");
+                if (keep) {
+                    Done d;
+                    d.key = std::move(job.key);
+                    d.gen = job.gen;
+                    d.doc = std::move(doc);
+                    d.ms = ms;
+                    done.push_back(std::move(d));
+                }
+            }
+            cv.notify_all();
+            // A discarded build's theme is freed here, outside the lock.
+        }
+    }
+};
+
+// Startup (readyToRun, before EGL): start the builds the last boot used, if the persisted theme
+// choice still matches them. Needs only persist props and the theme files in /data or /system.
+void NanoMenu::esdePrebuildStart() {
+    if (property_get_int32("persist.gammaos.nano.ndstheme", 0) != 3) return;
+    mEsdePredict.clear();
+    std::string content;
+    if (FILE* f = fopen(kEsdePrebuildFile, "re")) {
+        char buf[4096];
+        size_t n;
+        while ((n = fread(buf, 1, sizeof(buf), f)) > 0) content.append(buf, n);
+        fclose(f);
+    }
+    size_t pos = 0;
+    while (pos < content.size()) {
+        size_t eol = content.find('\n', pos);
+        if (eol == std::string::npos) eol = content.size();
+        std::vector<std::string> fl;
+        size_t a = pos;
+        for (;;) {
+            size_t b = content.find('\x1f', a);
+            if (b == std::string::npos || b > eol) b = eol;
+            fl.push_back(content.substr(a, b - a));
+            if (b >= eol) break;
+            a = b + 1;
+        }
+        pos = eol + 1;
+        if (fl.size() != 12) continue;
+        EsdeBuildKey k;
+        k.set = fl[1]; k.dir = fl[2]; k.selVariant = fl[3]; k.variant = fl[4];
+        k.colorScheme = fl[5]; k.aspectRatio = fl[6]; k.fontSize = fl[7]; k.locale = fl[8];
+        k.sysTheme = fl[9]; k.sysName = fl[10];
+        k.aspect = strtof(fl[11].c_str(), nullptr);
+        mEsdePredict.emplace_back(fl[0], std::move(k));
+    }
+
+    char ts[PROPERTY_VALUE_MAX] = {0}, fs[PROPERTY_VALUE_MAX] = {0}, cs[PROPERTY_VALUE_MAX] = {0};
+    char va[PROPERTY_VALUE_MAX] = {0}, ar[PROPERTY_VALUE_MAX] = {0}, loc[PROPERTY_VALUE_MAX] = {0};
+    property_get("persist.gammaos.nano.esde.themeset", ts, "");
+    property_get("persist.gammaos.nano.esde.fontsize", fs, "");
+    property_get("persist.gammaos.nano.esde.colorscheme", cs, "");
+    property_get("persist.gammaos.nano.esde.variant", va, "");
+    property_get("persist.gammaos.nano.esde.aspectratio", ar, "automatic");
+    property_get("persist.sys.locale", loc, "");
+    if (!loc[0]) property_get("ro.product.locale", loc, "en-US");
+    const std::string want = ts[0] ? ts : "slate-es-de";
+    const std::string dir = esdeSetDir(want);
+    const std::string locale = esdeNormLocale(loc);
+    std::vector<EsdeBuildKey> keys;
+    for (const auto& r : mEsdePredict) {
+        const EsdeBuildKey& k = r.second;
+        if (dir.empty() || k.set != want || k.dir != dir || k.selVariant != va || k.colorScheme != cs ||
+            k.fontSize != fs || k.aspectRatio != ar || k.locale != locale)
+            continue;
+        bool dup = false;
+        for (const auto& o : keys) if (o == k) dup = true;
+        if (!dup) keys.push_back(k);
+    }
+    if (keys.empty()) {
+        ALOGI("esde: theme prebuild: nothing to start for '%s' (%zu records)", want.c_str(), mEsdePredict.size());
+        return;
+    }
+    mEsdeBuilder = std::make_shared<EsdeThemeBuilder>();
+    for (const auto& k : keys) mEsdeBuilder->prebuild(k);
+    mEsdePrebuildOpen = true;
+    ALOGI("esde: theme prebuild started at %lld ms: %zu build(s) of '%s'", (long long)uptimeMillis(),
+          keys.size(), want.c_str());
+}
+
+// Build (or take the prebuilt) theme for k and swap it into mEsdeDoc. Returns mEsdeDoc.valid().
+bool NanoMenu::esdeBuildTheme(const EsdeBuildKey& k, const char* why) {
+    if (!mEsdeBuilder) mEsdeBuilder = std::make_shared<EsdeThemeBuilder>();
+    if (!mEsdePrebuildOpen) mEsdeBuilder->invalidate();   // nothing built before this request is used
+    const int64_t t0 = (int64_t)uptimeMillis();
+    bool prebuilt = false;
+    int64_t buildMs = 0;
+    std::unique_ptr<nanoesde::Theme> doc = mEsdeBuilder->obtain(k, &prebuilt, &buildMs);
+    mEsdeDoc.swap(*doc);
