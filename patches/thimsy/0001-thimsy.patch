@@ -536,6 +536,39 @@ on early-fs
     # Once metadata has been mounted, we'll need vold to deal with userdata checkpointing
     start vold
 
+# RG Cube (Unisoc ums9620): the display (sprd-drm) and GPU (mali) drivers are loaded in the
+# background by the vendor's module loader, so the composer, started early here, needs their device
+# nodes first. rgcube-display-wait waits for them (5 s at most) so init goes on meanwhile, and the
+# composer starts when they are there (by ctl.start: a property trigger would run only after the
+# boot action); SurfaceFlinger, started in the post-fs block below, waits for
+# the composer. Its composer is AOSP's default (vendor.hwcomposer-2-4), which other devices also name
+# theirs, so it is started early here only, with the power HAL it waits for before it registers (the
+# hal class starts only after /data is up). Normal boots only: the factory calibration mode loads no
+# display driver.
+on post-fs && property:ro.product.vendor.model=RGCUBE && property:ro.bootmode=normal
+    start vendor.power-default
+    start rgcube-display-wait
+
+service rgcube-display-wait /system/bin/sh -c "i=0; while { [ ! -e /dev/dri/card0 ] || [ ! -e /dev/mali0 ]; } && [ $$i -lt 500 ]; do sleep 0.01; i=$$((i + 1)); done; setprop ctl.start vendor.hwcomposer-2-4"
+    user root
+    group root
+    disabled
+    oneshot
+    seclabel u:r:su:s0
+
+# RG Cube: its LED driver (cust-leds, a GPIO LED driver that spends about a second in its probe) loads
+# in a process of its own beside the vendor's module loader, which loads one module at a time. It
+# needs only the SoC's GPIO, as when it loaded in the first stage.
+on early-init && property:ro.product.vendor.model=RGCUBE
+    start rgcube-leds-load
+
+service rgcube-leds-load /vendor/bin/modprobe -s -d /vendor/lib/modules cust-leds
+    user root
+    group root
+    disabled
+    oneshot
+    seclabel u:r:vendor_modprobe:s0
+
 on post-fs
     # vdc checkpoint bookkeeping should not block the rest of the boot sequence.
     exec_background - system system -- /system/bin/vdc checkpoint markBootAttempt
