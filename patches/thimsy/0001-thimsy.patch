+void NanoMenu::esdeArtSubmit(const std::string& key, const std::string& path, bool svg, int boxW, int boxH,
+                             bool upgrade) {
+    if (!mEsdeArtPool) mEsdeArtPool = std::make_shared<EsdeArtPool>((int)esdeWorkerCount());
+    EsdeArtPending p;
+    p.ticket = ++mEsdeArtTicket;
+    p.upgrade = upgrade;
+    mEsdeArtPending[key] = p;
+    EsdeArtPool::Job j;
+    j.key = key; j.path = path; j.ticket = p.ticket; j.svg = svg; j.boxW = boxW; j.boxH = boxH;
+    mEsdeArtPool->submit(std::move(j));
+}
