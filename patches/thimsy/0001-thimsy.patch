+bool NanoSfxPlayer::loadMedia(const std::string& path, float master, int maxMs) {
+    const int fd = open(path.c_str(), O_RDONLY | O_CLOEXEC);
+    if (fd < 0) return false;
+    struct stat st;
+    AMediaExtractor* ex = AMediaExtractor_new();
+    bool ok = fstat(fd, &st) == 0 && ex && AMediaExtractor_setDataSourceFd(ex, fd, 0, st.st_size) == AMEDIA_OK;
+    AMediaCodec* codec = nullptr;
+    int rate = 0, ch = 0;
+    for (size_t t = 0; ok && t < AMediaExtractor_getTrackCount(ex) && !codec; t++) {
+        AMediaFormat* f = AMediaExtractor_getTrackFormat(ex, t);
+        const char* mime = nullptr;
+        if (AMediaFormat_getString(f, AMEDIAFORMAT_KEY_MIME, &mime) && mime && !strncmp(mime, "audio/", 6)) {
+            AMediaFormat_getInt32(f, AMEDIAFORMAT_KEY_SAMPLE_RATE, &rate);
+            AMediaFormat_getInt32(f, AMEDIAFORMAT_KEY_CHANNEL_COUNT, &ch);
+            codec = AMediaCodec_createDecoderByType(mime);
+            if (codec && (AMediaCodec_configure(codec, f, nullptr, nullptr, 0) != AMEDIA_OK
+                          || AMediaCodec_start(codec) != AMEDIA_OK)) {
+                AMediaCodec_delete(codec);
+                codec = nullptr;
+            }
+            if (codec) AMediaExtractor_selectTrack(ex, t);
+        }
+        AMediaFormat_delete(f);
+    }
+    std::vector<int16_t> pcm;   // as decoded, interleaved
+    int32_t enc = 2;            // AudioFormat ENCODING_PCM_16BIT; 4 is float
+    if (codec && rate > 0 && ch > 0) {
+        size_t want = (size_t)rate * ch * (size_t)maxMs / 1000;
+        bool inEnd = false;
+        for (int spins = 0; pcm.size() < want && spins < 20000; spins++) {
+            if (!inEnd) {
+                const ssize_t ib = AMediaCodec_dequeueInputBuffer(codec, 5000);
+                if (ib >= 0) {
+                    size_t cap = 0;
+                    uint8_t* buf = AMediaCodec_getInputBuffer(codec, ib, &cap);
+                    const ssize_t n = buf ? AMediaExtractor_readSampleData(ex, buf, cap) : -1;
+                    if (n < 0) {
+                        AMediaCodec_queueInputBuffer(codec, ib, 0, 0, 0, AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM);
+                        inEnd = true;
+                    } else {
+                        AMediaCodec_queueInputBuffer(codec, ib, 0, n, AMediaExtractor_getSampleTime(ex), 0);
+                        AMediaExtractor_advance(ex);
+                    }
+                }
+            }
+            AMediaCodecBufferInfo info;
+            const ssize_t ob = AMediaCodec_dequeueOutputBuffer(codec, &info, 5000);
+            if (ob == AMEDIACODEC_INFO_OUTPUT_FORMAT_CHANGED) {
+                AMediaFormat* of = AMediaCodec_getOutputFormat(codec);
+                AMediaFormat_getInt32(of, AMEDIAFORMAT_KEY_SAMPLE_RATE, &rate);
+                AMediaFormat_getInt32(of, AMEDIAFORMAT_KEY_CHANNEL_COUNT, &ch);
+                AMediaFormat_getInt32(of, AMEDIAFORMAT_KEY_PCM_ENCODING, &enc);
+                AMediaFormat_delete(of);
+                want = (size_t)rate * ch * (size_t)maxMs / 1000;
+                if (enc != 2 && enc != 4) break;   // neither 16-bit nor float: not playable here
+            } else if (ob >= 0) {
+                size_t cap = 0;
+                const uint8_t* buf = AMediaCodec_getOutputBuffer(codec, ob, &cap);
+                if (buf && info.size > 0 && enc == 4) {
+                    const float* f = (const float*)(buf + info.offset);
+                    for (int32_t k = 0; k < info.size / 4; k++)
+                        pcm.push_back((int16_t)std::max(-32768.0f, std::min(32767.0f, f[k] * 32767.0f)));
+                } else if (buf && info.size > 0) {
+                    const int16_t* s = (const int16_t*)(buf + info.offset);
+                    pcm.insert(pcm.end(), s, s + info.size / 2);
+                }
+                AMediaCodec_releaseOutputBuffer(codec, ob, false);
+                if (info.flags & AMEDIACODEC_BUFFER_FLAG_END_OF_STREAM) break;
+            }
+        }
+        AMediaCodec_stop(codec);
+    }
+    if (codec) AMediaCodec_delete(codec);
+    if (ex) AMediaExtractor_delete(ex);
+    close(fd);
+    if (pcm.empty() || rate <= 0 || ch < 1 || ch > 2 || (enc != 2 && enc != 4)) {
+        ALOGW("NanoSfx: cannot decode %s", path.c_str());
+        return false;
+    }
+    const size_t frames = std::min(pcm.size() / ch, (size_t)rate * (size_t)maxMs / 1000);
+    const bool cut = frames < pcm.size() / ch;
+    const size_t fade = cut ? std::min(frames, (size_t)rate * 150 / 1000) : 0;
+    int g = (int)(master * 32768.0f + 0.5f); if (g < 0) g = 0; else if (g > 32768) g = 32768;
+    std::vector<int16_t> out(frames * 2);
+    for (size_t i = 0; i < frames; i++) {
+        float f = 1.0f;
+        if (i + fade >= frames && fade) f = 0.5f * (1.0f + cosf(3.14159265f * (float)(i + fade - frames) / (float)fade));
+        for (int c = 0; c < 2; c++) {
+            const int v = (int)(((int)pcm[i * ch + (ch == 2 ? c : 0)] * g) >> 15);
