+    mScrapeQueuedJobs = std::move(jobs);
+    mScrapeQueuedBox = wantBox;
+    mScrapeQueuedFan = wantFan;
+    char body[200];
+    snprintf(body, sizeof(body), trDyn("A scrape is in progress (%s). Add this scrape to the queue?"),
