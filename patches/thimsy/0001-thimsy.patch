+    <string name="title_launch_guard">Thimsy Launch Guard</string>
     <string name="launch_guard_toggle_label">Launch Guard を有効にする</string>
     <string name="launch_guard_toggle_summary">有効にすると、選択された呼び出し元アプリから起動されたとき、選択されたターゲットアプリを強制停止します。実行中のアプリを再起動したときのエミュレーターのクラッシュを回避できます。</string>
     <string name="callers_section_title">呼び出し元アプリ</string>
diff --git a/packages/apps/LaunchGuardControl/res/values-ko/strings.xml b/packages/apps/LaunchGuardControl/res/values-ko/strings.xml
index f504610e569..7859d8106e8 100644
