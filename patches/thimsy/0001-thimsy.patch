+// Shutdown logs also go to pmsg, which pstore keeps across the restart; the kernel log does not.
+// The logger is installed once at start (InstallRebootLogger), before init has other threads:
+// swapping it in DoReboot could leave it empty for a moment while another thread logs.
+static std::atomic<bool> gShutdownLogsToPmsg{false};
+
+static void KernelAndPmsgLogger(android::base::LogId id, android::base::LogSeverity severity,
+                                const char* tag, const char* file, unsigned int line,
+                                const char* message) {
+    android::base::KernelLogger(id, severity, tag, file, line, message);
+    if (!gShutdownLogsToPmsg.load(std::memory_order_relaxed)) return;
+    static const int kPrio[] = {ANDROID_LOG_VERBOSE, ANDROID_LOG_DEBUG, ANDROID_LOG_INFO,
+                                ANDROID_LOG_WARN,    ANDROID_LOG_ERROR, ANDROID_LOG_FATAL,
+                                ANDROID_LOG_FATAL};
+    const size_t i = static_cast<size_t>(severity);
+    __android_log_message m = {sizeof(__android_log_message), LOG_ID_MAIN,
+                               i < arraysize(kPrio) ? kPrio[i] : ANDROID_LOG_INFO,
+                               "init", file, line, message};
+    __android_log_logd_logger(&m);
+}
+
+void InstallRebootLogger() {
+    android::base::SetLogger(KernelAndPmsgLogger);
+}
