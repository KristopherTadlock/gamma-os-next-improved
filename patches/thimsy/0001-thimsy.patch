+ * limitations under the License.
+ */
+
+// The BIOS installer: every file of a chosen folder whose size is a catalogue entry's is hashed,
+// recognised by its SHA-1 (whatever its name), and copied where each emulator reads it, under the
+// name it needs. Arcade BIOS zips are recognised by their members, a PS2 BIOS also by its ROMDIR, a
+// PS Vita update package by its header (Vita3K installs it itself), and a few console-unique files
+// by name and size. Nothing is overwritten. A worker thread does it all; the UI reads
+// biosInstallProgress().
+//
+// Side effects outside Nano (am, prefs and config edits, chown/restorecon, an emulator's folders)
+// happen only for an emulator that gets a new file in this run, and never for one not installed.
+// /data/system/nano_bios/installed.json remembers what went where, so biosReinstallFromManifest()
+// can put back files that are missing after Move Emulator Files to microSD.
+
+#define LOG_TAG "NanoMenu"
+
+#include "NanoMenu.h"
+#include "NanoBiosCatalog.h"
+#include "NanoI18n.h"
+#include "NanoJson.h"
+#include "NanoMenuStrings.h"
+#include "NanoSdMove.h"
+
+#include <cutils/properties.h>
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <log/log.h>
+#include <private/android_filesystem_config.h>   // AID_EXT_DATA_RW
+#include <stdarg.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <sys/syscall.h>
+#include <sys/wait.h>
+#include <sys/xattr.h>
+#include <time.h>
+#include <unistd.h>
+
+#include <algorithm>
+#include <functional>
+#include <map>
+#include <set>
+#include <thread>
+
+namespace android {
+
+using nanobios::File;
+using nanobios::Slot;
+
+namespace {
+
+const char kManifestDir[] = "/data/system/nano_bios";
+const char kManifest[] = "/data/system/nano_bios/installed.json";
+const char kReinstallMarker[] = "/data/system/nano_bios/reinstall_pending";   // a reinstall an exit cut short
+const char kRaDefSystem[] = "/storage/emulated/0/RetroArch/system";
+const char kArmsx2Bios[] = "/data/media/0/Android/data/com.armsx2/files/bios";
+const char kArmsx2Prefs[] = "/data/data/com.armsx2/shared_prefs/ARMSX2.xml";
+const char kDolphinGc[] = "/data/media/0/Android/data/org.dolphinemu.dolphinemu/files/GC";
+const char kDrasticNanoSys[] = "/data/system/drastic-nano/DraStic/system";
+const char kMupenFiles[] = "/data/media/0/Android/data/org.mupen64plusae.v3.fzurita/files";
+const char kMupenPrefs[] = "/data/data/org.mupen64plusae.v3.fzurita/shared_prefs/org.mupen64plusae.v3.fzurita_preferences.xml";
+const char kScummvmIni[] = "/data/data/org.scummvm.scummvm/files/scummvm.ini";
+const char kScummvmExtra[] = "/data/data/org.scummvm.scummvm/files/extra";
+const char kAzaharPrefs[] = "/data/data/org.azahar_emu.azahar/shared_prefs/org.azahar_emu.azahar_preferences.xml";
+const char kHakuxConsole[] = "/data/data/com.rfandango.haku_x/files/console";
+const char kVita3kPkg[] = "org.vita3k.emulator";
+const char kVita3kConfig[] = "/data/media/0/Android/data/org.vita3k.emulator/files/config.yml";
+const char kVita3kDefPref[] = "/storage/emulated/0/Android/data/org.vita3k.emulator/files/vita";
+const char kVita3kAppPrefs[] = "/data/data/org.vita3k.emulator/shared_prefs/vita3k_app.xml";
+const char kVita3kStage[] = "/data/media/0/Android/data/org.vita3k.emulator/files/nano-install";
+const uint64_t kMaxFile = 1ull << 30;        // larger files are never looked at
+const uint64_t kSpare = 8ull << 20;          // left free on a drive after copying
+const int kUnknownNames = 5;                 // unrecognised files named in the report
+
+std::string lowerStr(std::string s) {
+    for (auto& c : s) c = (char)tolower((unsigned char)c);
+    return s;
+}
+std::string baseName(const std::string& p) { return p.substr(p.find_last_of('/') + 1); }
+std::string dirName(const std::string& p) {
+    const size_t sl = p.find_last_of('/');
+    return sl == std::string::npos || sl == 0 ? std::string("/") : p.substr(0, sl);
+}
+bool pathExists(const std::string& p) { struct stat st; return lstat(p.c_str(), &st) == 0; }
+bool isDir(const std::string& p) { struct stat st; return stat(p.c_str(), &st) == 0 && S_ISDIR(st.st_mode); }
+uint64_t fileSize(const std::string& p) { struct stat st; return stat(p.c_str(), &st) == 0 ? (uint64_t)st.st_size : 0; }
+
+// A raw path as apps see it.
+std::string appView(const std::string& p) {
+    if (p == "/data/media/0" || p.compare(0, 14, "/data/media/0/") == 0) return "/storage/emulated/0" + p.substr(13);
+    if (p.compare(0, 14, "/mnt/media_rw/") == 0) return "/storage/" + p.substr(14);
+    return p;
+}
+
+// An English format string, translated, filled in.
+std::string tfmt(const char* english, ...) {
+    char buf[1024];
+    va_list ap;
+    va_start(ap, english);
+    vsnprintf(buf, sizeof(buf), trDyn(english), ap);
+    va_end(ap);
+    return buf;
+}
+
+std::string humanSize(uint64_t b) {
+    char buf[32];
+    if (b >= (1ull << 30)) snprintf(buf, sizeof(buf), "%.1f GB", b / 1073741824.0);
+    else if (b >= (1ull << 20)) snprintf(buf, sizeof(buf), "%.1f MB", b / 1048576.0);
+    else snprintf(buf, sizeof(buf), "%llu KB", (unsigned long long)((b + 1023) / 1024));
+    return buf;
+}
+
+// Where a path really is: its deepest existing folder with links resolved, and the rest.
+std::string canonical(const std::string& p) {
+    std::string head = p, tail;
+    while (head.size() > 1 && !pathExists(head)) {
+        tail = "/" + baseName(head) + tail;
+        head = dirName(head);
+    }
+    char buf[PATH_MAX];
+    if (realpath(head.c_str(), buf)) head = buf;
+    return (head == "/" ? std::string() : head) + tail;
+}
+
+bool under(const std::string& a, const std::string& b) {   // a is inside b
+    return a.size() > b.size() && a.compare(0, b.size(), b) == 0 && a[b.size()] == '/';
+}
+
+// A path nothing can bend: absolute, no quote or line break, no "." or ".." part.
+bool safePath(const std::string& p) {
+    if (p.empty() || p[0] != '/' || p.find_first_of("'\n\r") != std::string::npos) return false;
+    for (size_t a = 1; a <= p.size();) {
+        size_t b = p.find('/', a);
+        if (b == std::string::npos) b = p.size();
+        const std::string part = p.substr(a, b - a);
+        if (part == "." || part == "..") return false;
+        a = b + 1;
+    }
+    return true;
+}
+
+bool inSystemFs(const std::string& c) {   // /proc, /sys, /dev: never walked
+    for (const char* r : {"/proc", "/sys", "/dev"}) if (c == r || under(c, r)) return true;
+    return false;
+}
+
+void forceStop(const char* pkg) { runArgv({"/system/bin/am", "force-stop", pkg}, nullptr, 15000); }
+
+int64_t monoMs() {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (int64_t)ts.tv_sec * 1000 + ts.tv_nsec / 1000000;
+}
+
+// ---- packages ----
+struct Packages {
+    bool readable = false;
+    std::map<std::string, uid_t> uid;
+    void load() {
+        std::string text;
+        if (!sdReadFile("/data/system/packages.list", &text)) return;
+        readable = true;
+        size_t pos = 0;
+        while (pos < text.size()) {
+            size_t eol = text.find('\n', pos);
+            if (eol == std::string::npos) eol = text.size();
+            const std::string line = text.substr(pos, eol - pos);
+            pos = eol + 1;
+            const size_t a = line.find(' ');
+            if (a == std::string::npos) continue;
+            uid[line.substr(0, a)] = (uid_t)strtoul(line.c_str() + a + 1, nullptr, 10);
+        }
+    }
+    bool installed(const std::string& pkg) const { return pkg.empty() || !readable || uid.count(pkg); }
+};
+
+// ---- ownership ----
+// Android/data/<pkg> (the slot's own app only): the app, group ext_data_rw (AID_EXT_DATA_RW). /data/data/<pkg> (the
+// slot's own app only): as that folder, then restorecon. Other shared storage: as the parent folder.
+// /data/system: as the parent. A card: nothing. Anything in another app's folders: refused.
+enum { OWN_NONE = 0, OWN_APPEXT, OWN_APPDATA, OWN_SHARED, OWN_SYSTEM, OWN_REFUSED };
+struct Owner { int kind = OWN_NONE; std::string pkg; };
+
+std::string pkgAfter(const std::string& c, const std::string& prefix) {   // c is under prefix
+    const size_t n = prefix.size() + 1, sl = c.find('/', n);
+    return c.substr(n, sl == std::string::npos ? std::string::npos : sl - n);
+}
+
+Owner ownerFor(const std::string& rawPath, const std::string& pkg) {
+    const std::string c = canonical(rawPath);
+    Owner o;
+    o.pkg = pkg;
+    if (c == "/data/media/0/Android/data" || c == "/data/media/0/Android/obb" || under(c, "/data/media/0/Android/obb")) {
+        o.kind = OWN_REFUSED;
+    } else if (under(c, "/data/media/0/Android/data")) {
+        o.kind = !pkg.empty() && pkgAfter(c, "/data/media/0/Android/data") == pkg ? OWN_APPEXT : OWN_REFUSED;
+    } else if (c == "/data/data" || under(c, "/data/data")) {
+        o.kind = !pkg.empty() && under(c, "/data/data") && pkgAfter(c, "/data/data") == pkg ? OWN_APPDATA : OWN_REFUSED;
+    } else if (under(c, "/data/media")) {
+        o.kind = OWN_SHARED;
+    } else if (under(c, "/data/system")) {
+        o.kind = OWN_SYSTEM;
+    }
+    return o;
+}
+
+// Owner, mode and label for a file or folder just made, through its descriptor (no link is
+// followed; a temp file keeps them on rename). False when it must not be there.
+bool applyOwnerFd(int fd, bool dir, const Owner& o, const Packages& pk, const std::string& parent) {
+    if (o.kind == OWN_REFUSED) return false;
+    if (o.kind == OWN_NONE) return true;
+    struct stat pst;
+    if (stat(parent.c_str(), &pst) != 0) return false;
+    auto label = [&]() {
+        char ctx[256];
+        const ssize_t n = lgetxattr(parent.c_str(), "security.selinux", ctx, sizeof(ctx));
+        if (n > 0 && fsetxattr(fd, "security.selinux", ctx, (size_t)n, 0) != 0) ALOGW("bios: label failed: %s", strerror(errno));
+    };
+    switch (o.kind) {
+        case OWN_APPEXT: {
+            auto it = pk.uid.find(o.pkg);
+            if (fchown(fd, it != pk.uid.end() ? it->second : pst.st_uid, AID_EXT_DATA_RW) != 0) ALOGW("bios: chown failed: %s", strerror(errno));
+            fchmod(fd, dir ? 02770 : 0660);
+            label();
+            break;
+        }
+        case OWN_APPDATA: {
+            struct stat ast;
+            if (stat(("/data/data/" + o.pkg).c_str(), &ast) != 0) return false;
+            if (fchown(fd, ast.st_uid, ast.st_gid) != 0) ALOGW("bios: chown failed: %s", strerror(errno));
+            fchmod(fd, dir ? 0771 : 0660);
+            break;
+        }
+        case OWN_SHARED:
+            if (fchown(fd, pst.st_uid, pst.st_gid) != 0) ALOGW("bios: chown failed: %s", strerror(errno));
+            fchmod(fd, dir ? (pst.st_mode & 07777) : (pst.st_mode & 0666));
+            label();
+            break;
+        case OWN_SYSTEM:
+            if (fchown(fd, pst.st_uid, pst.st_gid) != 0) ALOGW("bios: chown failed: %s", strerror(errno));
+            fchmod(fd, dir ? 0755 : 0644);
+            break;
+    }
+    return true;
+}
+
+// Makes dir and the folders above it that are missing, each owned as its place wants (pkg: the
+// slot's app). The topmost one made goes to *top (for restorecon). 0, or the errno.
+int makeDirs(const std::string& dir, const std::string& pkg, const Packages& pk, std::string* top) {
+    struct stat st;
+    if (lstat(dir.c_str(), &st) == 0) return S_ISDIR(st.st_mode) || isDir(dir) ? 0 : ENOTDIR;
+    std::vector<std::string> missing;
+    std::string d = dir;
+    while (d.size() > 1 && !pathExists(d)) { missing.push_back(d); d = dirName(d); }
+    if (!isDir(d)) return ENOENT;
+    for (const auto& m : missing)   // a card that is not in, or the storage itself: never made here
+        if (dirName(m) == "/mnt/media_rw" || m == "/data/media/0" || dirName(m) == "/data/data") return ENOENT;
+    for (auto it = missing.rbegin(); it != missing.rend(); ++it) {
+        const Owner o = ownerFor(*it, pkg);
+        if (o.kind == OWN_REFUSED) return EPERM;
+        if (mkdir(it->c_str(), 0700) != 0) return errno ? errno : EIO;
+        const int fd = open(it->c_str(), O_RDONLY | O_DIRECTORY | O_NOFOLLOW | O_CLOEXEC);
+        if (fd < 0) return errno ? errno : EIO;
+        const bool ok = applyOwnerFd(fd, true, o, pk, dirName(*it));
+        close(fd);
+        if (!ok) return EPERM;
+        if (top && top->empty()) *top = *it;
+    }
+    return 0;
+}
+
+// Copies src to dst through a temp file in dst's folder (owned and labelled through its
+// descriptor, fsync, then a rename that never replaces a file). 0, or the errno (EEXIST: a file
+// is there; ECANCELED: *cancel was set).
+int copyNew(const std::string& src, const std::string& dst, const std::string& pkg, const Packages& pk,
+            const std::atomic<bool>* cancel) {
+    const Owner o = ownerFor(dst, pkg);
+    if (o.kind == OWN_REFUSED) return EPERM;
+    const std::string tmp = dirName(dst) + "/.nanobios-" + baseName(dst) + ".tmp";
+    unlink(tmp.c_str());
+    const int in = nanobios::openRegular(src, true);
+    if (in < 0) return errno ? errno : EIO;
+    const int out = open(tmp.c_str(), O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW | O_CLOEXEC, 0600);
+    if (out < 0) { const int e = errno; close(in); return e; }
+    std::vector<char> buf(1 << 16);
+    int err = 0;
+    for (;;) {
+        if (cancel && cancel->load()) { err = ECANCELED; break; }
+        const ssize_t n = read(in, buf.data(), buf.size());
+        if (n < 0) { err = errno; break; }
+        if (n == 0) break;
+        for (ssize_t w = 0; w < n;) {
+            const ssize_t k = write(out, buf.data() + w, (size_t)(n - w));
+            if (k <= 0) { err = k < 0 ? errno : EIO; break; }
+            w += k;
+        }
+        if (err) break;
+    }
+    if (!err && fsync(out) != 0) err = errno;
+    if (!err && !applyOwnerFd(out, false, o, pk, dirName(dst))) err = EPERM;
+    if (close(out) != 0 && !err) err = errno;
+    close(in);
+    if (!err) {
+        int r = -1;
+        errno = ENOSYS;
+#ifdef __NR_renameat2
+        r = (int)syscall(__NR_renameat2, AT_FDCWD, tmp.c_str(), AT_FDCWD, dst.c_str(), 1 /* RENAME_NOREPLACE */);
+#endif
+        if (r != 0 && (errno == EINVAL || errno == ENOSYS)) {   // a filesystem without it: check, then rename
+            if (pathExists(dst)) err = EEXIST;
+            else if (rename(tmp.c_str(), dst.c_str()) != 0) err = errno;
+        } else if (r != 0) {
+            err = errno;
+        }
+    }
+    if (err) unlink(tmp.c_str());
+    return err;
+}
+
+// A drive by the device of a path's deepest existing folder.
+struct Drive { std::string name; uint64_t bsize = 4096, avail = 0, need = 0; bool full = false; };
+dev_t driveOf(const std::string& path, std::map<dev_t, Drive>* drives) {
+    std::string d = path;
+    while (d.size() > 1 && !pathExists(d)) d = dirName(d);
+    struct stat st;
+    if (stat(d.c_str(), &st) != 0) return 0;
+    auto it = drives->find(st.st_dev);
+    if (it == drives->end()) {
+        Drive dr;
+        struct statvfs vs;
+        if (statvfs(d.c_str(), &vs) == 0) { dr.bsize = vs.f_bsize ? vs.f_bsize : 4096; dr.avail = (uint64_t)vs.f_bavail * vs.f_frsize; }
+        const std::string c = canonical(d);
+        dr.name = c.compare(0, 14, "/mnt/media_rw/") == 0 ? trDyn("microSD card") : trDyn("Internal storage");
+        drives->emplace(st.st_dev, dr);
+    }
+    return st.st_dev;
+}
+uint64_t roundUp(uint64_t n, uint64_t b) { return b ? (n + b - 1) / b * b : n; }
+
+// A <boolean> in SharedPreferences text.
+bool prefsSetBool(std::string* prefs, const std::string& name, bool v) {
+    if (prefs->find("<map") == std::string::npos)
+        *prefs = "<?xml version='1.0' encoding='utf-8' standalone='yes' ?>\n<map>\n</map>\n";
+    const size_t empty = prefs->find("<map />");
+    if (empty != std::string::npos) prefs->replace(empty, 7, "<map>\n</map>");
+    const std::string tag = std::string("<boolean name=\"") + name + "\" value=\"" + (v ? "true" : "false") + "\" />";
+    const size_t a = prefs->find("<boolean name=\"" + name + "\"");
+    if (a != std::string::npos) {
+        const size_t b = prefs->find("/>", a);
+        if (b == std::string::npos) return false;
+        prefs->replace(a, b + 2 - a, tag);
+        return true;
+    }
+    const size_t end = prefs->rfind("</map>");
+    if (end == std::string::npos) return false;
+    prefs->insert(end, "    " + tag + "\n");
+    return true;
+}
+
+// A <boolean> of SharedPreferences text: 1 true, 0 false, -1 not there. And removing it.
+int prefsGetBool(const std::string& prefs, const std::string& name) {
+    const size_t a = prefs.find("<boolean name=\"" + name + "\"");
+    if (a == std::string::npos) return -1;
+    const size_t b = prefs.find("/>", a);
+    return prefs.substr(a, b == std::string::npos ? std::string::npos : b - a).find("value=\"true\"") != std::string::npos;
+}
+void prefsRemoveBool(std::string* prefs, const std::string& name) {
+    const size_t a = prefs->find("<boolean name=\"" + name + "\"");
+    if (a == std::string::npos) return;
+    const size_t b = prefs->find("/>", a);
+    if (b == std::string::npos) return;
+    size_t from = a, to = b + 2;
+    while (from > 0 && ((*prefs)[from - 1] == ' ' || (*prefs)[from - 1] == '\t')) from--;
+    if (to < prefs->size() && (*prefs)[to] == '\n') to++;
+    prefs->erase(from, to - from);
+}
+
+// What a folder holds (files, and bytes), links not followed: a measure of an extraction's progress.
+uint64_t treeMeasure(const std::string& dir, int depth = 0) {
+    if (depth > 16) return 0;
+    DIR* d = opendir(dir.c_str());
+    if (!d) return 0;
+    uint64_t total = 0;
+    while (dirent* e = readdir(d)) {
+        if (!strcmp(e->d_name, ".") || !strcmp(e->d_name, "..")) continue;
+        const std::string p = dir + "/" + e->d_name;
+        struct stat st;
+        if (lstat(p.c_str(), &st) != 0) continue;
+        total += 1 + (uint64_t)st.st_size;
+        if (S_ISDIR(st.st_mode)) total += treeMeasure(p, depth + 1);
+    }
+    closedir(d);
+    return total;
+}
+
+// key in [scummvm] of scummvm.ini ("" = not set), and the text with it set.
+std::string iniMainGet(const std::string& ini, const char* key) {
+    std::string section;
+    size_t pos = 0;
+    while (pos < ini.size()) {
+        size_t end = ini.find('\n', pos);
+        if (end == std::string::npos) end = ini.size();
+        std::string line = ini.substr(pos, end - pos);
+        pos = end + 1;
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        if (!line.empty() && line[0] == '[') { section = lowerStr(line.substr(1, line.find(']') - 1)); continue; }
+        const size_t eq = line.find('=');
+        if (section == "scummvm" && eq != std::string::npos && lowerStr(sdTrimDir(line.substr(0, eq))) == key)
+            return sdTrimDir(line.substr(eq + 1));
+    }
+    return std::string();
+}
+std::string iniMainSet(const std::string& ini, const char* key, const std::string& value) {
+    std::string out, section;
+    bool done = false, inMain = false;
+    size_t pos = 0;
+    while (pos < ini.size()) {
+        size_t end = ini.find('\n', pos);
+        const bool last = end == std::string::npos;
+        if (last) end = ini.size();
+        std::string line = ini.substr(pos, end - pos);
+        pos = end + 1;
+        if (!line.empty() && line[0] == '[') {
+            if (inMain && !done) { out += std::string(key) + "=" + value + "\n"; done = true; }
+            inMain = lowerStr(line.substr(1, line.find(']') - 1)) == "scummvm";
+        }
+        out += line;
+        if (!last) out += "\n";
+    }
+    if (inMain && !done) { out += std::string(out.empty() || out.back() == '\n' ? "" : "\n") + key + "=" + value + "\n"; done = true; }
+    if (!done) out = "[scummvm]\n" + std::string(key) + "=" + value + "\n" + out;
+    return out;
+}
+
+// Lines of the log since an epoch second that hold any of the needles: the index of the first found, or -1.
+// pid: only that process's lines ("" = all).
+int logcatFind(time_t since, const std::vector<const char*>& needles, const std::string& pid) {
+    std::string out;
+    std::vector<std::string> args = {"/system/bin/logcat", "-d", "-T", std::to_string((long long)since) + ".000"};
+    if (!pid.empty()) args.push_back("--pid=" + pid);
+    runArgv(args, &out, 10000);
+    for (size_t pos = 0; pos < out.size();) {
+        size_t end = out.find('\n', pos);
+        if (end == std::string::npos) end = out.size();
+        const std::string line = out.substr(pos, end - pos);
+        for (size_t i = 0; i < needles.size(); i++) if (line.find(needles[i]) != std::string::npos) return (int)i;
+        pos = end + 1;
+    }
+    return -1;
+}
