+bool esdeArtDecodeRaster(const std::string& path, int boxW, int boxH, EsdeArtPixels* out) {
+    auto isExt = [&](const char* e) {
+        size_t n = strlen(e);
+        return path.size() > n && strcasecmp(path.c_str() + path.size() - n, e) == 0;
+    };
+    const char* p = path.c_str();
+    bool ok;
+    if (isExt(".png")) ok = esdeArtDecodePng(p, boxW, boxH, out);
+    else if (isExt(".jpg") || isExt(".jpeg") || isExt(".bmp")) ok = esdeArtDecodeStb(p, boxW, boxH, out);
+    else ok = esdeArtDecodeAid(p, boxW, boxH, out);
+    // Universal fallbacks, as before: AImageDecoder, then stb, then libpng.
+    if (!ok) ok = esdeArtDecodeAid(p, boxW, boxH, out);
+    if (!ok) ok = esdeArtDecodeStb(p, boxW, boxH, out);
+    if (!ok) ok = esdeArtDecodePng(p, boxW, boxH, out);
+    return ok;
+}
