+// A finished decode into its cache, if it is still the request in flight for that key. A failed
+// decode caches an empty entry (as the synchronous path did) so the file is not retried each frame;
+// a failed upgrade keeps the texture there is.
+void NanoMenu::esdeArtApply(EsdeArtResult& r) {
+    auto pit = mEsdeArtPending.find(r.key);
+    if (pit == mEsdeArtPending.end() || pit->second.ticket != r.ticket) return;
+    const bool upgrade = pit->second.upgrade;
+    mEsdeArtPending.erase(pit);
+    if (r.cancelled) return;
+    mDisplayDirty = true;
+    GLuint tex = 0;
+    if (!r.px.rgba.empty()) {
+        tex = esdeArtUpload(r.px.rgba.data(), r.px.texW, r.px.texH);
+        mEsdeDecodeBudget--;
+    }
+    if (r.svg) {
+        EsdeSvg o;
+        if (tex) { o.tex = tex; o.w = r.px.outW; o.h = r.px.outH; }
+        auto it = mEsdeSvgCache.find(r.key);
+        if (it != mEsdeSvgCache.end() && it->second.tex) glDeleteTextures(1, &it->second.tex);
+        mEsdeSvgCache[r.key] = o;
+        return;
+    }
+    if (r.px.nativeW > 0 && r.px.nativeH > 0) mEsdePngDims[r.key] = {r.px.nativeW, r.px.nativeH};
+    auto it = mEsdeTexCache.find(r.key);
+    if (upgrade && !tex) {
+        if (r.px.nativeW > 0) mEsdeTexDecDims[r.key] = {r.px.nativeW, r.px.nativeH};   // stop retrying
+        return;
+    }
+    if (it != mEsdeTexCache.end() && it->second && it->second != tex) glDeleteTextures(1, &it->second);
+    mEsdeTexCache[r.key] = tex;
+    if (tex) mEsdeTexDecDims[r.key] = {r.px.texW, r.px.texH};
+    else mEsdeTexDecDims.erase(r.key);
+}
+
+// Take this key's finished decode now if this frame can still upload, so it is drawn this frame.
+bool NanoMenu::esdeArtTakeNow(const std::string& key) {
+    auto pit = mEsdeArtPending.find(key);
+    if (pit == mEsdeArtPending.end() || !mEsdeArtPool || mEsdeDecodeBudget <= 0) return false;
+    EsdeArtResult r;
+    if (!mEsdeArtPool->take(key, pit->second.ticket, &r)) return false;
+    esdeArtApply(r);
+    return true;
+}
+
+// Once per frame: upload what finished (upgrades are swapped in only here, at the frame start, so no
+// texture a caller already holds this frame is deleted under it) and drop stale results.
+void NanoMenu::esdeArtPump() {
+    if (!mEsdeArtPool) return;
+    std::vector<EsdeArtResult> got;
+    mEsdeArtPool->drain(mEsdeDecodeBudget, [this](const EsdeArtResult& r) {
+        auto pit = mEsdeArtPending.find(r.key);
+        return pit != mEsdeArtPending.end() && pit->second.ticket == r.ticket;
+    }, &got);
+    for (auto& r : got) esdeArtApply(r);
+}
+
+// Every cache was cleared (theme switch, GPU park): nothing in flight may land in the new caches.
+void NanoMenu::esdeArtCancelAll() {
+    mEsdeArtPending.clear();
+    mEsdeTexDecDims.clear();
+    mEsdeArtPendingFrame = 0;
+    if (mEsdeArtPool) mEsdeArtPool->cancelAll();
+}
+
+// One file was replaced or deleted: a decode of the old one still running must not be cached.
+void NanoMenu::esdeArtForget(const std::string& path) {
+    mEsdeArtPending.erase(path);
+    mEsdeTexDecDims.erase(path);
+}
