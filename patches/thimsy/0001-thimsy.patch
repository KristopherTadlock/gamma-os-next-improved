+    <string name="title_launch_guard">Thimsy Launch Guard</string>
     <string name="launch_guard_toggle_label">Launch Guard 활성화</string>
     <string name="launch_guard_toggle_summary">활성화하면 선택된 호출 앱에서 실행될 때 선택된 대상 앱을 강제 종료합니다. 앱이 아직 실행 중일 때 다시 시작하면 발생하는 에뮬레이터 충돌을 해결할 수 있습니다.</string>
     <string name="callers_section_title">호출 앱</string>
diff --git a/packages/apps/LaunchGuardControl/res/values-pl/strings.xml b/packages/apps/LaunchGuardControl/res/values-pl/strings.xml
