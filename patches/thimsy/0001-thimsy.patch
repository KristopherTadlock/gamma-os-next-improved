 // texture) and the <gameselector> pick (to prefer a game that actually has the requested media).
+// The downloaded_media folders to read, in order: the ES-DE Media Folder setting (ES-DE's
+// MediaDirectory, persist.gammaos.nano.esde.mediadir) when set, then the default one, so media not
+// moved there keeps showing. Re-read only when the property changes (render thread only).
+// In store mode only the ES-DE folder's own (the card is the one place the media is).
+static const std::vector<std::string>& esdeMediaRoots() {
+    static std::vector<std::string> roots;
+    static const prop_info* pi = nullptr;
+    static const prop_info* dirPi = nullptr;
+    static uint32_t serial = 0, dirSerial = 0;
+    static bool built = false;
+    if (!pi) pi = __system_property_find("persist.gammaos.nano.esde.mediadir");
+    if (!dirPi) dirPi = __system_property_find("persist.gammaos.nano.esde.dir");
+    const uint32_t now = pi ? __system_property_serial(pi) : 0;
+    const uint32_t dirNow = dirPi ? __system_property_serial(dirPi) : 0;
+    if (built && now == serial && dirNow == dirSerial) return roots;
+    built = true; serial = now; dirSerial = dirNow;
+    roots.clear();
+    char d[PROPERTY_VALUE_MAX] = {};
+    property_get("persist.gammaos.nano.esde.dir", d, "");
+    std::string store = d;
+    while (store.size() > 1 && store.back() == '/') store.pop_back();
+    if (store.size() > 1 && store[0] == '/') {
+        roots.push_back(store + "/downloaded_media/");
+        return roots;
+    }
+    property_get("persist.gammaos.nano.esde.mediadir", d, "");
+    std::string custom = d;
+    while (custom.size() > 1 && custom.back() == '/') custom.pop_back();
+    if (custom.size() > 1 && custom[0] == '/') roots.push_back(custom + "/");
+    roots.push_back("/storage/emulated/0/ES-DE/downloaded_media/");
+    return roots;
+}
