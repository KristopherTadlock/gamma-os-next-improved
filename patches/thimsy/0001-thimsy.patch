@@ -1,6 +1,6 @@
 <?xml version="1.0" encoding="utf-8"?>
 <resources>
-    <string name="title_launch_guard">GammaOS Launch Guard</string>
+    <string name="title_launch_guard">Thimsy Launch Guard</string>
     <string name="launch_guard_toggle_label">Włącz Launch Guard</string>
     <string name="launch_guard_toggle_summary">Po włączeniu system wymusi zatrzymanie wybranych aplikacji docelowych, gdy zostaną uruchomione z wybranych aplikacji wywołujących. Może to rozwiązać problem zawieszania się emulatora, gdy aplikacja jest ponownie uruchamiana podczas działania.</string>
     <string name="callers_section_title">Aplikacje wywołujące</string>
diff --git a/packages/apps/LaunchGuardControl/res/values-pt-rBR/strings.xml b/packages/apps/LaunchGuardControl/res/values-pt-rBR/strings.xml
