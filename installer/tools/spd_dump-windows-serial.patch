+/* Whether a REG_MULTI_SZ list of hardware IDs holds the device's. */
+static int com_hwid_match(char *ids, DWORD size) {
+	DWORD i;
+	if (size >= 2) ids[size - 1] = ids[size - 2] = 0;
+	for (i = 0; i < size; i++) ids[i] = toupper((unsigned char)ids[i]);
+	for (; *ids; ids += strlen(ids) + 1)
+		if (strstr(ids, SPD_HWID)) return 1;
+	return 0;
+}
+
+/* Opens the serial port of the first connected device (any driver) with
+   the download mode's USB ID. Each failure is reported once, until it
+   changes. */
+static HANDLE com_open(char *name, size_t name_len) {
+	static DWORD last_err = 0;
+	HANDLE h = INVALID_HANDLE_VALUE;
+	SP_DEVINFO_DATA info;
+	DWORD idx;
+	HDEVINFO set = SetupDiGetClassDevsA(NULL, "USB", NULL,
+			DIGCF_PRESENT | DIGCF_ALLCLASSES);
+	if (set == INVALID_HANDLE_VALUE) return h;
+	for (idx = 0; ; idx++) {
+		char ids[2048], port[64], path[80];
+		DWORD type = 0, size = 0, plen = sizeof(port) - 1;
+		HKEY key; LONG r;
+		info.cbSize = sizeof(info);
+		if (!SetupDiEnumDeviceInfo(set, idx, &info)) break;
+		memset(ids, 0, sizeof(ids));
+		if (!SetupDiGetDeviceRegistryPropertyA(set, &info, SPDRP_HARDWAREID,
+				&type, (BYTE*)ids, sizeof(ids) - 2, &size)) continue;
+		if (!com_hwid_match(ids, size)) continue;
+		/* Only drivers that make the device a serial port have this. */
+		key = SetupDiOpenDevRegKey(set, &info, DICS_FLAG_GLOBAL, 0,
+				DIREG_DEV, KEY_READ);
+		if (key == INVALID_HANDLE_VALUE) continue;
+		memset(port, 0, sizeof(port));
+		r = RegQueryValueExA(key, "PortName", NULL, &type, (BYTE*)port, &plen);
+		RegCloseKey(key);
+		if (r != ERROR_SUCCESS || type != REG_SZ || !port[0]) continue;
+		snprintf(path, sizeof(path), "\\\\.\\%s", port);
+		h = CreateFileA(path, GENERIC_READ | GENERIC_WRITE, 0, NULL,
+				OPEN_EXISTING, 0, NULL);
+		if (h != INVALID_HANDLE_VALUE) {
+			snprintf(name, name_len, "%s", port);
+			break;
+		} else {
+			DWORD err = GetLastError();
+			if (err != last_err) {
+				last_err = err;
+				if (err == ERROR_ACCESS_DENIED || err == ERROR_SHARING_VIOLATION)
+					DBG_LOG("serial port %s is in use by another program\n", port);
+				else
+					DBG_LOG("serial port %s can't be opened (error %lu)\n",
+							port, (unsigned long)err);
+			}
+		}
+	}
+	SetupDiDestroyDeviceInfoList(set);
+	return h;
+}
+
+/* The device through libusb (WinUSB). *err_out: why it couldn't be opened
+   (another driver), or 0 when it isn't connected. */
+static libusb_device_handle *usb_open(int *err_out) {
+	libusb_device **list;
+	libusb_device_handle *handle = NULL;
+	ssize_t i, n = libusb_get_device_list(NULL, &list);
+	int err = 0;
+	for (i = 0; i < n; i++) {
+		struct libusb_device_descriptor desc;
+		if (libusb_get_device_descriptor(list[i], &desc) < 0) continue;
+		if (desc.idVendor != 0x1782 || desc.idProduct != 0x4d00) continue;
+		err = libusb_open(list[i], &handle);
+		if (err >= 0) break;
+		handle = NULL;
+	}
+	if (n >= 0) libusb_free_device_list(list, 1);
+	*err_out = handle ? 0 : err;
+	return handle;
+}
+
+static void com_init(HANDLE h) {
+	DCB dcb;
+	memset(&dcb, 0, sizeof(dcb));
+	dcb.DCBlength = sizeof(dcb);
+	/* Virtual ports may refuse any of these; none of them matters over USB. */
+	if (GetCommState(h, &dcb)) {
+		dcb.BaudRate = 115200;
+		dcb.ByteSize = 8;
+		dcb.Parity = NOPARITY;
+		dcb.StopBits = ONESTOPBIT;
+		dcb.fBinary = TRUE;
+		dcb.fParity = FALSE;
+		dcb.fOutxCtsFlow = FALSE;
+		dcb.fOutxDsrFlow = FALSE;
+		dcb.fDsrSensitivity = FALSE;
+		dcb.fDtrControl = DTR_CONTROL_ENABLE;
+		dcb.fRtsControl = RTS_CONTROL_ENABLE;
+		dcb.fOutX = FALSE;
+		dcb.fInX = FALSE;
+		dcb.fNull = FALSE;
+		dcb.fAbortOnError = FALSE;
+		SetCommState(h, &dcb);
+	}
+	SetupComm(h, 0x20000, 0x20000);
+	EscapeCommFunction(h, SETDTR);
+	EscapeCommFunction(h, SETRTS);
+	PurgeComm(h, PURGE_RXABORT | PURGE_RXCLEAR | PURGE_TXABORT | PURGE_TXCLEAR);
+}
+
+/* Sets the port up for io->timeout (ms; 0 waits forever, as with libusb):
+   a read returns as soon as anything arrives, or empty at the timeout. */
+static void com_timeouts(spdio_t *io) {
+	COMMTIMEOUTS t;
+	DWORD ms = io->timeout > 0 ? (DWORD)io->timeout : MAXDWORD - 1;
+	if (io->com_timeout == io->timeout) return;
+	memset(&t, 0, sizeof(t));
+	t.ReadIntervalTimeout = MAXDWORD;
+	t.ReadTotalTimeoutMultiplier = MAXDWORD;
+	t.ReadTotalTimeoutConstant = ms;
+	t.WriteTotalTimeoutConstant = io->timeout > 0 ? ms + 5000 : 0;
+	if (!SetCommTimeouts(io->com, &t))
+		ERR_EXIT("SetCommTimeouts failed (error %lu)\n",
+				(unsigned long)GetLastError());
+	io->com_timeout = io->timeout;
+}
+
+/* Errors a serial port gives once the device has gone (reset, unplugged). */
+static int com_gone(DWORD err) {
+	return err == ERROR_DEVICE_NOT_CONNECTED || err == ERROR_BAD_COMMAND ||
+			err == ERROR_GEN_FAILURE || err == ERROR_OPERATION_ABORTED ||
+			err == ERROR_ACCESS_DENIED || err == ERROR_FILE_NOT_FOUND ||
+			err == ERROR_DEVICE_REMOVED;
+}
