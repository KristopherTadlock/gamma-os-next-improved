+#if SPD_WIN
+/* What Windows has for the connected Unisoc USB devices (any product
+   ID): seen gets "1782:4d00 sprdvcom Ports COM9; ..." (empty when there's
+   none). Returns 1 when one is in download mode (1782:4d00) with a driver
+   other than WinUSB, or none, or a problem: other gets what it has; 2 when
+   that driver's serial port is open in another program (Unisoc's tools):
+   other gets the port. */
+static int win_scan(char *seen, size_t seen_len, char *other, size_t other_len) {
+	SP_DEVINFO_DATA info;
+	DWORD idx;
+	int found = 0;
+	size_t used = 0;
+	HDEVINFO set = SetupDiGetClassDevsA(NULL, "USB", NULL,
+			DIGCF_PRESENT | DIGCF_ALLCLASSES);
+	seen[0] = 0;
+	if (set == INVALID_HANDLE_VALUE) return 0;
+	for (idx = 0; ; idx++) {
+		char ids[2048], cls[64], svc[64], port[64], pid[5], one[200], prob[24];
+		const char *p;
+		DWORD type = 0, size = 0, plen = sizeof(port) - 1, i;
+		ULONG st = 0, pr = 0;
+		HKEY key;
+		info.cbSize = sizeof(info);
+		if (!SetupDiEnumDeviceInfo(set, idx, &info)) break;
+		memset(ids, 0, sizeof(ids));
+		if (!SetupDiGetDeviceRegistryPropertyA(set, &info, SPDRP_HARDWAREID,
+				&type, (BYTE*)ids, sizeof(ids) - 2, &size)) continue;
+		if (size >= 2) ids[size - 1] = ids[size - 2] = 0;
+		for (i = 0; i < size; i++) ids[i] = toupper((unsigned char)ids[i]);
+		p = strstr(ids, "VID_1782&PID_");
+		if (!p) continue;
+		snprintf(pid, sizeof(pid), "%s", p + 13);
+		for (i = 0; i < 4; i++) pid[i] = tolower((unsigned char)pid[i]);
+		memset(cls, 0, sizeof(cls));
+		if (!SetupDiGetDeviceRegistryPropertyA(set, &info, SPDRP_CLASS,
+				NULL, (BYTE*)cls, sizeof(cls) - 1, NULL)) strcpy(cls, "no class");
+		memset(svc, 0, sizeof(svc));
+		if (!SetupDiGetDeviceRegistryPropertyA(set, &info, SPDRP_SERVICE,
+				NULL, (BYTE*)svc, sizeof(svc) - 1, NULL)) svc[0] = 0;
+		memset(port, 0, sizeof(port));
+		key = SetupDiOpenDevRegKey(set, &info, DICS_FLAG_GLOBAL, 0,
+				DIREG_DEV, KEY_READ);
+		if (key != INVALID_HANDLE_VALUE) {
+			if (RegQueryValueExA(key, "PortName", NULL, &type, (BYTE*)port,
+					&plen) != ERROR_SUCCESS || type != REG_SZ) port[0] = 0;
+			RegCloseKey(key);
+		}
+		prob[0] = 0;
+		if (CM_Get_DevNode_Status(&st, &pr, info.DevInst, 0) == CR_SUCCESS &&
+				(st & DN_HAS_PROBLEM))
+			snprintf(prob, sizeof(prob), " problem %lu", (unsigned long)pr);
+		snprintf(one, sizeof(one), "1782:%s %s %s%s%s%s",
+				pid, svc[0] ? svc : "no driver", cls,
+				port[0] ? " " : "", port, prob);
+		if (used + strlen(one) + 3 < seen_len)
+			used += snprintf(seen + used, seen_len - used, "%s%s",
+					used ? "; " : "", one);
+		if (!found && !strcmp(pid, "4d00") &&
+				(_stricmp(svc, "WinUSB") || prob[0])) {
+			char path[80];
+			HANDLE h;
+			snprintf(other, other_len, "%s", one + 10);
+			found = 1;
+			/* Windows can't change the driver of a port in use. */
+			if (port[0]) {
+				snprintf(path, sizeof(path), "\\\\.\\%s", port);
+				h = CreateFileA(path, GENERIC_READ | GENERIC_WRITE, 0, NULL,
+						OPEN_EXISTING, 0, NULL);
+				if (h != INVALID_HANDLE_VALUE) CloseHandle(h);
+				else if (GetLastError() == ERROR_ACCESS_DENIED ||
+						GetLastError() == ERROR_SHARING_VIOLATION) {
+					snprintf(other, other_len, "%s", port);
+					found = 2;
+				}
+			}
+		}
+	}
+	SetupDiDestroyDeviceInfoList(set);
+	return found;
+}
+
+/* The device through libusb (WinUSB). *err_out: why it couldn't be opened
+   (another driver), or 0 when it isn't connected. */
+static libusb_device_handle *win_usb_open(int *err_out) {
+	libusb_device **list;
+	libusb_device_handle *handle = NULL;
+	ssize_t i, n = libusb_get_device_list(NULL, &list);
+	int err = 0;
+	for (i = 0; i < n; i++) {
+		struct libusb_device_descriptor desc;
+		if (libusb_get_device_descriptor(list[i], &desc) < 0) continue;
+		if (desc.idVendor != 0x1782 || desc.idProduct != 0x4d00) continue;
+		err = libusb_open(list[i], &handle);
+		if (err >= 0) break;
+		handle = NULL;
+	}
+	if (n >= 0) libusb_free_device_list(list, 1);
+	*err_out = handle ? 0 : err;
+	return handle;
+}
